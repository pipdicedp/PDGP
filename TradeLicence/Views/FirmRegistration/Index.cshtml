@model TradeLicence.Models.FirmFormViewModel
@{
    ViewData["Title"] = "Registration of Firms";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var isNew = Model.Id == 0;
}
@section Styles {
    <link rel="stylesheet" href="~/css/reg_css/registration.css" asp-append-version="true" />
}

<div class="tl-container reg-container">
    <div class="tl-header">
        <h2>REGISTRATION OF FIRMS</h2>
        <h3>Indian Partnership Act 1932</h3>
    </div>

    @if (!string.IsNullOrEmpty(Model.ApplicationNumber))
    {
        <div class="reg-appno">Application No: <strong>@Model.ApplicationNumber</strong></div>
    }

    @if (Model.Status == "ReturnedToApplicant" && !string.IsNullOrWhiteSpace(Model.OfficerRemarks))
    {
        <div class="reg-notice reg-notice-warn">
            Returned for correction. Officer's note: "@Model.OfficerRemarks"
        </div>
    }

    <div id="regErrorSummary" class="reg-errors" style="display:none;" role="alert"></div>

    <form id="regForm" asp-action="Save" asp-controller="FirmRegistration" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="Id" value="@Model.Id" />

        <!-- ================= 1. Applicant ================= -->
        <fieldset class="tl-section">
            <legend>Applicant Details</legend>
            <div class="tl-grid-2">
                <div class="form-group">
                    <label>1.(a) Applicant Name <span class="req">*</span></label>
                    <input asp-for="ApplicantName" class="form-control shadow-sm" maxlength="150" placeholder="Applicant name"
                           data-submit-required data-label="Applicant name" />
                </div>
                <div class="form-group">
                    <label>1.(b) Applicant Address</label>
                    <textarea asp-for="ApplicantAddress" class="form-control shadow-sm" rows="2" maxlength="500" placeholder="Applicant address"></textarea>
                </div>
                <div class="form-group">
                    <label>1.(c) Mobile No. <span class="req">*</span></label>
                    <input asp-for="MobileNumber" class="form-control shadow-sm" maxlength="10" inputmode="numeric" placeholder="10-digit mobile number"
                           data-submit-required data-validate="mobile" data-label="Mobile number" />
                </div>
                <div class="form-group">
                    <label>1.(d) Email Id <span class="req">*</span></label>
                    <input asp-for="Email" class="form-control shadow-sm" maxlength="150" placeholder="Email id"
                           data-submit-required data-validate="email" data-label="Email id" />
                </div>
            </div>
        </fieldset>

        <!-- ================= 2-5. Firm ================= -->
        <fieldset class="tl-section">
            <legend>Firm Details</legend>
            <div class="tl-grid-2">
                <div class="form-group">
                    <label>2. Proposed Name Of The Firm <span class="req">*</span></label>
                    <input asp-for="ProposedFirmName" class="form-control shadow-sm" maxlength="200" placeholder="Proposed name of the firm"
                           data-submit-required data-label="Proposed name of the firm" />
                </div>
                <div class="form-group">
                    <label>3. Firm Name <span class="req">*</span></label>
                    <input asp-for="FirmName" class="form-control shadow-sm" maxlength="200" placeholder="Firm name"
                           data-submit-required data-label="Firm name" />
                </div>
                <div class="form-group">
                    <label>4.a Principal Place of Business <span class="req">*</span></label>
                    <textarea asp-for="PrincipalPlace" class="form-control shadow-sm" rows="2" maxlength="500" placeholder="Principal place"
                              data-submit-required data-label="Principal place of business"></textarea>
                </div>
                <div class="form-group">
                    <label>4.b Other Place</label>
                    <textarea asp-for="OtherPlace" class="form-control shadow-sm" rows="2" maxlength="500" placeholder="Other place"></textarea>
                </div>
                <div class="form-group">
                    <label>5. Station <span class="req">*</span></label>
                    <input asp-for="Station" class="form-control shadow-sm" maxlength="150" placeholder="Station"
                           data-submit-required data-label="Station" />
                </div>
            </div>
        </fieldset>

        <!-- ================= Partners ================= -->
        <fieldset class="tl-section" id="regPeople" data-prefix="Partners" data-noun="partner">
            <legend>Details of Partners</legend>

            <div class="reg-people-add">
                <div class="tl-grid-2">
                    <div class="form-group">
                        <label>Name of Partner <span class="req">*</span></label>
                        <input type="text" class="form-control" maxlength="150" placeholder="Name of Partner"
                               data-field="Name" data-required data-label="Name of partner" />
                    </div>
                    <div class="form-group">
                        <label>Date of Joining <span class="req">*</span></label>
                        <input type="date" class="form-control" data-field="DateOfJoining" data-required data-label="Date of joining" />
                    </div>
                    <div class="form-group">
                        <label>Permanent Address <span class="req">*</span></label>
                        <textarea class="form-control" rows="2" maxlength="500" placeholder="Permanent Address"
                                  data-field="PermanentAddress" data-required data-label="Permanent address"></textarea>
                    </div>
                    <div>
                        <div class="form-group">
                            <label>ID Proof <span class="req">*</span></label>
                            <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                                   data-file="IdProofFile" data-accept="pdf,jpg,jpeg,png" data-required data-label="ID proof" />
                        </div>
                        <div class="form-group mt-2">
                            <label>Signature <span class="req">*</span></label>
                            <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                                   data-file="SignatureFile" data-accept="pdf,jpg,jpeg,png" data-required data-label="Signature" />
                        </div>
                    </div>
                </div>
                <div class="reg-hint">PDF, JPG or PNG - maximum 1 MB per file.</div>
                <div class="reg-add-row">
                    <button type="button" id="regAddPerson" class="btn-add-partner">Add</button>
                </div>
            </div>

            <div class="reg-table-wrap">
                <table class="reg-people-table">
                    <thead>
                        <tr>
                            <th>Sl.No.</th>
                            <th>Name of Partner</th>
                            <th>Date of Joining</th>
                            <th>Permanent Address</th>
                            <th>ID Proof</th>
                            <th>Signature</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="regPeopleBody" data-cols="Name,DateOfJoining,PermanentAddress">
                        @for (int i = 0; i < Model.Partners.Count; i++)
                        {
                            var p = Model.Partners[i];
                            <tr data-person-row>
                                <td class="reg-sl">@(i + 1)</td>
                                <td>
                                    @p.Name
                                    <input type="hidden" data-pf="Name" name="Partners[@i].Name" value="@p.Name" />
                                    <input type="hidden" data-pf="Id" name="Partners[@i].Id" value="@p.Id" />
                                </td>
                                <td>
                                    @(p.DateOfJoining?.ToString("dd-MM-yyyy"))
                                    <input type="hidden" data-pf="DateOfJoining" name="Partners[@i].DateOfJoining" value="@(p.DateOfJoining?.ToString("yyyy-MM-dd"))" />
                                </td>
                                <td>
                                    @p.PermanentAddress
                                    <input type="hidden" data-pf="PermanentAddress" name="Partners[@i].PermanentAddress" value="@p.PermanentAddress" />
                                </td>
                                <td>
                                    @if (p.IdProofDocumentId.HasValue)
                                    {
                                        <button type="button" class="reg-btn-view reg-view-doc" data-doc-title="Document Preview" data-doc-url="@Url.Action("ViewDocument", "FirmRegistration", new { documentId = p.IdProofDocumentId })"><i class="fas fa-eye"></i> View</button>
                                    }
                                    else
                                    {
                                        <input type="file" data-pf="IdProofFile" name="Partners[@i].IdProofFile" accept=".pdf,.jpg,.jpeg,.png"
                                               data-accept="pdf,jpg,jpeg,png" data-label="ID proof" />
                                    }
                                </td>
                                <td>
                                    @if (p.SignatureDocumentId.HasValue)
                                    {
                                        <button type="button" class="reg-btn-view reg-view-doc" data-doc-title="Document Preview" data-doc-url="@Url.Action("ViewDocument", "FirmRegistration", new { documentId = p.SignatureDocumentId })"><i class="fas fa-eye"></i> View</button>
                                    }
                                    else
                                    {
                                        <input type="file" data-pf="SignatureFile" name="Partners[@i].SignatureFile" accept=".pdf,.jpg,.jpeg,.png"
                                               data-accept="pdf,jpg,jpeg,png" data-label="Signature" />
                                    }
                                </td>
                                <td><button type="button" class="reg-btn-del" data-reg-del>Delete</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="reg-empty" id="regPeopleEmpty">No partners added yet.</div>
            </div>
        </fieldset>

        <!-- ================= Documents ================= -->
        <fieldset class="tl-section">
            <legend>Documents</legend>
            <div class="tl-grid-2">
                <partial name="_RegistrationUpload" model="@(new TradeLicence.Models.RegUploadField { Name = "FormIFile", Label = "Scanned copy of Form-I prescribed (Indian Partnership Act, 1932)", Required = true, ExistingDocumentId = Model.FormIDocumentId, ViewController = "FirmRegistration" })" />
                <partial name="_RegistrationUpload" model="@(new TradeLicence.Models.RegUploadField { Name = "PartnershipDeedFile", Label = "Scanned copy of the Partnership deed", Required = true, ExistingDocumentId = Model.PartnershipDeedDocumentId, ViewController = "FirmRegistration" })" />
                <partial name="_RegistrationUpload" model="@(new TradeLicence.Models.RegUploadField { Name = "AddressProofFile", Label = "Scanned copy of Rental agreement / utility bills as proof of address", Required = true, ExistingDocumentId = Model.AddressProofDocumentId, ViewController = "FirmRegistration" })" />
            </div>
            <p class="tl-note mt-2"><span class="req">Note:</span> Only PDF files are allowed and the maximum size of each file is 1 MB.</p>
        </fieldset>

        <label class="reg-declaration">
            <input type="checkbox" id="regDeclaration" name="Declaration" value="true" @(Model.Declaration ? "checked" : "") />
            <span>I hereby declare that the above statements are true and correct to the best of my knowledge.</span>
        </label>

        <div class="tl-actions reg-actions">
            <a class="btn btn-secondary" href="@Url.Action("MyApplications", "FirmRegistration")">Cancel</a>
            <button type="submit" name="actionButton" value="draft" class="btn btn-reg-draft">Save as Draft</button>
            <button type="submit" name="actionButton" value="submit" class="btn btn-reg-submit">Submit Application</button>
        </div>
    </form>
</div>

<partial name="_RegistrationDocModal" />

@section Scripts {
    @{
        // Errors from a normal (non-AJAX) post, e.g. Save as Draft - shown next to the fields by registration_form.js
        var serverErrors = ViewData.ModelState
            .Where(e => e.Value != null && e.Value.Errors.Count > 0)
            .ToDictionary(e => e.Key, e => e.Value!.Errors.Select(x => x.ErrorMessage).ToArray());
    }
    <script>window.regServerErrors = @Html.Raw(Json.Serialize(serverErrors));</script>
    <script src="~/js/reg_js/registration_preview.js" asp-append-version="true"></script>
    <script src="~/js/reg_js/registration_form.js" asp-append-version="true"></script>
}
