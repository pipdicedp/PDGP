@model TradeLicence.Models.SocietyApplication
@{
    ViewData["Title"] = "Society Registration / Renewal - Application Details";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    ViewBag.DocController = "SocietyRegistration";
    ViewBag.DocAction = "ViewDocument";

    var payment = ViewBag.Payment as TradeLicence.Models.WorkflowPayment;
    var statusText = Model.Status switch
    {
        "Submitted" => Model.CurrentStage == "Initial Scrutiny" ? "Submitted" : $"In Progress — {Model.CurrentStage}",
        "ReturnedToApplicant" => "Returned for Correction",
        _ => Model.Status
    };
    var statusClass = Model.Status switch
    {
        "Draft" => "myapps-status-draft",
        "Submitted" => Model.CurrentStage == "Initial Scrutiny" ? "myapps-status-submitted" : "myapps-status-review",
        "Approved" => "myapps-status-approved",
        "Rejected" => "myapps-status-rejected",
        "ReturnedToApplicant" => "myapps-status-rejected",
        _ => "myapps-status-draft"
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/tl_css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reg_css/registration.css" asp-append-version="true" />
}

<div class="tl-container reg-container">
    <div class="tl-header">
        <h2>Society Registration / Renewal</h2>
        <h3>Societies Registration Act, 1860</h3>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="reg-notice reg-notice-error">@TempData["Error"]</div>
    }

    <div class="reg-status-bar">
        <span><strong>Application No:</strong> @(Model.ApplicationNumber ?? "-")</span>
        <span class="myapps-status-badge @statusClass">@statusText</span>
        @if (Model.SubmittedDate.HasValue)
        {
            <span class="reg-hint">Submitted on @Model.SubmittedDate.Value.ToString("dd-MM-yyyy")</span>
        }
    </div>

    @if (Model.Status == "ReturnedToApplicant" && !string.IsNullOrWhiteSpace(Model.OfficerRemarks))
    {
        <div class="reg-notice reg-notice-warn">Returned for correction. Officer's note: "@Model.OfficerRemarks"</div>
    }
    @if (Model.Status == "Submitted" && Model.PaymentStatus == "Pending" && payment != null)
    {
        <div class="reg-notice reg-notice-warn">
            The Inspection officer has returned this application for payment. Please pay &#8377;@payment.TotalPaymentAmount.ToString("N2") to continue the processing.
            <form method="post" asp-action="PayNow" asp-controller="SocietyRegistration" style="display:inline; margin-left:12px;">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="button" class="myapps-btn btn-pay-now" style="background:#1D6E3E; border:none; cursor:pointer;">
                    <i class="fas fa-indian-rupee-sign"></i> Pay Now
                </button>
            </form>
        </div>
    }
    @if (Model.Status == "Approved")
    {
        <div class="reg-notice reg-notice-success">Your application has been approved.@(string.IsNullOrWhiteSpace(Model.OfficerRemarks) ? "" : " Officer's note: " + Model.OfficerRemarks)</div>
    }
    @if (Model.Status == "Rejected")
    {
        <div class="reg-notice reg-notice-error">Your application was rejected.@(string.IsNullOrWhiteSpace(Model.OfficerRemarks) ? "" : " Reason: " + Model.OfficerRemarks)</div>
    }

    @{
        ViewBag.SubmittedOn = Model.SubmittedDate;
    }
    <partial name="_RegistrationProgress" model="(TradeLicence.Models.IWorkflowApplication)Model" />

    <partial name="_SocietyApplicationDetails" model="Model" />

    <div class="tl-actions reg-actions">
        <a class="btn btn-secondary" href="@Url.Action("MyApplications", "SocietyRegistration")">Back</a>
        @if (Model.Status == "Draft" || Model.Status == "ReturnedToApplicant")
        {
            <a class="btn btn-primary" href="@Url.Action("Edit", "SocietyRegistration", new { id = Model.Id })">@(Model.Status == "Draft" ? "Continue" : "Correct & Resubmit")</a>
        }
        <button type="button" class="btn btn-primary reg-no-print" onclick="window.print()">Print</button>
    </div>
</div>

<partial name="_RegistrationDocModal" />

@section Scripts {
    <script src="~/js/reg_js/registration_preview.js" asp-append-version="true"></script>
}
