@model TradeLicence.Models.SocietyFormViewModel
@{
    ViewData["Title"] = "Society Registration / Renewal";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/reg_css/registration.css" asp-append-version="true" />
}

<div class="tl-container reg-container">
    <div class="tl-header">
        <h2>REGISTRATION / RENEWAL OF SOCIETY</h2>
        <h3>Societies Registration Act, 1860</h3>
    </div>

    @if (!string.IsNullOrEmpty(Model.ApplicationNumber))
    {
        <div class="reg-appno">Application No: <strong>@Model.ApplicationNumber</strong></div>
    }

    @if (Model.Status == "ReturnedToApplicant" && !string.IsNullOrWhiteSpace(Model.OfficerRemarks))
    {
        <div class="reg-notice reg-notice-warn">
            Returned for correction. Officer's note: "@Model.OfficerRemarks"
        </div>
    }

    <div id="regErrorSummary" class="reg-errors" style="display:none;" role="alert"></div>

    <form id="regForm" asp-action="Save" asp-controller="SocietyRegistration" method="post" enctype="multipart/form-data" novalidate>
        <input type="hidden" name="Id" value="@Model.Id" />

        <!-- ================= Application type ================= -->
        <fieldset class="tl-section">
            <legend>Application Type</legend>
            <div class="tl-grid-2">
                <div class="form-group">
                    <label>Type of Application <span class="req">*</span></label>
                    <select name="ApplicationType" id="regAppType" class="form-select shadow-sm">
                        <option value="Registration" selected="@(Model.ApplicationType != "Renewal")">New Registration</option>
                        <option value="Renewal" selected="@(Model.ApplicationType == "Renewal")">Renewal</option>
                    </select>
                </div>
                <div class="form-group" data-renewal-only style="display:none;">
                    <label>Existing Registration No. <span class="req">*</span></label>
                    <input asp-for="ExistingRegistrationNumber" class="form-control shadow-sm" maxlength="100" placeholder="Registration number"
                           data-submit-required data-label="Existing registration number" />
                </div>
                <div class="form-group" data-renewal-only style="display:none;">
                    <label>Registration Expiry Date <span class="req">*</span></label>
                    <input type="date" name="LicenceExpiryDate" id="regExpiry" class="form-control shadow-sm"
                           value="@(Model.LicenceExpiryDate?.ToString("yyyy-MM-dd"))"
                           data-submit-required data-label="Registration expiry date" />
                    <div class="reg-hint" id="regExpiryHint"></div>
                </div>
            </div>
        </fieldset>

        <!-- ================= 1. Applicant ================= -->
        <fieldset class="tl-section">
            <legend>Applicant Details</legend>
            <div class="tl-grid-2">
                <div class="form-group">
                    <label>1.(a) Applicant Name <span class="req">*</span></label>
                    <input asp-for="ApplicantName" class="form-control shadow-sm" maxlength="150" placeholder="Applicant name"
                           data-submit-required data-label="Applicant name" />
                </div>
                <div class="form-group">
                    <label>1.(b) Applicant Address</label>
                    <textarea asp-for="ApplicantAddress" class="form-control shadow-sm" rows="2" maxlength="500" placeholder="Applicant address"></textarea>
                </div>
                <div class="form-group">
                    <label>1.(c) Mobile No. <span class="req">*</span></label>
                    <input asp-for="MobileNumber" class="form-control shadow-sm" maxlength="10" inputmode="numeric" placeholder="10-digit mobile number"
                           data-submit-required data-validate="mobile" data-label="Mobile number" />
                </div>
                <div class="form-group">
                    <label>1.(d) Email Id <span class="req">*</span></label>
                    <input asp-for="Email" class="form-control shadow-sm" maxlength="150" placeholder="Email id"
                           data-submit-required data-validate="email" data-label="Email id" />
                </div>
                <div class="form-group">
                    <label>1.(e) Designation of the applicant <span class="req">*</span></label>
                    <input asp-for="ApplicantDesignation" class="form-control shadow-sm" maxlength="150" placeholder="Designation"
                           data-submit-required data-label="Designation of the applicant" />
                </div>
            </div>
        </fieldset>

        <!-- ================= 2-4. Society ================= -->
        <fieldset class="tl-section">
            <legend>Society Details</legend>
            <div class="tl-grid-2">
                <div class="form-group">
                    <label>2. Name of the Society <span class="req">*</span></label>
                    <input asp-for="SocietyName" class="form-control shadow-sm" maxlength="200" placeholder="Name of the society"
                           data-submit-required data-label="Name of the society" />
                </div>
                <div class="form-group" data-registration-only>
                    <label>3. Proposed name of Association / Society <span class="req">*</span></label>
                    <input asp-for="ProposedSocietyName" class="form-control shadow-sm" maxlength="200" placeholder="Proposed name"
                           data-submit-required data-label="Proposed name of the association / society" />
                </div>
                <div class="form-group">
                    <label>4. Address of the Society <span class="req">*</span></label>
                    <textarea asp-for="SocietyAddress" class="form-control shadow-sm" rows="2" maxlength="500" placeholder="Society address"
                              data-submit-required data-label="Address of the society"></textarea>
                </div>
            </div>
        </fieldset>

        <!-- ================= Governing body ================= -->
        <fieldset class="tl-section" id="regPeople" data-prefix="Members" data-noun="member">
            <legend>Governing Body Member Details</legend>

            <div class="reg-people-add">
                <div class="tl-grid-2">
                    <div class="form-group">
                        <label>Name of the Governing Body member <span class="req">*</span></label>
                        <input type="text" class="form-control" maxlength="150" placeholder="Name of the Governing Body member"
                               data-field="Name" data-required data-label="Name of the governing body member" />
                    </div>
                    <div class="form-group">
                        <label>Designation <span class="req">*</span></label>
                        <input type="text" class="form-control" maxlength="150" placeholder="Governing Body Designation"
                               data-field="Designation" data-required data-label="Designation" />
                    </div>
                    <div class="form-group">
                        <label>Date of Appointment <span class="req">*</span></label>
                        <input type="date" class="form-control" data-field="DateOfAppointment" data-required data-label="Date of appointment" />
                    </div>
                    <div class="form-group">
                        <label>Address of the Governing Body member <span class="req">*</span></label>
                        <textarea class="form-control" rows="2" maxlength="500" placeholder="Address of the Governing Body member"
                                  data-field="Address" data-required data-label="Address of the governing body member"></textarea>
                    </div>
                    <div class="form-group">
                        <label>ID Proof <span class="req">*</span></label>
                        <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                               data-file="IdProofFile" data-accept="pdf,jpg,jpeg,png" data-required data-label="ID proof" />
                    </div>
                    <div class="form-group">
                        <label>Signature <span class="req">*</span></label>
                        <input type="file" class="form-control" accept=".pdf,.jpg,.jpeg,.png"
                               data-file="SignatureFile" data-accept="pdf,jpg,jpeg,png" data-required data-label="Signature" />
                    </div>
                </div>
                <div class="reg-hint">PDF, JPG or PNG - maximum 1 MB per file.</div>
                <div class="reg-add-row">
                    <button type="button" id="regAddPerson" class="btn-add-partner">Add</button>
                </div>
            </div>

            <div class="reg-table-wrap">
                <table class="reg-people-table">
                    <thead>
                        <tr>
                            <th>Sl.No.</th>
                            <th>Name of Governing Member</th>
                            <th>Address</th>
                            <th>Designation</th>
                            <th>Date of Appointment</th>
                            <th>Id Proof</th>
                            <th>Signature</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="regPeopleBody" data-cols="Name,Address,Designation,DateOfAppointment">
                        @for (int i = 0; i < Model.Members.Count; i++)
                        {
                            var m = Model.Members[i];
                            <tr data-person-row>
                                <td class="reg-sl">@(i + 1)</td>
                                <td>
                                    @m.Name
                                    <input type="hidden" data-pf="Name" name="Members[@i].Name" value="@m.Name" />
                                    <input type="hidden" data-pf="Id" name="Members[@i].Id" value="@m.Id" />
                                </td>
                                <td>
                                    @m.Address
                                    <input type="hidden" data-pf="Address" name="Members[@i].Address" value="@m.Address" />
                                </td>
                                <td>
                                    @m.Designation
                                    <input type="hidden" data-pf="Designation" name="Members[@i].Designation" value="@m.Designation" />
                                </td>
                                <td>
                                    @(m.DateOfAppointment?.ToString("dd-MM-yyyy"))
                                    <input type="hidden" data-pf="DateOfAppointment" name="Members[@i].DateOfAppointment" value="@(m.DateOfAppointment?.ToString("yyyy-MM-dd"))" />
                                </td>
                                <td>
                                    @if (m.IdProofDocumentId.HasValue)
                                    {
                                        <button type="button" class="reg-btn-view reg-view-doc" data-doc-title="Document Preview" data-doc-url="@Url.Action("ViewDocument", "SocietyRegistration", new { documentId = m.IdProofDocumentId })"><i class="fas fa-eye"></i> View</button>
                                    }
                                    else
                                    {
                                        <input type="file" data-pf="IdProofFile" name="Members[@i].IdProofFile" accept=".pdf,.jpg,.jpeg,.png"
                                               data-accept="pdf,jpg,jpeg,png" data-label="ID proof" />
                                    }
                                </td>
                                <td>
                                    @if (m.SignatureDocumentId.HasValue)
                                    {
                                        <button type="button" class="reg-btn-view reg-view-doc" data-doc-title="Document Preview" data-doc-url="@Url.Action("ViewDocument", "SocietyRegistration", new { documentId = m.SignatureDocumentId })"><i class="fas fa-eye"></i> View</button>
                                    }
                                    else
                                    {
                                        <input type="file" data-pf="SignatureFile" name="Members[@i].SignatureFile" accept=".pdf,.jpg,.jpeg,.png"
                                               data-accept="pdf,jpg,jpeg,png" data-label="Signature" />
                                    }
                                </td>
                                <td><button type="button" class="reg-btn-del" data-reg-del>Delete</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="reg-empty" id="regPeopleEmpty">No governing body members added yet.</div>
            </div>
        </fieldset>

        <!-- ================= Documents ================= -->
        <fieldset class="tl-section">
            <legend>Documents</legend>
            <div class="tl-grid-2">
                <partial name="_RegistrationUpload" model="@(new TradeLicence.Models.RegUploadField { Name = "MemorandumFile", Label = "Memorandum of Association / Society", Required = true, ExistingDocumentId = Model.MemorandumDocumentId, ViewController = "SocietyRegistration" })" />
                <partial name="_RegistrationUpload" model="@(new TradeLicence.Models.RegUploadField { Name = "RulesFile", Label = "Rules and Regulations of the Society", Required = true, ExistingDocumentId = Model.RulesDocumentId, ViewController = "SocietyRegistration" })" />
                <partial name="_RegistrationUpload" model="@(new TradeLicence.Models.RegUploadField { Name = "PowerOfAutonomyFile", Label = "Power of Autonomy for (Modification / Certificate of Registration to be collected)", Required = false, ExistingDocumentId = Model.PowerOfAutonomyDocumentId, ViewController = "SocietyRegistration" })" />
                <partial name="_RegistrationUpload" model="@(new TradeLicence.Models.RegUploadField { Name = "AddressProofFile", Label = "Proof of the address of the society (Utility bills / Rental Agreement)", Required = true, ExistingDocumentId = Model.AddressProofDocumentId, ViewController = "SocietyRegistration" })" />
                <partial name="_RegistrationUpload" model="@(new TradeLicence.Models.RegUploadField { Name = "NameAvailabilityFile", Label = "Copy of Name Availability", Required = false, ExistingDocumentId = Model.NameAvailabilityDocumentId, ViewController = "SocietyRegistration" })" />
            </div>
            <p class="tl-note mt-2"><span class="req">Note:</span> Only PDF files are allowed and the maximum size of each file is 1 MB.</p>
        </fieldset>

        <label class="reg-declaration">
            <input type="checkbox" id="regDeclaration" name="Declaration" value="true" @(Model.Declaration ? "checked" : "") />
            <span>I hereby declare that the above statements are true and correct to the best of my knowledge.</span>
        </label>

        <div class="tl-actions reg-actions">
            <a class="btn btn-secondary" href="@Url.Action("MyApplications", "SocietyRegistration")">Cancel</a>
            <button type="submit" name="actionButton" value="draft" class="btn btn-reg-draft">Save as Draft</button>
            <button type="submit" name="actionButton" value="submit" class="btn btn-reg-submit">Submit Application</button>
        </div>
    </form>
</div>

<partial name="_RegistrationDocModal" />

@section Scripts {
    @{
        // Errors from a normal (non-AJAX) post, e.g. Save as Draft - shown next to the fields by registration_form.js
        var serverErrors = ViewData.ModelState
            .Where(e => e.Value != null && e.Value.Errors.Count > 0)
            .ToDictionary(e => e.Key, e => e.Value!.Errors.Select(x => x.ErrorMessage).ToArray());
    }
    <script>window.regServerErrors = @Html.Raw(Json.Serialize(serverErrors));</script>
    <script src="~/js/reg_js/registration_preview.js" asp-append-version="true"></script>
    <script src="~/js/reg_js/registration_form.js" asp-append-version="true"></script>
}
