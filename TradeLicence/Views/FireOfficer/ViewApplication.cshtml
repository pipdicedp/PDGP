@model TradeLicence.Models.FireApplicationVm
@using System.Linq
@using TradeLicence.Helpers
@using TradeLicence.Models
@using TradeLicence.Models.Caf

@*
    Fire Service Department officer's view of one Fire NOC application: the full
    read-only form (reusing the CAF's collapsible section renderer) + the shared
    Officer Workflow panel (Initial Scrutiny -> Verification -> Inspection ->
    Approval). Action names match _OfficerWorkflowPanel's contract.
*@

@{
    ViewData["Title"] = "Fire NOC Application — " + (Model.Application.ApplicationCode ?? Model.Application.Id.ToString());
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";

    var app = Model.Application;

    // Drives the download links inside _FireDocuments for the officer route.
    ViewBag.OfficerApplicationId = app.Id;

    var docs = FireFormMetadata.AllDocuments.Select(d => new CafDocumentVm
    {
        Def = d,
        SizeBytes = Model.DocumentSizes.TryGetValue(d.Column, out var len) ? len : null,
        ContentType = Model.DocumentTypes.TryGetValue(d.Column, out var type) ? type : null
    }).ToList();

    // Keep the raw values for any legacy uses, but prefer the readable labels.
    var statusBadge  = TradeLicence.Helpers.FireStatusDisplay.StatusBadge(app.Status);
    var statusLabel  = TradeLicence.Helpers.FireStatusDisplay.StatusLabel(app.Status);
    var stageLabel   = TradeLicence.Helpers.FireStatusDisplay.StageLabel(app.Status, app.CurrentStage);
}

@section Styles {
    <link rel="stylesheet" href="~/css/tl_css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/caf_css/caf.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">

    <div class="dashboard-body">

        <div class="dashboard-banner">
            <div class="dashboard-banner-text">
                <span class="dashboard-banner-icon">🔥</span>
                <div>
                    <h3>@(string.IsNullOrEmpty(app.Name) ? "Fire NOC Application" : app.Name)</h3>
                    <p>
                        Fire NOC Ref. No. @(string.IsNullOrEmpty(app.ApplicationCode) ? app.Id.ToString() : app.ApplicationCode)
                        &bull; Current stage: @stageLabel
                        &bull; Status: @statusLabel
                    </p>
                </div>
            </div>

            @if (string.Equals(app.Status, "Approved", StringComparison.OrdinalIgnoreCase))
            {
                <div class="dashboard-controls">
                    <a class="btn btn-success"
                       href="@Url.Action("Noc", new { id = app.Id })">
                        <i class="fa-solid fa-certificate"></i> Download NOC
                    </a>
                </div>
            }
        </div>

        <div class="alert alert-info caf-alert">
            <strong>Applicant:</strong> @(string.IsNullOrEmpty(app.Name) ? "-" : app.Name)
            @if (!string.IsNullOrEmpty(app.MobileNo))
            {
                <text>&bull; Mobile: @app.MobileNo</text>
            }
            &bull; <span class="badge @statusBadge">@app.Status</span> at @app.CurrentStage
            @if (app.SubmittedDate.HasValue)
            {
                <text>&bull; Submitted @app.SubmittedDate.Value.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")</text>
            }
        </div>

        <!-- ================= Fire NOC inspection workflow ================= -->
        <partial name="~/Views/FireOfficer/_FireInspection.cshtml" model="Model" />

        <!-- ================= Applicant's uploaded documents ================= -->
        <partial name="~/Views/FireClearance/_FireDocuments.cshtml" model="docs" />

        <!-- ================= Full application preview (read-only) ================= -->
        <partial name="~/Views/CommonApplicationForm/_CafPreviewSections.cshtml" model="Model.Preview" />

        <div class="tl-section-divider">
            <span class="tl-section-divider-icon"><i class="fa-solid fa-angles-down"></i></span>
        </div>

        <!-- ================= Shared Officer Workflow panel ================= -->
        <partial name="_OfficerWorkflowPanel" model="(IWorkflowApplication)Model.Application" />

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/officer_js/officer.js" asp-append-version="true"></script>
    <script src="~/js/caf_js/caf_preview.js" asp-append-version="true"></script>

    @if (TempData["OfficerActionMessage"] != null)
    {
        <script>
            showOfficerActionAlert(
                @Html.Raw(Json.Serialize(TempData["OfficerActionType"] as string ?? "")),
                @Html.Raw(Json.Serialize(TempData["OfficerActionMessage"]))
            );
        </script>
    }
}
