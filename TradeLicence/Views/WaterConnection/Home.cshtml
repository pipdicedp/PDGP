@{
    ViewData["Title"] = "Water Connection";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tl_css/dashboard.css" asp-append-version="true" />
}

@if (TempData["Success"] != null)
{
    <div class="modal fade" id="aqSuccessModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <h4 class="mb-2" style="color:#1a3a52;">@TempData["Success"]</h4>
                    <p class="mb-1">Your Application ID is <strong>#@TempData["SuccessApplicationId"]</strong></p>
                    <p class="text-muted small mb-4">Please note your Application ID for future reference.</p>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (TempData["DraftSaved"] != null)
{
    <div class="modal fade" id="aqDraftSavedModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <h4 class="mb-2" style="color:#1a3a52;">@TempData["DraftSaved"]</h4>
                    @if (TempData["DraftSavedApplicationId"] != null)
                    {
                        <p class="mb-1">Your Application ID is <strong>#@TempData["DraftSavedApplicationId"]</strong></p>
                    }
                    <p class="text-muted small mb-4">You can come back anytime and resume from where you left off.</p>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (TempData["AlreadySubmittedApplicationId"] != null)
{
    <div class="modal fade" id="whAlreadySubmittedModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <h4 class="mb-2" style="color:#C0392B;">Application Already Submitted</h4>
                    <p class="text-muted small mb-4">
                        You have already submitted the form. Please check the status with your Application ID: <strong>@TempData["AlreadySubmittedApplicationId"]</strong>
                    </p>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="dashboard-wrapper">

    <div class="dashboard-body">

        <div class="page-title">
            <h3>Water Connection</h3>
            <p>Apply for a new domestic or commercial water connection, or check the status of an application you've already submitted.</p>
        </div>

        <div class="dashboard-cards">

            <div class="dashboard-card">
                <div class="card-icon">💧</div>
                <h4>Apply for New Water Connection</h4>
                <p>Fill out the application form with your details, department/area information, and required documents.</p>
                <a asp-action="Index" class="dashboard-btn">Start Application</a>
            </div>

            <div class="dashboard-card">
                <div class="card-icon">📋</div>
                <h4>Application Status Tracking</h4>
                <p>Logged in? View all your own applications in one place — resume a draft or download the acknowledgement for a submitted one.</p>
                <a asp-action="MyApplications" class="dashboard-btn">Track My Applications</a>
            </div>

        </div>

    </div>

</div>

@section Scripts
{
    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var aqSuccessModalEl = document.getElementById("aqSuccessModal");
                if (aqSuccessModalEl) {
                    new bootstrap.Modal(aqSuccessModalEl).show();
                }
            });
        </script>
    }

    @if (TempData["DraftSaved"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var aqDraftSavedModalEl = document.getElementById("aqDraftSavedModal");
                if (aqDraftSavedModalEl) {
                    new bootstrap.Modal(aqDraftSavedModalEl).show();
                }
            });
        </script>
    }

    @if (TempData["AlreadySubmittedApplicationId"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var whAlreadySubmittedModalEl = document.getElementById("whAlreadySubmittedModal");
                if (whAlreadySubmittedModalEl) {
                    new bootstrap.Modal(whAlreadySubmittedModalEl).show();
                }
            });
        </script>
    }
}
