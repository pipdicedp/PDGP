@model WaterConnection.Models.WaterConnectionApplication

@{
    ViewData["Title"] = "Application Details";
     Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<link rel="stylesheet" href="~/css/watercss/wc-details.css" />

<div class="wc-page">
    <div class="wc-shell">

        <div class="wc-header">
            <div>
                <p class="wc-eyebrow">Puducherry Water Supply &amp; Sewerage</p>
                <h2 class="wc-title">Application Details</h2>
            </div>

            <div class="modal fade" id="documentModal" tabindex="-1">
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="documentTitle"></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-0"><iframe id="documentFrame" width="100%" height="700" style="border:none;"></iframe></div>
                    </div>
                </div>
            </div>
            <script>
                            document.addEventListener("DOMContentLoaded", function() {
                                const modalEl = document.getElementById("documentModal");
                                const modal = new bootstrap.Modal(modalEl);
                                document.querySelectorAll(".preview-document").forEach(function(e) {
                                    e.addEventListener("click", function() {
                                        document.getElementById("documentTitle").innerText = this.dataset.title;
                                        document.getElementById("documentFrame").src = this.dataset.file;
                                        modal.show();
                                    });
                                });
                                modalEl.addEventListener("hidden.bs.modal", function() { document.getElementById("documentFrame").src = ""; });
                            });
            </script>
            <div class="wc-appid">Application ID <strong>@Model.ApplicationId</strong></div>
        </div>

        <div class="wc-sections">

            <!-- Applicant -->
            <div class="wc-section wc-span-2">
                <p class="wc-section-title">Applicant</p>
                <div class="wc-grid">
                    <div class="wc-field">
                        <label>Name</label>
                        <div class="wc-value">@Model.Name</div>
                    </div>
                    <div class="wc-field">
                        <label>Father Name</label>
                        <div class="wc-value">@Model.FatherName</div>
                    </div>
                    <div class="wc-field">
                        <label>Spouse Name</label>
                        <div class="wc-value">@Model.SpouseName</div>
                    </div>
                    <div class="wc-field">
                        <label>Power of Attorney</label>
                        <div class="wc-value">@Model.PowerOfAttorney</div>
                    </div>
                    <div class="wc-field">
                        <label>Phone Number</label>
                        <div class="wc-value">@Model.PhoneNumber</div>
                    </div>
                    <div class="wc-field">
                        <label>Email</label>
                        <div class="wc-value">@Model.Email</div>
                    </div>
                </div>
            </div>

            <!-- Communication Address -->
            <div class="wc-section">
                <p class="wc-section-title">Communication Address</p>
                <div class="wc-grid">
                    <div class="wc-field">
                        <label>Door No</label>
                        <div class="wc-value">@Model.CommDoorNo</div>
                    </div>
                    <div class="wc-field">
                        <label>City</label>
                        <div class="wc-value">@Model.CommCity</div>
                    </div>
                    <div class="wc-field">
                        <label>Address Line 1</label>
                        <div class="wc-value">@Model.CommAddress1</div>
                    </div>
                    <div class="wc-field">
                        <label>Address Line 2</label>
                        <div class="wc-value">@Model.CommAddress2</div>
                    </div>
                </div>
            </div>

            <!-- Connection Address -->
            <div class="wc-section">
                <p class="wc-section-title">Connection Address</p>
                <div class="wc-grid">
                    <div class="wc-field">
                        <label>Door No</label>
                        <div class="wc-value">@Model.ConnDoorNo</div>
                    </div>
                    <div class="wc-field">
                        <label>City</label>
                        <div class="wc-value">@Model.ConnCity</div>
                    </div>
                    <div class="wc-field">
                        <label>Address Line 1</label>
                        <div class="wc-value">@Model.ConnAddress1</div>
                    </div>
                    <div class="wc-field">
                        <label>Address Line 2</label>
                        <div class="wc-value">@Model.ConnAddress2</div>
                    </div>
                </div>
            </div>

            <!-- Work Details -->
            <div class="wc-section">
                <p class="wc-section-title">Work &amp; Contractor Details</p>
                <div class="wc-grid">
                    <div class="wc-field">
                        <label>Department</label>
                        <div class="wc-value">@Model.Department?.DepartmentName</div>
                    </div>
                    <div class="wc-field">
                        <label>Section</label>
                        <div class="wc-value">@Model.Section?.SectionName</div>
                    </div>
                    <div class="wc-field">
                        <label>Area</label>
                        <div class="wc-value">@Model.Area?.AreaName</div>
                    </div>
                    <div class="wc-field">
                        <label>Purpose</label>
                        <div class="wc-value">@Model.Purpose?.PurposeName</div>
                    </div>
                    <div class="wc-field">
                        <label>Contractor</label>
                        <div class="wc-value">@(Model.Contractor?.ContractorName ?? "—")</div>
                    </div>
                    <div class="wc-field">
                        <label>Status</label>
                        <div class="wc-value">@Model.Status</div>
                    </div>
                </div>
            </div>

            <!-- Documents -->
            <div class="wc-section wc-span-2">
                <p class="wc-section-title">Documents &amp; Uploads</p>
                <div class="wc-docs">
                    @{
                        var purposeLabels = new Dictionary<string, string>
                        {
                            { "NameAddress", "Name & Address Verification" },
                            { "Ownership", "Ownership Verification" },
                            { "Others", "Others" },
                            { "ContractorConsent", "Contractor Consent" },
                        };
                        var docs = (Model.Documents ?? new List<WaterConnection.Models.ApplicationDocument>())
                            .Where(d => !string.IsNullOrWhiteSpace(d.FilePath))
                            .ToList();
                    }
                    @foreach (var doc in docs)
                    {
                        var label = purposeLabels.TryGetValue(doc.DocumentPurpose, out var friendly) ? friendly : doc.DocumentPurpose;
                        <a href="javascript:void(0);"
                           class="wc-doc-chip preview-document"
                           data-file="@Url.Content("~/uploads/" + doc.FilePath)"
                           data-title="@label"
                           title="@label@(string.IsNullOrWhiteSpace(doc.DocumentOption) ? "" : $": {doc.DocumentOption}")">
                            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            <span>@label</span>
                        </a>
                    }
                    @if (!docs.Any())
                    {
                        <div class="wc-doc-empty">No documents on file</div>
                    }
                </div>
            </div>

        </div>

        <div class="wc-footer">
            <div class="wc-created">Submitted on <strong>@Model.ApplicationDate</strong></div>
            <a asp-action="List" class="wc-back">← Back to List</a>
        </div>

    </div>
</div>
