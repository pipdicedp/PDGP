@model WaterConnection.Models.WaterConnectionStatusViewModel

@{
    ViewData["Title"] = "Check Application Status";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="tl-header">
    <h2>CHECK APPLICATION STATUS</h2>
    <h3>Enter the Application ID you received when you submitted your water connection application.</h3>
</div>

<fieldset class="tl-section">
    <legend>Water Connection — Application Status</legend>

    <form asp-action="CheckStatus" asp-controller="WaterConnection" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div class="tl-grid-2">
            <div class="form-group">
                <label asp-for="ApplicationId">Application ID</label>
                <input asp-for="ApplicationId" type="number" min="1" class="form-control" placeholder="e.g. 14" />
            </div>
        </div>
        @if (Model.Searched && !Model.ApplicationId.HasValue)
        {
            <p class="text-danger mb-0">Please enter an Application ID.</p>
        }
        <div class="tl-actions">
            <button type="submit" class="btn btn-primary">Check Status</button>
        </div>
    </form>

    @if (Model.Searched && Model.ApplicationId.HasValue)
    {
        <hr />
        @if (Model.Found)
        {
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 p-3" style="background:#eef2f7;border-radius:8px;">
                <div>
                    <div class="text-muted small text-uppercase">Application #@Model.ApplicationId</div>
                    <div class="fw-semibold">@Model.ApplicantName</div>
                    @if (Model.ApplicationDate.HasValue)
                    {
                        <div class="text-muted small">Submitted on @Model.ApplicationDate.Value.ToString("dd-MM-yyyy")</div>
                    }
                </div>
                @{
                    var isSubmitted = string.Equals(Model.Status, "Submitted", StringComparison.OrdinalIgnoreCase);
                }
                <span class="myapps-status-badge @(isSubmitted ? "myapps-status-submitted" : "myapps-status-draft")">@Model.Status</span>
            </div>
        }
        else
        {
            <p class="text-danger mb-0">Application ID not found.</p>
        }
    }
</fieldset>

<div class="tl-actions">
    <a asp-action="Home" class="btn btn-secondary">&laquo; Back to Water Connection</a>
</div>
