@model WaterConnection.Models.WaterConnectionFormViewModel

@{
    ViewData["Title"] = "New Water Connection";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    // Server-rendered link (or null) for each document slot's existing upload, if the
    // draft/application being resumed already has one on file. wc-attachments.js reads
    // these via the wrapper's data-existing-doc-url attribute to show the document as
    // already attached -- Razor simply omits the attribute when the value is null.
    string? naDocUrl = Model.ExistingNameAddressDocumentId.HasValue
        ? Url.Action("Document", "WaterConnection", new { id = Model.ExistingNameAddressDocumentId })
        : null;
    string? ownDocUrl = Model.ExistingOwnershipDocumentId.HasValue
        ? Url.Action("Document", "WaterConnection", new { id = Model.ExistingOwnershipDocumentId })
        : null;
    string? othersDocUrl = Model.ExistingOthersDocumentId.HasValue
        ? Url.Action("Document", "WaterConnection", new { id = Model.ExistingOthersDocumentId })
        : null;
    string? consentDocUrl = Model.ExistingContractorConsentDocumentId.HasValue
        ? Url.Action("Document", "WaterConnection", new { id = Model.ExistingContractorConsentDocumentId })
        : null;
}

<link rel="stylesheet" href="~/css/watercss/wc-preview.css" />

<div class="tl-header">
    <h2>APPLICATION FOR</h2>
    <h3>NEW WATER CONNECTION (Public Works Department, Government of Puducherry)</h3>
</div>

<!-- Shown whenever a submit attempt is blocked because a mandatory field was left empty
     (triggered client-side by jQuery Validate, or on page load if the server itself
     rejected an incomplete submission -- see wc-validation.js and the Scripts section below). -->
<div class="modal fade" id="aqValidationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <h4 class="mb-2" style="color:#C0392B;">Missing Information</h4>
                <p class="text-muted small mb-4">Please fill all the fields, all are mandatory.</p>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Shown if "Save Application" is clicked but every mandatory field (including
     all four document uploads) is already filled -- nothing left to draft. -->
<div class="modal fade" id="aqDraftCompleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body text-center py-4">
                <h4 class="mb-2" style="color:#1a3a52;">All fields are filled</h4>
                <p class="text-muted small mb-4">All fields are filled. Please submit the application.</p>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@if (TempData["ResumeMessage"] != null)
{
    <div class="modal fade" id="aqResumeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center py-4">
                    <h4 class="mb-2" style="color:#1a3a52;">Welcome back</h4>
                    <p class="text-muted small mb-4">@TempData["ResumeMessage"]</p>
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Shared preview for any selected document -- Preview buttons point an <iframe> at the
     chosen file's local blob URL, so nothing is uploaded just to preview it, and nothing
     opens in a new tab/window (see wc-attachments.js). Uses the same wc-preview-* classes
     as the Application Details page so previewing looks identical in both places. -->
<div class="modal fade" id="aqPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content wc-preview-modal">
            <div class="modal-header wc-preview-header">
                <h5 class="wc-preview-title" id="aqPreviewTitle">Document Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body wc-preview-body">
                <iframe id="aqPreviewFrame" class="wc-preview-frame" title="Document preview"></iframe>
            </div>
        </div>
    </div>
</div>

<form asp-action="Index" method="post" enctype="multipart/form-data" id="aqWaterForm">

    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ApplicationId" id="aqApplicationId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <!-- ============ Applicant Details ============ -->
    <fieldset class="tl-section">
        <legend>Applicant Details</legend>
        <div class="tl-grid-2">

            <div class="form-group">
                <label asp-for="Name">Name</label> <span class="req">*</span>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PowerOfAttorney">Power of Attorney</label> <span class="req">*</span>
                <input asp-for="PowerOfAttorney" class="form-control" />
                <span asp-validation-for="PowerOfAttorney" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FatherName">Father Name</label> <span class="req">*</span>
                <input asp-for="FatherName" class="form-control" />
                <span asp-validation-for="FatherName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SpouseName">Spouse Name</label> <span class="req">*</span>
                <input asp-for="SpouseName" class="form-control" />
                <span asp-validation-for="SpouseName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PhoneNumber">Phone Number</label> <span class="req">*</span>
                <input asp-for="PhoneNumber" class="form-control" maxlength="10" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label> <span class="req">*</span>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

        </div>
    </fieldset>

    <!-- ============ Communication Address ============ -->
    <fieldset class="tl-section">
        <legend>Communication Address</legend>
        <div class="tl-grid-2">

            <div class="form-group">
                <label asp-for="CommDoorNo">Door No.</label> <span class="req">*</span>
                <input asp-for="CommDoorNo" class="form-control" />
                <span asp-validation-for="CommDoorNo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CommAddress1">Address Line 1</label> <span class="req">*</span>
                <input asp-for="CommAddress1" class="form-control" />
                <span asp-validation-for="CommAddress1" class="text-danger"></span>
            </div>

            <div class="form-group tl-col-full">
                <label asp-for="CommAddress2">Address Line 2</label> <span class="req">*</span>
                <input asp-for="CommAddress2" class="form-control" />
                <span asp-validation-for="CommAddress2" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CommCity">City</label> <span class="req">*</span>
                <input asp-for="CommCity" class="form-control" />
                <span asp-validation-for="CommCity" class="text-danger"></span>
            </div>

        </div>
    </fieldset>

    <!-- ============ Connection Address ============ -->
    <fieldset class="tl-section">
        <legend>Connection Address</legend>
        <div class="tl-grid-2">

            <div class="form-group">
                <label asp-for="ConnDoorNo">Door No.</label> <span class="req">*</span>
                <input asp-for="ConnDoorNo" class="form-control" />
                <span asp-validation-for="ConnDoorNo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConnAddress1">Address Line 1</label> <span class="req">*</span>
                <input asp-for="ConnAddress1" class="form-control" />
                <span asp-validation-for="ConnAddress1" class="text-danger"></span>
            </div>

            <div class="form-group tl-col-full">
                <label asp-for="ConnAddress2">Address Line 2</label> <span class="req">*</span>
                <input asp-for="ConnAddress2" class="form-control" />
                <span asp-validation-for="ConnAddress2" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConnCity">City</label> <span class="req">*</span>
                <input asp-for="ConnCity" class="form-control" />
                <span asp-validation-for="ConnCity" class="text-danger"></span>
            </div>

        </div>
    </fieldset>

    <!-- ============ Department Details ============ -->
    <fieldset class="tl-section">
        <legend>Department Details</legend>
        <div class="tl-grid-2">

            <div class="form-group">
                <label asp-for="DeptCode">Department</label> <span class="req">*</span>
                <select asp-for="DeptCode" id="DeptCode" class="form-control" asp-items="Model.Departments">
                    <option value="">-- Select Department --</option>
                </select>
                <span asp-validation-for="DeptCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="SectionCode">Section</label> <span class="req">*</span>
                <select asp-for="SectionCode" id="SectionCode" class="form-control" asp-items="Model.Sections">
                    <option value="">-- Select Section --</option>
                </select>
                <span asp-validation-for="SectionCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ContractorCode">Contractor</label> <span class="req">*</span>
                <select asp-for="ContractorCode" id="ContractorCode" class="form-control" asp-items="Model.Contractors">
                    <option value="">-- Select Contractor --</option>
                </select>
                <span asp-validation-for="ContractorCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="AreaCode">Area</label> <span class="req">*</span>
                <select asp-for="AreaCode" id="AreaCode" class="form-control" asp-items="Model.Areas">
                    <option value="">-- Select Area --</option>
                </select>
                <span asp-validation-for="AreaCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PurposeCode">Purpose</label> <span class="req">*</span>
                <select asp-for="PurposeCode" class="form-control" asp-items="Model.Purposes">
                    <option value="">-- Select Purpose --</option>
                </select>
                <span asp-validation-for="PurposeCode" class="text-danger"></span>
            </div>

        </div>
    </fieldset>

    <!-- ============ Upload Documents ============ -->
    <fieldset class="tl-section">
        <legend>Upload Documents</legend>

        <div class="table-responsive">
            <table class="tl-partner-table">
                <thead>
                    <tr>
                        <th style="width:4%">#</th>
                        <th style="width:26%">Document</th>
                        <th style="width:22%">Type</th>
                        <th style="width:48%">Upload File (PDF only)</th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td class="text-center">1</td>
                        <td>Name and Address Verification</td>
                        <td>
                            <select asp-for="NaVerifyCode" class="form-control" asp-items="Model.NameAddressVerifications">
                                <option value="">--Select--</option>
                            </select>
                            <span asp-validation-for="NaVerifyCode" class="text-danger d-block"></span>
                        </td>
                        <td>
                            <div class="aq-doc-upload" data-existing-doc-url="@naDocUrl" data-existing-doc-label="Document already on file">
                                <input asp-for="ExistingNameAddressDocumentId" type="hidden" data-doc-existing-id />
                                <input asp-for="NameAddressFile" type="file" accept="application/pdf,.pdf" class="form-control" data-doc-input />
                                <div class="d-flex align-items-center gap-2 mt-2" data-doc-attachment hidden>
                                    <span class="badge text-bg-light border" data-doc-name></span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-doc-preview>Preview</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-doc-remove>Remove</button>
                                </div>
                                <span asp-validation-for="NameAddressFile" class="text-danger d-block" data-doc-error></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="text-center">2</td>
                        <td>Ownership Verification</td>
                        <td>
                            <select asp-for="OwnFileCode" class="form-control" asp-items="Model.OwnershipVerifications">
                                <option value="">--Select--</option>
                            </select>
                            <span asp-validation-for="OwnFileCode" class="text-danger d-block"></span>
                        </td>
                        <td>
                            <div class="aq-doc-upload" data-existing-doc-url="@ownDocUrl" data-existing-doc-label="Document already on file">
                                <input asp-for="ExistingOwnershipDocumentId" type="hidden" data-doc-existing-id />
                                <input asp-for="OwnershipFile" type="file" accept="application/pdf,.pdf" class="form-control" data-doc-input />
                                <div class="d-flex align-items-center gap-2 mt-2" data-doc-attachment hidden>
                                    <span class="badge text-bg-light border" data-doc-name></span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-doc-preview>Preview</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-doc-remove>Remove</button>
                                </div>
                                <span asp-validation-for="OwnershipFile" class="text-danger d-block" data-doc-error></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="text-center">3</td>
                        <td>Others</td>
                        <td>
                            <select asp-for="OthersDocument" class="form-control">
                                <option value="">--Select--</option>
                                <option>Others</option>
                                <option>Affidavit and Indemnity</option>
                            </select>
                            <span asp-validation-for="OthersDocument" class="text-danger d-block"></span>
                        </td>
                        <td>
                            <div class="aq-doc-upload" data-existing-doc-url="@othersDocUrl" data-existing-doc-label="Document already on file">
                                <input asp-for="ExistingOthersDocumentId" type="hidden" data-doc-existing-id />
                                <input asp-for="OthersFile" type="file" accept="application/pdf,.pdf" class="form-control" data-doc-input />
                                <div class="d-flex align-items-center gap-2 mt-2" data-doc-attachment hidden>
                                    <span class="badge text-bg-light border" data-doc-name></span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-doc-preview>Preview</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-doc-remove>Remove</button>
                                </div>
                                <span asp-validation-for="OthersFile" class="text-danger d-block" data-doc-error></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="text-center">4</td>
                        <td>Contractor Consent</td>
                        <td>
                            <select asp-for="ContractorConsentDocument" class="form-control">
                                <option>Licensed Plumber Consent Letter</option>
                            </select>
                            <span asp-validation-for="ContractorConsentDocument" class="text-danger d-block"></span>
                        </td>
                        <td>
                            <div class="aq-doc-upload" data-existing-doc-url="@consentDocUrl" data-existing-doc-label="Document already on file">
                                <input asp-for="ExistingContractorConsentDocumentId" type="hidden" data-doc-existing-id />
                                <input asp-for="ContractorConsentFile" type="file" accept="application/pdf,.pdf" class="form-control" data-doc-input />
                                <div class="d-flex align-items-center gap-2 mt-2" data-doc-attachment hidden>
                                    <span class="badge text-bg-light border" data-doc-name></span>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" data-doc-preview>Preview</button>
                                    <button type="button" class="btn btn-outline-danger btn-sm" data-doc-remove>Remove</button>
                                </div>
                                <span asp-validation-for="ContractorConsentFile" class="text-danger d-block" data-doc-error></span>
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>
    </fieldset>

    <!-- ============ Action Buttons ============ -->
    <div class="tl-actions">
        <button type="button" class="btn btn-secondary" id="aqSaveDraftBtn">Save Application</button>
        <button type="submit" class="btn btn-primary">Submit Application</button>
    </div>

</form>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/waterjs/wc-cascade.js"></script>
    <script src="~/js/waterjs/wc-validation.js"></script>
    <script src="~/js/waterjs/wc-attachments.js"></script>
    <script src="~/js/waterjs/wc-draft.js"></script>

    @if (TempData["ResumeMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var aqResumeModalEl = document.getElementById("aqResumeModal");
                if (aqResumeModalEl) {
                    new bootstrap.Modal(aqResumeModalEl).show();
                }
            });
        </script>
    }

    @if (ViewBag.ValidationFailed == true)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                var aqValidationModalEl = document.getElementById("aqValidationModal");
                if (aqValidationModalEl) {
                    new bootstrap.Modal(aqValidationModalEl).show();
                }
            });
        </script>
    }
}
