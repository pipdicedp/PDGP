@model WaterConnection.Models.WaterConnectionApplication

@{
    ViewData["Title"] = $"Acknowledgement - Application {Model.ApplicationId}";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var purposeLabels = new Dictionary<string, string>
    {
        { "NameAddress", "Name & Address Verification" },
        { "Ownership", "Ownership Verification" },
        { "Others", "Others" },
        { "ContractorConsent", "Contractor Consent" },
    };
    var docs = (Model.Documents ?? new List<WaterConnection.Models.ApplicationDocument>())
        .Where(d => d.FileContent != null && d.FileContent.Length > 0)
        .ToList();

    // Same helper/markup pattern as _PreviewApplication.cshtml's field grid,
    // so the acknowledgement slip's data section looks identical to the
    // "Preview Application" step of the Trade Licence wizard.
    string Field(string label, string? value) =>
        $"<div class=\"preview-field\"><span class=\"preview-label\">{System.Net.WebUtility.HtmlEncode(label)}</span><span class=\"preview-value\">{System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(value) ? "-" : value)}</span></div>";
}

<link rel="stylesheet" href="~/css/watercss/wc-preview.css" />

<style>
    /* Copied from _PreviewApplication.cshtml so the field/section styling
           matches the "Preview Application" wizard step exactly. */
    .preview-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .preview-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
        gap: 16px 28px;
    }

    .preview-field {
        padding-bottom: 10px;
        border-bottom: 1px solid #eee;
    }

    .preview-label {
        display: block;
        font-size: 0.72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #8a92a3;
        margin-bottom: 3px;
    }

    .preview-value {
        display: block;
        font-size: 0.92rem;
        color: #1a3a52;
        font-weight: 600;
        word-break: break-word;
    }

    .preview-doc-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid #eee;
    }

    .preview-doc-meta .preview-label {
        margin-bottom: 0;
    }

    /* Standalone cards used in place of one big ack-container wrapping
           everything -- header, application number, and the buttons each get
           their own card, with no extra heading added above them. */
    .ack-card {
        max-width: 800px;
        margin: 0 auto 25px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        padding: 28px 32px;
    }

        .ack-card .ack-header {
            border-bottom: none;
            padding-bottom: 0;
            margin-bottom: 0;
        }

        .ack-card .ack-appno {
            margin-bottom: 0;
        }

        .ack-card .ack-actions {
            margin-bottom: 0;
        }
</style>

<!-- Document preview modal: same markup/classes as Details.cshtml so a document
     preview looks and behaves identically wherever it's opened from. -->
<div class="modal fade" id="documentModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content wc-preview-modal">
            <div class="modal-header wc-preview-header">
                <h5 class="wc-preview-title" id="documentTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body wc-preview-body"><iframe id="documentFrame" class="wc-preview-frame" title="Document preview"></iframe></div>
        </div>
    </div>
</div>

<div id="waSlip">

    <div class="ack-card">
        <div class="ack-header">
            <span class="ack-success-badge">
                <i class="fas fa-check-circle"></i> Application Submitted Successfully
            </span>
            <h2>New Water Connection Application &mdash; Acknowledgement Slip</h2>
            <p>Government of Puducherry &bull; Public Works Department</p>
        </div>
    </div>

    <div class="ack-card">
        <div class="ack-appno">
            <div class="label">Application Number</div>
            <div class="value">#@Model.ApplicationId</div>
        </div>
    </div>

    <fieldset class="tl-section">
        <legend class="preview-section-header">
            <span>Applicant Details</span>
        </legend>
        <div class="preview-grid">
            @Html.Raw(Field("Name", Model.Name))
            @Html.Raw(Field("Father Name", Model.FatherName))
            @Html.Raw(Field("Spouse Name", Model.SpouseName))
            @Html.Raw(Field("Power of Attorney", Model.PowerOfAttorney))
            @Html.Raw(Field("Phone Number", Model.PhoneNumber))
            @Html.Raw(Field("Email", Model.Email))
        </div>
    </fieldset>

    <fieldset class="tl-section">
        <legend class="preview-section-header">
            <span>Communication Address</span>
        </legend>
        <div class="preview-grid">
            @Html.Raw(Field("Door Number", Model.CommDoorNo))
            @Html.Raw(Field("Address Line 1", Model.CommAddress1))
            @Html.Raw(Field("Address Line 2", Model.CommAddress2))
            @Html.Raw(Field("City", Model.CommCity))
        </div>
    </fieldset>

    <fieldset class="tl-section">
        <legend class="preview-section-header">
            <span>Connection Address</span>
        </legend>
        <div class="preview-grid">
            @Html.Raw(Field("Door Number", Model.ConnDoorNo))
            @Html.Raw(Field("Address Line 1", Model.ConnAddress1))
            @Html.Raw(Field("Address Line 2", Model.ConnAddress2))
            @Html.Raw(Field("City", Model.ConnCity))
        </div>
    </fieldset>

    <fieldset class="tl-section">
        <legend class="preview-section-header">
            <span>Connection Details</span>
        </legend>
        <div class="preview-grid">
            @Html.Raw(Field("Department", Model.Department?.DepartmentName))
            @Html.Raw(Field("Section", Model.Section?.SectionName))
            @Html.Raw(Field("Area", Model.Area?.AreaName))
            @Html.Raw(Field("Purpose", Model.Purpose?.PurposeName))
            @Html.Raw(Field("Contractor", Model.Contractor?.ContractorName))
            @Html.Raw(Field("Date of Submission", Model.ApplicationDate.ToString("dd-MM-yyyy, hh:mm tt")))
            <div class="preview-field">
                <span class="preview-label">Current Status</span>
                <span class="preview-value"><span class="myapps-status-badge myapps-status-submitted">Submitted</span></span>
            </div>
        </div>
    </fieldset>

    <fieldset class="tl-section">
        <legend class="preview-section-header">
            <span>Documents Submitted</span>
        </legend>
        @if (docs.Any())
        {
            foreach (var doc in docs)
            {
                var label = purposeLabels.TryGetValue(doc.DocumentPurpose, out var friendly) ? friendly : doc.DocumentPurpose;
                <div class="preview-doc-row">
                    <div class="preview-doc-meta">
                        <span class="preview-label">@label</span>
                    </div>
                    <button type="button"
                            class="btn btn-sm btn-secondary preview-document"
                            data-file="@Url.Action("Document", "WaterConnection", new { id = doc.DocumentId })"
                            data-title="@label"
                            title="Click to preview @label">
                        <i class="fas fa-eye"></i> View
                    </button>
                </div>
            }
        }
        else
        {
            <p class="text-muted">No documents on file</p>
        }
    </fieldset>

    <div class="ack-note">
        <i class="fas fa-info-circle"></i>
        This is a system-generated acknowledgement confirming receipt of your water connection
        application. Please retain your Application ID <strong>#@Model.ApplicationId</strong> for
        all future correspondence and status checks. This acknowledgement does not itself constitute
        approval of the connection.
    </div>

    <div class="ack-card">
        <div class="ack-actions">
            <button type="button" class="btn btn-primary" id="waDownloadBtn">
                <i class="fas fa-download"></i> Download as PDF
            </button>
            <a class="btn btn-secondary" asp-action="MyApplications">
                Back to Application Status Tracking
            </a>
        </div>
    </div>

</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            var btn = document.getElementById("waDownloadBtn");
            if (btn) {
                btn.addEventListener("click", function() {
                    window.print();
                });
            }

            // Document preview modal (same pattern as the Application Details page).
            var modalEl = document.getElementById("documentModal");
            if (modalEl) {
                var modal = new bootstrap.Modal(modalEl);
                document.querySelectorAll(".preview-document").forEach(function(e) {
                    e.addEventListener("click", function() {
                        document.getElementById("documentTitle").innerText = this.dataset.title;
                        document.getElementById("documentFrame").src = this.dataset.file;
                        modal.show();
                    });
                });
                modalEl.addEventListener("hidden.bs.modal", function() {
                    document.getElementById("documentFrame").src = "";
                });
            }
        });
    </script>
}
