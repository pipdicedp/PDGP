@model WaterConnection.Models.WaterConnectionApplication

@{
    ViewData["Title"] = $"Acknowledgement - Application {Model.ApplicationId}";

    var purposeLabels = new Dictionary<string, string>
    {
        { "NameAddress", "Name & Address Verification" },
        { "Ownership", "Ownership Verification" },
        { "Others", "Others" },
        { "ContractorConsent", "Contractor Consent" },
    };
    var docs = (Model.Documents ?? new List<WaterConnection.Models.ApplicationDocument>())
        .Where(d => d.FileContent != null && d.FileContent.Length > 0)
        .ToList();
}

<link rel="stylesheet" href="~/css/watercss/wc-ack.css" />

<div class="wa-page">
    <div class="wa-shell">

        <div class="wa-toolbar">
            <a asp-action="MyApplications" class="wa-back">← Back to Application Status Tracking</a>
            <button type="button" class="wa-download-btn" id="waDownloadBtn">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                Download as PDF
            </button>
        </div>

        <div class="wa-slip" id="waSlip">

            <div class="wa-slip-header">
                <div>
                    <p class="wa-gov">Government of Puducherry &middot; Public Works Department</p>
                    <h1 class="wa-title">Water Connection Application</h1>
                    <p class="wa-subtitle">Submission Acknowledgement</p>
                </div>
                <div class="wa-status-block">
                    <span class="wa-status-badge">Submitted</span>
                </div>
            </div>

            <div class="wa-appid-row">
                <div class="wa-appid-block">
                    <span class="wa-appid-label">Application ID</span>
                    <span class="wa-appid-value">#@Model.ApplicationId</span>
                </div>
                <div class="wa-appid-block">
                    <span class="wa-appid-label">Submitted On</span>
                    <span class="wa-appid-value">@Model.ApplicationDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>
            </div>

            <div class="wa-sections">

                <div class="wa-section wa-span-2">
                    <p class="wa-section-title">Applicant Details</p>
                    <div class="wa-grid">
                        <div class="wa-field">
                            <label>Name</label>
                            <div class="wa-value">@Model.Name</div>
                        </div>
                        <div class="wa-field">
                            <label>Father Name</label>
                            <div class="wa-value">@(Model.FatherName ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Spouse Name</label>
                            <div class="wa-value">@(Model.SpouseName ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Power of Attorney</label>
                            <div class="wa-value">@(Model.PowerOfAttorney ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Phone Number</label>
                            <div class="wa-value">@Model.PhoneNumber</div>
                        </div>
                        <div class="wa-field">
                            <label>Email</label>
                            <div class="wa-value">@(Model.Email ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="wa-section">
                    <p class="wa-section-title">Communication Address</p>
                    <div class="wa-grid">
                        <div class="wa-field">
                            <label>Door No</label>
                            <div class="wa-value">@(Model.CommDoorNo ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>City</label>
                            <div class="wa-value">@(Model.CommCity ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Address Line 1</label>
                            <div class="wa-value">@(Model.CommAddress1 ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Address Line 2</label>
                            <div class="wa-value">@(Model.CommAddress2 ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="wa-section">
                    <p class="wa-section-title">Connection Address</p>
                    <div class="wa-grid">
                        <div class="wa-field">
                            <label>Door No</label>
                            <div class="wa-value">@(Model.ConnDoorNo ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>City</label>
                            <div class="wa-value">@(Model.ConnCity ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Address Line 1</label>
                            <div class="wa-value">@(Model.ConnAddress1 ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Address Line 2</label>
                            <div class="wa-value">@(Model.ConnAddress2 ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="wa-section wa-span-2">
                    <p class="wa-section-title">Work &amp; Contractor Details</p>
                    <div class="wa-grid">
                        <div class="wa-field">
                            <label>Department</label>
                            <div class="wa-value">@(Model.Department?.DepartmentName ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Section</label>
                            <div class="wa-value">@(Model.Section?.SectionName ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Area</label>
                            <div class="wa-value">@(Model.Area?.AreaName ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Purpose</label>
                            <div class="wa-value">@(Model.Purpose?.PurposeName ?? "—")</div>
                        </div>
                        <div class="wa-field">
                            <label>Contractor</label>
                            <div class="wa-value">@(Model.Contractor?.ContractorName ?? "—")</div>
                        </div>
                    </div>
                </div>

                <div class="wa-section wa-span-2">
                    <p class="wa-section-title">Documents Submitted</p>
                    <div class="wa-docs">
                        @foreach (var doc in docs)
                        {
                            var label = purposeLabels.TryGetValue(doc.DocumentPurpose, out var friendly) ? friendly : doc.DocumentPurpose;
                            <span class="wa-doc-chip">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                @label
                            </span>
                        }
                        @if (!docs.Any())
                        {
                            <span class="wa-value">No documents on file</span>
                        }
                    </div>
                </div>

            </div>

            <p class="wa-footer-note">
                This is a system-generated acknowledgement confirming receipt of your water connection
                application. Please retain your Application ID <strong>#@Model.ApplicationId</strong> for
                all future correspondence and status checks. This acknowledgement does not itself constitute
                approval of the connection.
            </p>

        </div>

    </div>
</div>

@section Scripts
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var btn = document.getElementById("waDownloadBtn");
            if (btn) {
                btn.addEventListener("click", function () {
                    window.print();
                });
            }
        });
    </script>
}
