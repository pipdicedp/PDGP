@model IEnumerable<WaterConnection.Models.WaterConnectionApplication>

@{
    ViewData["Title"] = "Application Status Tracking";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">

    <div class="status-page-header">
        Water Connection &mdash; Application Status Tracking
    </div>

    <div class="dashboard-body">

        <div class="page-title">
            <h3>Your Applications</h3>
            <p>Track every water connection application you have started or submitted.</p>
        </div>

        @if (!Model.Any())
        {
            <p class="tl-note text-center">You haven't started a water connection application yet.</p>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="tl-partner-table">
                    <thead>
                        <tr>
                            <th>Sl No.</th>
                            <th>Application ID</th>
                            <th>Name</th>
                            <th>Purpose</th>
                            <th>Applied On</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int slNo = 1;
                        }
                        @foreach (var item in Model)
                        {
                            var isSubmitted = string.Equals(item.Status, "Submitted", StringComparison.OrdinalIgnoreCase);
                            var statusClass = isSubmitted ? "myapps-status-submitted" : "myapps-status-draft";

                            <tr>
                                <td>@slNo</td>
                                <td>@item.ApplicationId</td>
                                <td>@item.Name</td>
                                <td>@(item.Purpose?.PurposeName ?? "—")</td>
                                <td>@item.ApplicationDate.ToString("dd-MM-yyyy")</td>
                                <td><span class="myapps-status-badge @statusClass">@item.Status</span></td>
                                <td>
                                    @if (isSubmitted)
                                    {
                                        <a class="myapps-btn myapps-btn-view" asp-action="Acknowledgement" asp-route-id="@item.ApplicationId">View</a>
                                    }
                                    else
                                    {
                                        <a class="myapps-btn" asp-action="Index">Continue</a>
                                    }
                                </td>
                            </tr>
                            slNo++;
                        }
                    </tbody>
                </table>
            </div>

            <hr class="myapps-divider" />
        }

        <div class="myapps-new-wrap">
            <a asp-action="Index" class="myapps-new-btn">+ Apply for New Water Connection</a>
        </div>

        <div class="text-center" style="margin-top: 10px;">
            <a asp-action="Home" class="btn btn-secondary">&laquo; Back to Water Connection</a>
        </div>

    </div>

</div>
