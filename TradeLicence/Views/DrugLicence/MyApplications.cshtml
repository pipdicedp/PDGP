@model TradeLicence.Models.Drugs.DrugLicenceListViewModel
@{
    ViewData["Title"] = "My Applications - " + Model.Form.Title;
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var ctrl = Model.Form.Controller;
}
@section Styles {
    <link rel="stylesheet" href="~/css/tl_css/dashboard.css" asp-append-version="true" />
}
<div class="dashboard-body">

    @if (TempData["Message"] != null)
    {
        <p class="tl-note" style="color:#1a7f4b; font-weight:600;">@TempData["Message"]</p>
    }
    @if (TempData["Error"] != null)
    {
        <p class="tl-note" style="color:#B3261E; font-weight:600;">@TempData["Error"]</p>
    }

    <div class="dashboard-banner">
        <div class="dashboard-banner-text">
            <span class="dashboard-banner-icon">💊</span>
            <div>
                <h3>@Model.Form.Title</h3>
                <p>Continue a draft, pay a pending request, track status or download your approval.</p>
            </div>
        </div>
    </div>

    @if (Model.Applications.Any())
    {
        <div class="myapps-list">
            @foreach (var app in Model.Applications)
            {
                var statusClass = app.Status switch
                {
                    "Draft" => "myapps-status-draft",
                    "Submitted" => app.CurrentStage == "Initial Scrutiny" ? "myapps-status-submitted" : "myapps-status-review",
                    "ReturnedToApplicant" => "myapps-status-rejected",
                    "Approved" => "myapps-status-approved",
                    "Rejected" => "myapps-status-rejected",
                    _ => "myapps-status-draft"
                };
                var statusText = app.Status switch
                {
                    "Submitted" => app.CurrentStage == "Initial Scrutiny" ? "Submitted" : $"In Progress — {app.CurrentStage}",
                    "ReturnedToApplicant" => "Returned for Correction",
                    _ => app.Status
                };
                var rowClass = app.Status switch
                {
                    "Draft" => "myapps-row-draft",
                    "Submitted" => app.CurrentStage == "Initial Scrutiny" ? "myapps-row-submitted" : "myapps-row-review",
                    "Approved" => "myapps-row-approved",
                    "Rejected" or "ReturnedToApplicant" => "myapps-row-rejected",
                    _ => "myapps-row-draft"
                };
                var paymentPending = app.Status == "Submitted" && app.PaymentStatus == "Pending";
                Model.Payments.TryGetValue(app.ApplicationId, out var payment);

                <div class="myapps-row @rowClass">
                    <div class="myapps-info">
                        <span class="myapps-name">@(string.IsNullOrWhiteSpace(app.FirmName) ? "Untitled application" : app.FirmName)</span>
                        <span class="myapps-meta">
                            @(app.ApplicationNumber ?? "No application number yet")
                            &bull; Started @app.CreatedDate.ToLocalTime().ToString("dd-MM-yyyy")
                            &bull; @(app.IsRenewal ? "Renewal" : "Registration")
                        </span>
                        @if ((app.Status == "ReturnedToApplicant" || app.Status == "Rejected") && !string.IsNullOrWhiteSpace(app.OfficerRemarks))
                        {
                            <span class="myapps-remarks">Officer's note: "@app.OfficerRemarks"</span>
                        }
                        @if (paymentPending && payment != null)
                        {
                            <span class="myapps-meta">Payment requested: &#8377;@payment.TotalPaymentAmount.ToString("N2")</span>
                        }
                    </div>
                    <span class="myapps-status-badge @statusClass">@statusText</span>

                    @if (app.Status == "Draft")
                    {
                        <a class="myapps-btn" asp-controller="@ctrl" asp-action="Apply" asp-route-id="@app.ApplicationId">Continue</a>
                    }
                    else if (app.Status == "ReturnedToApplicant")
                    {
                        <a class="myapps-btn" asp-controller="@ctrl" asp-action="Apply" asp-route-id="@app.ApplicationId">Correct &amp; Resubmit</a>
                    }
                    else if (paymentPending)
                    {
                        <form method="post" asp-controller="@ctrl" asp-action="PayNow" style="display:inline;" class="drug-pay-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@app.ApplicationId" />
                            <button type="button" class="myapps-btn drug-pay-now" style="background:#1D6E3E; border:none; cursor:pointer;">
                                <i class="fas fa-indian-rupee-sign"></i> Pay Now (Test)
                            </button>
                        </form>
                    }
                    else if (app.Status == "Approved")
                    {
                        <a class="myapps-btn" style="background:#1D6E3E;" asp-controller="@ctrl" asp-action="DownloadApproval" asp-route-id="@app.ApplicationId">
                            <i class="fa-solid fa-download"></i> Download Approval
                        </a>
                    }
                    else
                    {
                        <a class="myapps-btn myapps-btn-view" asp-controller="@ctrl" asp-action="Details" asp-route-id="@app.ApplicationId">View</a>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="myapps-empty">
            <div class="myapps-empty-icon">🗂️</div>
            <p>You haven't started any application for this service yet.</p>
        </div>
    }

    <div class="myapps-new-wrap">
        <a class="myapps-new-btn" asp-controller="@ctrl" asp-action="Apply">
            <i class="fa-solid fa-plus"></i> New Application
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.drug-pay-now').forEach(function (btn) {
            btn.addEventListener('click', function () {
                if (confirm('Proceed with the payment?')) btn.closest('form').submit();
            });
        });
    </script>
}
