@model List<TradeLicence.Models.OfficerQueueItem>
@{
    ViewData["Title"] = "Officer Dashboard";
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";

    int submittedCount = Model.Count;
}
@section Styles {
    <link rel="stylesheet" href="~/css/tl_css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/officer_css/officer.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">

    <div class="dashboard-body">

        <div class="dashboard-banner">
            <div class="dashboard-banner-text">
                <span class="dashboard-banner-icon">🗃️</span>
                <div>
                    <h3>Officer Dashboard@(string.IsNullOrEmpty(ViewBag.Designation) ? "" : $" — {ViewBag.Designation}")@(string.IsNullOrEmpty(ViewBag.Department) ? "" : $" ({ViewBag.Department})")</h3>
                    <p>Submitted Applications — awaiting review</p>
                </div>
            </div>
        </div>

        <div class="status-stats">
            <div class="stat-card stat-card-submitted">
                <div class="stat-label">Waiting for Review</div>
                <div class="stat-value">@submittedCount</div>
            </div>
        </div>

        <div class="status-controls-card">
            <div class="status-table-controls">
                <div class="status-show-entries">
                    Show
                    <select id="statusPageSize">
                        <option value="10" selected>10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    entries
                </div>
                <div class="status-search">
                    Search: <input type="text" id="statusSearchBox" placeholder="Search applications..." />
                </div>
            </div>

            @if (!Model.Any())
            {
                <p class="tl-note">No applications have been submitted yet.</p>
            }
            else
            {
                <div class="status-table-scroll">
                    <table class="status-apps-table" id="statusTable">
                        <thead>
                            <tr>
                                <th>Sl No.</th>
                                <th>Application ID</th>
                                <th>Service</th>
                                <th>Applicant Name</th>
                                <th>Contact</th>
                                <th>Date of Application</th>
                                <th>Current Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int slNo = 1;
                            }
                            @foreach (var item in Model)
                            {
                                var statusClass = item.Status switch
                                {
                                    "Draft" => "myapps-status-draft",
                                    "Submitted" => "myapps-status-submitted",
                                    "UnderReview" => "myapps-status-review",
                                    "Approved" => "myapps-status-approved",
                                    "Rejected" => "myapps-status-rejected",
                                    _ => "myapps-status-draft"
                                };

                                <tr>
                                    <td>@slNo</td>
                                    <td>@item.ApplicationId</td>
                                    <td>@item.ServiceType</td>
                                    <td>@(string.IsNullOrEmpty(item.DisplayName) ? "—" : item.DisplayName)</td>
                                    <td>@(string.IsNullOrEmpty(item.Contact) ? "—" : item.Contact)</td>
                                    <td>@item.SubmittedDate.ToString("dd-MM-yyyy")</td>
                                    <td><span class="myapps-status-badge @statusClass">@item.Status</span></td>
                                    <td>
                                        <a class="myapps-btn myapps-btn-view" href="@item.ViewUrl">View</a>
                                    </td>
                                </tr>
                                slNo++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/tl_js/tl_status.js" asp-append-version="true"></script>
    <script src="~/js/officer_js/officer.js" asp-append-version="true"></script>

    @if (TempData["OfficerActionMessage"] != null)
    {
        <script>
            showOfficerActionAlert(
                                        @Html.Raw(Json.Serialize(TempData["OfficerActionType"] as string ?? "")),
                @Html.Raw(Json.Serialize(TempData["OfficerActionMessage"]))
            );
        </script>
    }
}
