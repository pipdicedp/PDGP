@model TradeLicence.Models.OfficerCreateViewModel
@{
    ViewData["Title"] = "Officer Creation";
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";

    var designations = (string[])(ViewBag.Designations ?? Array.Empty<string>());
}
@section Styles {
    <link rel="stylesheet" href="~/css/tl_css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/officer_css/officer.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">

    <div class="dashboard-body">

        <div class="dashboard-banner">
            <div class="dashboard-banner-text">
                <span class="dashboard-banner-icon">🧑‍💼</span>
                <div>
                    <h3>Officer Creation</h3>
                    <p>Create a new Officer account — each Designation drives which workflow stage they can act on</p>
                </div>
            </div>
        </div>

        <div class="status-controls-card">
            <form asp-controller="Officer" asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <fieldset class="tl-section">
                    <legend>Account Details</legend>

                    <div class="tl-grid-2">
                        <div class="form-group">
                            <label asp-for="Username">Username <span class="req">*</span></label>
                            <input asp-for="Username" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Username" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email">Email</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password">Password <span class="req">*</span></label>
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ConfirmPassword">Confirm Password <span class="req">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>
                    </div>
                </fieldset>

                <fieldset class="tl-section">
                    <legend>Officer Details</legend>

                    <div class="tl-grid-2">
                        <div class="form-group">
                            <label asp-for="FullName">Full Name</label>
                            <input asp-for="FullName" class="form-control" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Department">Department</label>
                            <input asp-for="Department" class="form-control" placeholder="e.g. Industries and Commerce" />
                            <span asp-validation-for="Department" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Designation">Designation <span class="req">*</span></label>
                            <select asp-for="Designation" class="form-select">
                                <option value="">-- Select Designation --</option>
                                @foreach (var d in designations)
                                {
                                    <option value="@d">@d</option>
                                }
                            </select>
                            <span asp-validation-for="Designation" class="text-danger"></span>
                            <span class="tl-note">
                                Determines which workflow stage this officer handles —
                                DEO: Initial Scrutiny, Manager: Verification, Inspection Officer: Inspection,
                                GM: Approval. Admin sits outside the workflow.
                            </span>
                        </div>

                        @* <div class="form-group" style="align-self:end;">
                            <div class="form-check">
                                <input asp-for="IsLocked" class="form-check-input" />
                                <label asp-for="IsLocked" class="form-check-label">Lock this account immediately</label>
                            </div>
                        </div> *@
                    </div>
                </fieldset>

                <div class="tl-actions" style="text-align:left; border-top:none; padding-top:0;">
                    <button type="submit" class="btn btn-primary">Create User</button>
                    <a class="btn btn-secondary" href="@Url.Action("ExistingOfficers", "Officer")">View Existing Officers</a>
                    <a class="btn btn-secondary" href="@Url.Action("Index", "Officer")">Back to Dashboard</a>
                </div>
            </form>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/officer_js/officer.js" asp-append-version="true"></script>

    @if (TempData["OfficerActionMessage"] != null)
    {
        <script>
            showOfficerActionAlert(
                            @Html.Raw(Json.Serialize(TempData["OfficerActionType"] as string ?? "")),
                @Html.Raw(Json.Serialize(TempData["OfficerActionMessage"]))
            );
        </script>
    }
}
