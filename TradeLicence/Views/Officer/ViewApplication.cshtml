@model TradeLicence.Models.ApplicationPreviewViewModel
@{
    ViewData["Title"] = "Application Details";
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/tl_css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/officer_css/officer.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">

    <div class="status-page-header">
        Application Details — @(Model.Application.ApplicationNumber ?? "-")
    </div>

    @{
        var stages = TradeLicence.Models.OfficerWorkflow.Stages;
        var currentStageIndex = TradeLicence.Models.OfficerWorkflow.StageIndex((string)ViewBag.CurrentStage);
    }
    <div class="tl-stepper-bar">
        <div class="tl-stepper">
            @for (int i = 0; i < stages.Length; i++)
            {
                var stepClass = i < currentStageIndex ? "tl-step-done"
                    : i == currentStageIndex ? "tl-step-current"
                    : "tl-step-upcoming";

                <div class="tl-step @stepClass">
                    <div class="tl-step-circle">
                        @if (i < currentStageIndex)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else
                        {
                            @(i + 1)
                        }
                    </div>
                    <div class="tl-step-label">@stages[i]</div>
                </div>
                if (i < stages.Length - 1)
                {
                    <div class="tl-step-connector @(i < currentStageIndex ? "tl-step-connector-done" : "")"></div>
                }
            }
        </div>
    </div>

    <div class="dashboard-body">

        @{
            var history = (List<TradeLicence.Models.ApplicationWorkflowHistory>)ViewBag.WorkflowHistory;
            var officerNames = (Dictionary<int, string>)ViewBag.OfficerNames;
            var revertTarget = (TradeLicence.Models.ApplicationWorkflowHistory?)ViewBag.RevertTarget;
            var revertToName = revertTarget?.FromOfficerId.HasValue == true && officerNames.ContainsKey(revertTarget.FromOfficerId.Value)
                ? officerNames[revertTarget.FromOfficerId.Value] : "previous officer";
        }

        <partial name="_PreviewApplication" model="Model" />

        <div class="tl-section-divider">
            <span class="tl-section-divider-icon"><i class="fa-solid fa-angles-down"></i></span>
        </div>

        <div class="tl-officer-panel">

            @{
                var canUploadStageDocument = (bool)ViewBag.CanUploadStageDocument;
                var existingForCurrentStage = (TradeLicence.Models.OfficerSupportingDocument?)ViewBag.ExistingStageDocumentForCurrentStage;
            }

            <div class="tl-officer-panel-title">
                <i class="fa-solid fa-users-gear"></i> Officer Workflow
            </div>

            <form id="returnForm" method="post" asp-action="ReturnToApplicant" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Application.ApplicationId" />
                <input type="hidden" name="remarks" id="returnRemarks" />
            </form>

            <form id="approveForm" method="post" asp-action="ApproveApplication" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Application.ApplicationId" />
                <input type="hidden" name="remarks" id="approveRemarks" />
            </form>

            <form id="revertForm" method="post" asp-action="RevertToPreviousOfficer" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Application.ApplicationId" />
                <input type="hidden" name="remarks" id="revertRemarks" />
            </form>

            <form id="rejectForm" method="post" asp-action="RejectApplication" style="display:none;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Application.ApplicationId" />
                <input type="hidden" name="remarks" id="rejectRemarks" />
            </form>

            <div class="tl-grid-2">

                <!-- LEFT: Forward to Officer / Final Approval -->
                <div>
                    @{
                        var isInspectionStage = (string)ViewBag.CurrentStage == "Inspection";
                        var payment = (TradeLicence.Models.TradeLicencePayment?)ViewBag.Payment;
                        var paymentStatus = payment?.PaymentStatus ?? "NotRequested";
                        var forwardBlocked = isInspectionStage && paymentStatus != "Paid";
                        var paymentPendingBlock = paymentStatus == "Pending";
                    }
                    @if (isInspectionStage)
                    {
                        var paymentStatusIcon = paymentStatus == "Paid" ? "fa-circle-check" : paymentStatus == "Pending" ? "fa-hourglass-half" : "fa-circle-info";
                        var paymentStatusLabel = paymentStatus == "Paid" ? "Paid" : paymentStatus == "Pending" ? "Pending" : "Not Requested";

                        <div class="tl-section tl-card-blue">
                            <div id="paymentAccordionHeader" class="tl-payment-legend" role="button" tabindex="0" aria-expanded="false">
                                <span><i class="fa-solid fa-indian-rupee-sign"></i> Payment Calculation</span>
                                <span class="tl-payment-header-right">
                                    <span class="tl-payment-status tl-payment-status-@(paymentStatus.ToLower())">
                                        <i class="fa-solid @paymentStatusIcon"></i> @paymentStatusLabel
                                    </span>
                                    <i class="fa-solid fa-chevron-down tl-payment-chevron"></i>
                                </span>
                            </div>

                            <form id="sendPaymentForm" method="post" asp-action="SendPaymentRequest" style="display:none;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Application.ApplicationId" />
                            </form>

                            <div id="paymentAccordionBody" class="tl-payment-body" style="display:none;">
                                <div class="tl-payment-card">
                                    <div class="tl-payment-row">
                                        <span>Application Payment</span>
                                        <span>&#8377;@((payment?.PaymentAmount ?? 1000m).ToString("N2"))</span>
                                    </div>
                                    <div class="tl-payment-row">
                                        <span>Extra Charge</span>
                                        <span>&#8377;@((payment?.ExtraCharge ?? 500m).ToString("N2"))</span>
                                    </div>
                                    <div class="tl-payment-row tl-payment-row-total">
                                        <span>Total Amount</span>
                                        <span>&#8377;@((payment?.TotalPaymentAmount ?? 1500m).ToString("N2"))</span>
                                    </div>
                                </div>

                                @if (paymentStatus == "Paid")
                                {
                                    <p class="tl-payment-note tl-payment-note-paid">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Payment received on @(payment?.PaymentCompletedDate?.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt") ?? "-")
                                    </p>
                                }
                                else if (paymentStatus == "Pending")
                                {
                                    <p class="tl-payment-note tl-payment-note-pending">
                                        <i class="fa-solid fa-hourglass-half"></i>
                                        Requested on @(payment?.PaymentRequestedDate.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt") ?? "-") — awaiting payment from the applicant.
                                    </p>
                                }
                                else
                                {
                                    <div class="tl-officer-actions-group">
                                        <button type="button" id="btnSendPayment" class="btn btn-primary">Send Payment Request to Applicant</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (!(bool)ViewBag.IsFinalStage)
                    {
                        <fieldset class="tl-section tl-card-navy">
                            <legend><i class="fa-solid fa-paper-plane"></i> Forward to Officer</legend>

                            <form method="post" asp-action="ForwardToOfficer" id="forwardOfficerForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Application.ApplicationId" />
                                <input type="hidden" name="officerId" id="forwardOfficerId" />
                                <input type="hidden" name="targetStage" id="forwardTargetStage" />

                                <div class="form-group">
                                    <label>Forward To <span class="req">*</span></label>
                                    <select id="forwardOfficerSelect" class="form-select" required @(forwardBlocked ? "disabled" : "")>
                                        <option value="">-- Select officer --</option>
                                        @{
                                            // Grouped by target STAGE, not raw Designation — a "Manager"
                                            // can appear under both Verification and Inspection, so the
                                            // stage the officer is being sent to has to be explicit.
                                            var forwardableByStage = ((List<(string Stage, TradeLicence.Models.Officer Officer)>)ViewBag.ForwardableByStage)
                                                .GroupBy(x => x.Stage);
                                        }
                                        @foreach (var group in forwardableByStage)
                                        {
                                            <optgroup label="@group.Key">
                                                @foreach (var entry in group)
                                                {
                                                    <option value="@entry.Officer.OfficerId:@group.Key">@entry.Officer.FullName (@entry.Officer.Username)</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                    @if (((List<(string Stage, TradeLicence.Models.Officer Officer)>)ViewBag.ForwardableByStage).Count == 0)
                                    {
                                        <span class="tl-note">No officers found for the next stage(s) — add one under the applicable Designation first.</span>
                                    }
                                    @if (forwardBlocked)
                                    {
                                        <span class="tl-note" style="color:#B3261E;">This application can't be forwarded until the payment above has been received.</span>
                                    }
                                </div>

                                <div class="form-group">
                                    <label>Remarks</label>
                                    <textarea name="remarks" class="form-control" rows="2" placeholder="Optional remarks for the next officer..." @(forwardBlocked ? "disabled" : "")></textarea>
                                </div>
                            </form>

                            @if (canUploadStageDocument)
                            {
                                <div class="form-group">
                                    <label>Upload @ViewBag.CurrentStage Document</label>
                                    <p id="currentStageFileNote" class="tl-note" style="@(existingForCurrentStage == null ? "display:none;" : "")">
                                        @if (existingForCurrentStage != null)
                                        {
                                            <text>
                                                Current file: <strong>@existingForCurrentStage.FileName</strong>
                                                (uploaded @existingForCurrentStage.UploadedDate.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")).
                                                Uploading a new file will replace it.
                                            </text>
                                        }
                                    </p>
                                    <form id="stageDocumentUploadForm" method="post"
                                          asp-action="UploadStageDocument" asp-route-id="@Model.Application.ApplicationId"
                                          enctype="multipart/form-data" style="display:flex; gap:10px; align-items:center;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Application.ApplicationId" />
                                        <input type="file" name="file" class="form-control" required style="flex:1;" />
                                        <button type="submit" class="btn btn-primary" style="flex-shrink:0;">Upload</button>
                                        <button type="button" id="stageDocPreviewBtn" class="btn btn-secondary tl-stage-preview-btn"
                                                style="flex-shrink:0; @(existingForCurrentStage == null ? "display:none;" : "")"
                                                data-preview-url="@(existingForCurrentStage != null ? Url.Action("PreviewStageDocument", new { docId = existingForCurrentStage.OfficerSupportingDocumentId }) : "")"
                                                data-content-type="@existingForCurrentStage?.ContentType"
                                                data-file-name="@existingForCurrentStage?.FileName">
                                            Preview
                                        </button>
                                    </form>
                                </div>
                            }

                            <div class="tl-officer-actions-group">
                                <button type="submit" form="forwardOfficerForm" class="btn btn-primary" @(forwardBlocked ? "disabled" : "")>Forward Application</button>
                                @if (revertTarget != null)
                                {
                                    <button type="button" id="btnRevert" class="btn btn-revert" data-revert-to="@revertToName" @(paymentPendingBlock ? "disabled" : "")><i class="fa-solid fa-rotate-left"></i> Revert to Officer</button>
                                }
                            </div>
                            @if (paymentPendingBlock)
                            {
                                <span class="tl-note" style="color:#B3261E;">Revert and Return-to-Applicant are disabled while a payment is pending with the applicant.</span>
                            }
                        </fieldset>
                    }
                    else
                    {
                        var stageDocuments = (List<TradeLicence.Models.OfficerSupportingDocument>)ViewBag.StageDocuments;
                        var stageDocOfficerNames = (Dictionary<int, string>)ViewBag.StageDocumentOfficerNames;

                        if (stageDocuments.Count > 0)
                        {
                            <fieldset class="tl-section tl-card-purple">
                                <legend><i class="fa-solid fa-folder-open"></i> Stage Supporting Documents</legend>
                                @foreach (var doc in stageDocuments)
                                {
                                    var uploaderName = stageDocOfficerNames.ContainsKey(doc.UploadedByOfficerId)
                                        ? stageDocOfficerNames[doc.UploadedByOfficerId] : "-";
                                    <div class="tl-history-item">
                                        <span class="tl-history-icon"><i class="fa-solid fa-file-lines"></i></span>
                                        <div class="tl-history-body">
                                            <div class="tl-history-action">@doc.Stage</div>
                                            <div class="tl-history-meta">
                                                <a href="@Url.Action("DownloadStageDocument", new { docId = doc.OfficerSupportingDocumentId })" target="_blank">@doc.FileName</a><br />
                                                Uploaded by @uploaderName on @doc.UploadedDate.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")
                                            </div>
                                        </div>
                                    </div>
                                }
                            </fieldset>
                        }

                        <fieldset class="tl-section tl-card-green">
                            <legend><i class="fa-solid fa-stamp"></i> Final Approval</legend>
                            <p class="tl-note">This application has reached the final stage (Approval). Approve it to finish the process, return it to the applicant if something needs correcting, or reject it outright.</p>
                            <div class="tl-officer-actions-group">
                                <button type="button" id="btnApprove" class="btn btn-success">Approve Application</button>
                                <button type="button" id="btnReject" class="btn btn-danger">Reject Application</button>
                                @if (revertTarget != null)
                                {
                                    <button type="button" id="btnRevert" class="btn btn-revert" data-revert-to="@revertToName" @(paymentPendingBlock ? "disabled" : "")><i class="fa-solid fa-rotate-left"></i> Revert to Officer</button>
                                }
                            </div>
                        </fieldset>
                    }
                </div>

                <!-- RIGHT: Forwarding History -->
                <div>
                    @if (history.Count > 0)
                    {
                        <fieldset class="tl-section tl-card-gold">
                            <legend><i class="fa-solid fa-clock-rotate-left"></i> Forwarding History</legend>
                            <div class="tl-history-scroll">
                                @for (int i = history.Count - 1; i >= 0; i--)
                                {
                                    var h = history[i];
                                    var fromName = h.FromOfficerId.HasValue && officerNames.ContainsKey(h.FromOfficerId.Value)
                                        ? officerNames[h.FromOfficerId.Value] : "Applicant";
                                    var toName = h.ToOfficerId.HasValue && officerNames.ContainsKey(h.ToOfficerId.Value)
                                        ? officerNames[h.ToOfficerId.Value] : "-";
                                    var isRevert = h.ActionType == "Revert";

                                    // "Received on" for the first hop is when the citizen
                                    // submitted (Application.CreatedDate) — every hop after
                                    // that, it's simply when the previous hop happened.
                                    // (i still walks in chronological order here — only the
                                    // rendering above starts from the end, not this lookup.)
                                    var receivedOn = i > 0 ? history[i - 1].ActionDate : Model.Application.CreatedDate;
                                    var forwardedOn = h.ActionDate;
                                    var duration = forwardedOn - receivedOn;
                                    var takenText = duration.TotalDays >= 1
                                        ? $"{(int)duration.TotalDays} day{((int)duration.TotalDays == 1 ? "" : "s")}"
                                        : duration.TotalHours >= 1
                                            ? $"{(int)duration.TotalHours} hour{((int)duration.TotalHours == 1 ? "" : "s")}"
                                            : "under an hour";

                                    <div class="tl-history-item @(isRevert ? "tl-history-revert" : "")">
                                        <span class="tl-history-icon"><i class="fa-solid @(isRevert ? "fa-rotate-left" : "fa-share")"></i></span>
                                        <div class="tl-history-body">
                                            <div class="tl-history-action">
                                                @(isRevert ? "Reverted" : "Forwarded")
                                                @if (i == history.Count - 1)
                                                {
                                                    <span class="tl-history-latest-tag">Latest</span>
                                                }
                                            </div>
                                            <div class="tl-history-route">@fromName (@h.FromStage) &rarr; @toName (@h.ToStage)</div>
                                            <div class="tl-history-meta">
                                                Received: @receivedOn.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")<br />
                                                Forwarded: @forwardedOn.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")<br />
                                                Time taken: @takenText
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(h.Remarks))
                                            {
                                                <div class="tl-history-remarks">"@h.Remarks"</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }
                    else
                    {
                        <fieldset class="tl-section tl-card-gold">
                            <legend><i class="fa-solid fa-clock-rotate-left"></i> Forwarding History</legend>
                            <p class="tl-note">No forwarding activity yet.</p>
                        </fieldset>
                    }
                </div>

            </div>

            <div class="tl-actions">
                <a class="btn btn-secondary" href="@Url.Action("Index", "Officer")">&laquo; Back to Dashboard</a>
                <button type="button" id="btnReturnToApplicant" class="btn btn-warning" @(paymentPendingBlock ? "disabled" : "")>Return to Applicant</button>
            </div>

        </div>

    </div>

    <div id="stageDocPreviewModal" class="tl-stage-preview-overlay" style="display:none;">
        <div class="tl-stage-preview-box">
            <div class="tl-stage-preview-header">
                <span id="stageDocPreviewTitle">Preview</span>
                <button type="button" id="stageDocPreviewClose" class="tl-stage-preview-close">&times;</button>
            </div>
            <div id="stageDocPreviewContent" class="tl-stage-preview-body"></div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/tl_js/tl_document_preview_modal.js" asp-append-version="true"></script>
    <script src="~/js/officer_js/officer.js" asp-append-version="true"></script>
}
