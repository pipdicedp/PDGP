@model List<TradeLicence.Models.ApplicationStatusItem>
@{
    ViewData["Title"] = "Application Status Tracking";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    // ---- status counts for the summary cards ----
    int draftCount = Model.Count(a => string.Equals(a.Status, "Draft", StringComparison.OrdinalIgnoreCase));
    int submittedCount = Model.Count(a => string.Equals(a.Status, "Submitted", StringComparison.OrdinalIgnoreCase) && string.Equals(a.CurrentStage, "Initial Scrutiny", StringComparison.OrdinalIgnoreCase));
    int progressCount = Model.Count(a => string.Equals(a.Status, "Submitted", StringComparison.OrdinalIgnoreCase) && !string.Equals(a.CurrentStage, "Initial Scrutiny", StringComparison.OrdinalIgnoreCase));
    int approvedCount = Model.Count(a => string.Equals(a.Status, "Approved", StringComparison.OrdinalIgnoreCase));
    int rejectedCount = Model.Count(a => string.Equals(a.Status, "Rejected", StringComparison.OrdinalIgnoreCase) || string.Equals(a.Status, "ReturnedToApplicant", StringComparison.OrdinalIgnoreCase));
}
@section Styles {
    <link rel="stylesheet" href="~/css/tl_css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">

    <div class="status-page-header">
        Application Status Tracking
    </div>

    <div class="dashboard-body">

        <div class="page-title">
            <h3>Your Applications</h3>
            <p>Track every Trade Licence application you have started or submitted.</p>
        </div>

        @* ===== Status summary cards ===== *@
        <div class="status-stats">
            <div class="stat-card stat-card-draft">
                <div class="stat-label">Draft</div>
                <div class="stat-value">@draftCount</div>
            </div>
            <div class="stat-card stat-card-submitted">
                <div class="stat-label">Submitted</div>
                <div class="stat-value">@submittedCount</div>
            </div>
            <div class="stat-card stat-card-progress">
                <div class="stat-label">In Progress</div>
                <div class="stat-value">@progressCount</div>
            </div>
            <div class="stat-card stat-card-approved">
                <div class="stat-label">Approved</div>
                <div class="stat-value">@approvedCount</div>
            </div>
            <div class="stat-card stat-card-rejected">
                <div class="stat-label">Rejected</div>
                <div class="stat-value">@rejectedCount</div>
            </div>
        </div>

        @* ===== Table controls: show-entries + search, like the screenshot ===== *@
        <div class="status-table-controls">
            <div class="status-show-entries">
                Show
                <select id="statusPageSize">
                    <option value="10" selected>10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                entries
            </div>
            <div class="status-search">
                Search: <input type="text" id="statusSearchBox" placeholder="Search applications..." />
            </div>
        </div>

        @if (!Model.Any())
        {
            <p class="tl-note">You haven't started any applications yet.</p>
        }
        else
        {
            <div style="overflow-x:auto;">
                <table class="tl-partner-table" id="statusTable">
                    <thead>
                        <tr>
                            <th>Sl No.</th>
                            <th>Service</th>
                            <th>Application ID</th>
                            <th>Applicant Name</th>
                            <th>Purpose</th>
                            <th>Date of Application</th>
                            <th>Current Status</th>
                            <th>Time Elapsed (Days)</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int slNo = 1;
                        }
                        @foreach (var app in Model)
                        {
                            var statusUpper = app.Status?.ToUpperInvariant() ?? string.Empty;
                            var stageUpper = app.CurrentStage?.ToUpperInvariant() ?? string.Empty;
                            var statusClass = statusUpper switch
                            {
                                "DRAFT" => "myapps-status-draft",
                                "SUBMITTED" => string.Equals(app.CurrentStage, "Initial Scrutiny", StringComparison.OrdinalIgnoreCase) ? "myapps-status-submitted" : "myapps-status-review",
                                "RETURNEDTOAPPLICANT" => "myapps-status-rejected",
                                "APPROVED" => "myapps-status-approved",
                                "REJECTED" => "myapps-status-rejected",
                                _ => "myapps-status-draft"
                            };
                            var statusText = statusUpper switch
                            {
                                "SUBMITTED" => string.Equals(app.CurrentStage, "Initial Scrutiny", StringComparison.OrdinalIgnoreCase) ? "Submitted" : $"In Progress — {app.CurrentStage}",
                                "RETURNEDTOAPPLICANT" => "Returned for Correction",
                                _ => app.Status
                            };

                            <tr>
                                <td>@slNo</td>
                                <td>@app.Service</td>
                                <td>@(string.IsNullOrEmpty(app.ApplicationId) ? "—" : app.ApplicationId)</td>
                                <td>@(string.IsNullOrEmpty(app.ApplicantName) ? "—" : app.ApplicantName)</td>
                                <td>@(string.IsNullOrEmpty(app.Purpose) ? "—" : app.Purpose)</td>
                                <td>@app.DateOfApplication.ToLocalTime().ToString("dd-MM-yyyy")</td>
                                <td><span class="myapps-status-badge @statusClass">@statusText</span></td>
                                <td>@app.TimeElapsedDays</td>
                                <td>
                                    @if (app.Service == "Fire NOC")
                                    {
                                        <a class="myapps-btn myapps-btn-view" href="@app.ViewUrl">View</a>
                                    }
                                    else if (app.CanContinue)
                                    {
                                        <a class="myapps-btn" href="@Url.Action("Apply", "TradeLicence", new { id = app.InternalId })">Continue</a>
                                    }
                                    else if (app.CanPayNow)
                                    {
                                        <form method="post" asp-action="PayNow" asp-controller="TradeLicence" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@app.InternalId" />
                                            <button type="button" class="myapps-btn btn-pay-now" style="background:#1D6E3E; border:none; cursor:pointer;">
                                                <i class="fas fa-indian-rupee-sign"></i> Pay Now
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a class="myapps-btn myapps-btn-view" href="@app.ViewUrl">View</a>
                                    }
                                </td>
                            </tr>
                            slNo++;
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="~/js/tl_js/tl_status.js" asp-append-version="true"></script>
}
