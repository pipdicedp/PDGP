@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-wrapper">

        <div class="dashboard-body">

            <div class="page-title">
                <h3>Single Sign On Dashboard</h3>
                <p>Manage Trade Licence Applications</p>
            </div>

            <div class="dashboard-cards">

                <div class="dashboard-card">

                    <div class="card-icon">
                        🏢
                    </div>

                    <h4>Trade Licence</h4>

                    <p>
                        Apply for New Trade Licence and Track Application Status
                    </p>

                    <a asp-controller="TradeLicence"
                       asp-action="Index"
                        class="dashboard-btn">
                        New Application
                    </a>

                </div>

                <div class="dashboard-card">

                    <div class="card-icon">
                        💧
                    </div>

                    <h4>Water Management</h4>

                    <p>
                        Apply for New Trade Licence and Track Application Status
                    </p>

                    <a asp-controller="WaterConnection"
                       asp-action="Home"
                       class="dashboard-btn">
                        New Application
                    </a>

                </div>

                <div class="dashboard-card">

                    <div class="card-icon">
                        ⚡
                    </div>

                    <h4>Electricity Management</h4>

                    <p>
                        Apply for New Trade Licence and Track Application Status
                    </p>

                    <a asp-controller="TradeLicence"
                       asp-action="Apply"
                        class="dashboard-btn">
                        New Application
                    </a>

                </div>

                <div class="dashboard-card">

                    <div class="card-icon">
                        🚐
                    </div>

                    <h4>Transport Management</h4>

                    <p>
                        Apply for New Trade Licence and Track Application Status
                    </p>

                    <a asp-controller="TradeLicence"
                       asp-action="Apply"
                       class="dashboard-btn">
                        New Application
                    </a>

                </div>

                <div class="dashboard-card">

                    <div class="card-icon">


                        👷
                    </div>

                    <h4>Labor Department</h4>

                    <p>
                        Apply for New Trade Licence and Track Application Status
                    </p>

                    <a asp-controller="TradeLicence"
                       asp-action="Apply"
                       class="dashboard-btn">
                        New Application
                    </a>

                </div>

                <div class="dashboard-card">

                    <div class="card-icon">
                        📝
                    </div>

                    <h4>Registration Department</h4>

                    <p>
                        Apply for New Trade Licence and Track Application Status
                    </p>

                    <a asp-controller="TradeLicence"
                       asp-action="Apply"
                        class="dashboard-btn">
                        New Application
                    </a>

                </div>

                <div class="dashboard-card">

                    <div class="card-icon">
                        📐
                    </div>

