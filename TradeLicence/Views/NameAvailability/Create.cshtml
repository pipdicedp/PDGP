@model TradeLicence.Models.NameAvailabilityBase
@{
    var entityType = (ViewData["EntityType"] as string) ?? "Society";
    var entityPlural = entityType == "Firm" ? "Firms" : "Societies";
    ViewData["Title"] = $"Name Availability of {entityPlural}";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<style>
    .na-card { max-width: 780px; margin: 20px auto; border: 1px solid #337ab7; border-radius: 4px; background: #fff; }
    .na-header { background: #337ab7; color: #fff; text-align: center; font-weight: 700; padding: 14px; font-size: 14px; }
    .na-body { padding: 30px 40px 40px; font-size: 11px; }
    .na-body label { font-weight: 700; font-size: 11px; display: block; margin-bottom: 6px; }
    .na-body .req { color: #d00; }
    .na-body .form-control { width: 100%; border: 1px solid #2e9e1f; border-radius: 3px; padding: 6px 8px; font-size: 11px; }
    .na-body .form-control:focus { outline: none; box-shadow: 0 0 3px #2e9e1f; }
    .na-body textarea.form-control { height: 62px; resize: vertical; }
    .na-section { font-weight: 700; font-size: 11px; margin: 10px 0 14px; }
    .na-row { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 18px; }
    .na-col { flex: 1 1 200px; min-width: 200px; }
    .na-yn { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; gap: 20px; }
    .na-yn .q { flex: 1; font-weight: 700; font-size: 11px; }
    .na-yn .opts { width: 200px; font-weight: 700; }
    .na-yn .opts input { margin: 0 4px 0 2px; }
    .na-note { text-align: center; font-weight: 700; font-size: 11px; color: #a94442; margin-top: 12px; }
    .na-actions { text-align: center; margin-top: 20px; }
    .btn-save { background: #337ab7; color: #fff; border: none; padding: 9px 34px; border-radius: 3px; font-size: 13px; cursor: pointer; }
    .btn-save:hover { background: #286090; }
    .btn-reset { background: #777; color: #fff; border: none; padding: 9px 26px; border-radius: 3px; font-size: 13px; cursor: pointer; margin-left: 8px; }
    .text-danger { color: #d00; font-size: 10px; }
    .na-alert { background: #dff0d8; border: 1px solid #3c763d; color: #3c763d; padding: 10px 14px; margin-bottom: 18px; border-radius: 3px; font-size: 12px; }
</style>

<div class="na-card">
    <div class="na-header">@ViewData["Title"]</div>

    <div class="na-body">
        @if (TempData["Success"] != null)
        {
            <div class="na-alert">@TempData["Success"]</div>
        }

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="na-section">Proposed Name Of The @entityType:</div>

            <div class="na-row">
                <div class="na-col">
                    <label>Proposed Name <span class="req">*</span></label>
                    <input asp-for="ProposedName1" class="form-control" placeholder="Proposed Name 1" />
                    <span asp-validation-for="ProposedName1" class="text-danger"></span>
                </div>
                <div class="na-col">
                    <label>Proposed Name</label>
                    <input asp-for="ProposedName2" class="form-control" placeholder="Proposed Name 2" />
                </div>
                <div class="na-col">
                    <label>Proposed Name</label>
                    <input asp-for="ProposedName3" class="form-control" placeholder="Proposed Name 3" />
                </div>
            </div>

            <div class="na-row">
                <div class="na-col">
                    <label>Proposed Name</label>
                    <input asp-for="ProposedName4" class="form-control" placeholder="Proposed Name 4" />
                </div>
                <div class="na-col">
                    <label>Proposed Name</label>
                    <input asp-for="ProposedName5" class="form-control" placeholder="Proposed Name 5" />
                </div>
                <div class="na-col"></div>
            </div>

            <div class="na-row">
                <div class="na-col">
                    <label>Objects/Purpose of the @entityType :</label>
                    <textarea asp-for="Purpose" class="form-control" placeholder="Purpose Of The @entityType"></textarea>
                </div>
            </div>

            <div class="na-section" style="margin-top:30px;">Applicant Details :</div>

            <div class="na-row">
                <div class="na-col">
                    <label>Applicant Name <span class="req">*</span></label>
                    <input asp-for="ApplicantName" class="form-control" placeholder="Applicant Name" />
                    <span asp-validation-for="ApplicantName" class="text-danger"></span>
                </div>
                <div class="na-col">
                    <label>Applicant Address <span class="req">*</span></label>
                    <textarea asp-for="ApplicantAddress" class="form-control" placeholder="Applicant Address"></textarea>
                    <span asp-validation-for="ApplicantAddress" class="text-danger"></span>
                </div>
            </div>

            <div class="na-row">
                <div class="na-col">
                    <label>Telephone/Mobile No. <span class="req">*</span></label>
                    <input asp-for="MobileNo" class="form-control" placeholder="Mobile No" maxlength="10" />
                    <span asp-validation-for="MobileNo" class="text-danger"></span>
                </div>
                <div class="na-col">
                    <label>Email Id <span class="req">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="Email Id" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div style="margin-top:34px;">
                <div class="na-yn">
                    <div class="q">Whether the proposed name is in consonance with the objects of the Association/@entityType.</div>
                    <div class="opts">
                        Yes<input type="radio" asp-for="InConsonanceWithObjects" value="true" />
                        No<input type="radio" asp-for="InConsonanceWithObjects" value="false" />
                        <br /><span asp-validation-for="InConsonanceWithObjects" class="text-danger"></span>
                    </div>
                </div>

                <div class="na-yn">
                    <div class="q">Whether NOC is attached if the proposed name resembling the name of govt.authority/reputed organization.</div>
                    <div class="opts">
                        Yes<input type="radio" asp-for="NocAttached" value="true" />
                        No<input type="radio" asp-for="NocAttached" value="false" />
                        <br /><span asp-validation-for="NocAttached" class="text-danger"></span>
                    </div>
                </div>

                <div class="na-yn">
                    <div class="q">Whether the name is in accordance with the provision of Emblems and Names(Prevention of improper use)Act,1950:.</div>
                    <div class="opts">
                        Yes<input type="radio" asp-for="EmblemsActCompliant" value="true" />
                        No<input type="radio" asp-for="EmblemsActCompliant" value="false" />
                        <br /><span asp-validation-for="EmblemsActCompliant" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="na-row" style="margin-top:30px;">
                <div class="na-col">
                    <label>Self attested copy of Identity Proof <span class="req">*</span></label>
                    <input asp-for="IdentityProofFile" type="file" accept=".pdf" />
                    <br /><span asp-validation-for="IdentityProofFile" class="text-danger"></span>
                </div>
                <div class="na-col">
                    <label>Self attested copy of Signature Proof(PAN card/driving licence/TC/Mark Sheet) <span class="req">*</span></label>
                    <input asp-for="SignatureProofFile" type="file" accept=".pdf" />
                    <br /><span asp-validation-for="SignatureProofFile" class="text-danger"></span>
                </div>
            </div>

            <div class="na-row">
                <div class="na-col">
                    <label>NOC from the concerned authority(Govt/Reputed organization)</label>
                    <input asp-for="NocFile" type="file" accept=".pdf" />
                    <br /><span asp-validation-for="NocFile" class="text-danger"></span>
                </div>
            </div>

            <div class="na-note">Note: Only allowed PDF file and Maximum size of uploading file is 1MB</div>

            <div class="na-actions">
                <button type="submit" class="btn-save">Save</button>
                <button type="reset" class="btn-reset">Reset</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
