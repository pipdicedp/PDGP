@model IEnumerable<TradeLicence.Models.NameAvailabilityBase>
@{
    var entityType = (ViewData["EntityType"] as string) ?? "Society";
    var entityPlural = entityType == "Firm" ? "Firms" : "Societies";
    ViewData["Title"] = $"Name Availability of {entityPlural}";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var rows = Model?.ToList() ?? new List<TradeLicence.Models.NameAvailabilityBase>();
    var newAction = entityType == "Firm" ? "NameAvailabilityFirm" : "NameAvailability";
}

<style>
    .na-list-card { max-width: 1250px; margin: 20px auto; border: 1px solid #337ab7; border-radius: 4px; background: #fff; }
    .na-list-header { background: #337ab7; color: #fff; text-align: center; font-weight: 700; padding: 14px; font-size: 14px; }
    .na-list-body { padding: 20px 22px 28px; font-size: 11px; }
    .na-list-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
    .na-list-toolbar .count { font-weight: 700; color: #555; font-size: 12px; }
    .na-btn { display: inline-block; background: #337ab7; color: #fff; border: none; padding: 8px 18px; border-radius: 3px; font-size: 12px; text-decoration: none; cursor: pointer; }
    .na-btn:hover { background: #286090; color: #fff; text-decoration: none; }
    .na-btn.secondary { background: #777; }
    .na-btn.secondary:hover { background: #5f5f5f; }
    .na-table-wrap { overflow-x: auto; border: 1px solid #ddd; border-radius: 3px; }
    .na-table { width: 100%; border-collapse: collapse; font-size: 11px; min-width: 1050px; }
    .na-table th { background: #eef4fa; color: #1f4e79; text-align: left; padding: 9px 8px; border-bottom: 2px solid #337ab7; white-space: nowrap; font-size: 11px; }
    .na-table td { padding: 8px; border-bottom: 1px solid #e6e6e6; vertical-align: top; }
    .na-table tbody tr:nth-child(even) { background: #fafcfe; }
    .na-table tbody tr:hover { background: #eef7ff; }
    .na-table .names span { display: block; }
    .na-table .yes { color: #2e7d32; font-weight: 700; }
    .na-table .no { color: #c62828; font-weight: 700; }
    .na-table a.doc { display: inline-block; margin: 0 6px 2px 0; color: #337ab7; text-decoration: underline; white-space: nowrap; }
    .na-empty { text-align: center; padding: 40px 10px; color: #777; font-size: 12px; }
</style>

<div class="na-list-card">
    <div class="na-list-header">Name Availability of @entityPlural ΓÇö Submitted Requests</div>

    <div class="na-list-body">
        <div class="na-list-toolbar">
            <span class="count">Total requests: @rows.Count</span>
            <div>
                <a asp-controller="@newAction" asp-action="Create" class="na-btn">New Application</a>
                <a asp-controller="Dashboard" asp-action="Index" class="na-btn secondary">Back to Dashboard</a>
            </div>
        </div>

        @if (rows.Count == 0)
        {
            <div class="na-empty">No @(entityType.ToLower()) name availability requests found yet.</div>
        }
        else
        {
            <div class="na-table-wrap">
                <table class="na-table">
                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Ref. No</th>
                            <th>Proposed Name(s)</th>
                            <th>Purpose</th>
                            <th>Applicant Name</th>
                            <th>Mobile No</th>
                            <th>Email Id</th>
                            <th>In Consonance with Objects</th>
                            <th>NOC Attached</th>
                            <th>Emblems Act Compliant</th>
                            <th>Documents</th>
                            <th>Submitted On</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 1; }
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@row.Id</td>
                                <td class="names">
                                    @if (!string.IsNullOrWhiteSpace(row.ProposedName1)) { <span>1. @row.ProposedName1</span> }
                                    @if (!string.IsNullOrWhiteSpace(row.ProposedName2)) { <span>2. @row.ProposedName2</span> }
                                    @if (!string.IsNullOrWhiteSpace(row.ProposedName3)) { <span>3. @row.ProposedName3</span> }
                                    @if (!string.IsNullOrWhiteSpace(row.ProposedName4)) { <span>4. @row.ProposedName4</span> }
                                    @if (!string.IsNullOrWhiteSpace(row.ProposedName5)) { <span>5. @row.ProposedName5</span> }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(row.Purpose) ? "-" : row.Purpose)</td>
                                <td>@row.ApplicantName</td>
                                <td>@row.MobileNo</td>
                                <td>@row.Email</td>
                                <td>@(row.InConsonanceWithObjects == true ? "Yes" : "No")</td>
                                <td>@(row.NocAttached == true ? "Yes" : "No")</td>
                                <td>@(row.EmblemsActCompliant == true ? "Yes" : "No")</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(row.IdentityProofPath))
                                    {
                                        <a class="doc" href="@row.IdentityProofPath" target="_blank">Identity Proof</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.SignatureProofPath))
                                    {
                                        <a class="doc" href="@row.SignatureProofPath" target="_blank">Signature Proof</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(row.NocPath))
                                    {
                                        <a class="doc" href="@row.NocPath" target="_blank">NOC</a>
                                    }
                                    @if (string.IsNullOrWhiteSpace(row.IdentityProofPath) && string.IsNullOrWhiteSpace(row.SignatureProofPath) && string.IsNullOrWhiteSpace(row.NocPath))
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td style="white-space:nowrap;">@row.CreatedOn.ToString("dd-MM-yyyy HH:mm")</td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
