@model TradeLicence.Models.OfficerLoginViewModel
@{
    ViewData["Title"] = "Official Login";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap">
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="tl-lx-page">
    <div class="tl-lx-stage">

        <!-- ===== LEFT: welcome + quick links ===== -->
        <section class="tl-lx-intro">
            <span class="tl-lx-eyebrow"><i class="fa-solid fa-landmark"></i> Government of Puducherry</span>
            <h2 class="tl-lx-hero-title">Department <span>Officials</span></h2>
            <p class="tl-lx-hero-text">Restricted access for department officials &mdash; process, verify and approve investor applications and trade licences online.</p>

            <ul class="tl-lx-chips">
                <li><i class="fa-solid fa-circle-check"></i> Application Processing</li>
                <li><i class="fa-solid fa-circle-check"></i> Verification &amp; Inspection</li>
                <li><i class="fa-solid fa-circle-check"></i> Approval Workflow</li>
            </ul>

            <div class="tl-lx-services">
                <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-inbox"></i></span><span class="tl-lx-service-title">Pending Applications</span></a>
                <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-file-circle-check"></i></span><span class="tl-lx-service-title">Document Verification</span></a>
                <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-clipboard-check"></i></span><span class="tl-lx-service-title">Field Inspection</span></a>
                <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-stamp"></i></span><span class="tl-lx-service-title">Approval &amp; Rejection</span></a>
                <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-certificate"></i></span><span class="tl-lx-service-title">Certificate Issue</span></a>
                <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-chart-column"></i></span><span class="tl-lx-service-title">Officer Dashboard</span></a>
            </div>
        </section>

        <!-- ===== RIGHT: official login card ===== -->
        <div class="tl-lx-card">
            <div class="tl-lx-card-body">
                <div class="tl-lx-form">

                    <div class="tl-lx-brand">
                        <img src="@Url.Content("~/Images/Puducherry Logo.jpg")" alt="Puducherry Logo" class="tl-lx-logo" />
                        <div>
                            <div class="tl-lx-brand-title">Official Login</div>
                            <div class="tl-lx-brand-sub">Government of Puducherry</div>
                        </div>
                    </div>

                    <h1 class="tl-lx-heading">Welcome, Officer</h1>
                    <p class="tl-lx-sub">For authorized department staff only. Log in to manage applications.</p>

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                    {
                        <div class="tl-lx-alert">
                            @foreach (var err in ViewData.ModelState[string.Empty].Errors)
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-controller="Account" asp-action="OfficerLogin" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="tl-lx-field">
                            <label asp-for="Username">User Name</label>
                            <div class="tl-lx-inputwrap">
                                <i class="fa-solid fa-user tl-lx-inputicon"></i>
                                <input asp-for="Username" class="tl-lx-input" placeholder="Enter your user name" autocomplete="username" maxlength="25" autofocus />
                            </div>
                            <span asp-validation-for="Username" class="tl-lx-error"></span>
                        </div>

                        <div class="tl-lx-field">
                            <label asp-for="Password">Password</label>
                            <div class="tl-lx-inputwrap tl-lx-pw">
                                <i class="fa-solid fa-lock tl-lx-inputicon"></i>
                                <input asp-for="Password" type="password" id="officerPasswordInput" class="tl-lx-input" placeholder="Enter your password" autocomplete="current-password" maxlength="15" />
                                <button type="button" id="officerTogglePassword" class="tl-lx-eye" aria-label="Show password">👁</button>
                            </div>
                            <span asp-validation-for="Password" class="tl-lx-error"></span>
                        </div>

                        <div class="tl-lx-field">
                            <label>Captcha Verification</label>
                            <div class="tl-lx-captcha-row">
                                <img id="officerCaptchaImg" src="@Url.Action("CaptchaImage", "Account")" alt="Captcha code" class="tl-lx-captcha-img" />
                                <button type="button" id="officerRefreshCaptcha" class="tl-lx-captcha-refresh" title="Get a new code" aria-label="Refresh captcha">⟳</button>
                            </div>
                            <div class="tl-lx-inputwrap">
                                <i class="fa-solid fa-shield-halved tl-lx-inputicon"></i>
                                <input asp-for="CaptchaInput" class="tl-lx-input" placeholder="Enter the code shown above" autocomplete="off" maxlength="6" />
                            </div>
                            <span asp-validation-for="CaptchaInput" class="tl-lx-error"></span>
                        </div>

                        <button type="submit" class="tl-lx-submit">Login <i class="fa-solid fa-arrow-right-to-bracket"></i></button>

                        <div class="tl-lx-divider"><span>Not a department official?</span></div>

                        <a href="@Url.Action("Login", "Account")" class="tl-lx-register">
                            <i class="fa-solid fa-user"></i> Citizen Login
                        </a>

                        <p class="tl-lx-secure"><i class="fa-solid fa-lock"></i> Protected by captcha verification</p>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('officerTogglePassword').addEventListener('click', function() {
            const input = document.getElementById('officerPasswordInput');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            this.textContent = isHidden ? '🙈' : '👁';
            this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        });

        document.getElementById('officerRefreshCaptcha').addEventListener('click', function() {
            const img = document.getElementById('officerCaptchaImg');
            img.src = '@Url.Action("CaptchaImage", "Account")?t=' + Date.now();
        });
    </script>
}
