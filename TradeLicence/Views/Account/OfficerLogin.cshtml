@model TradeLicence.Models.OfficerLoginViewModel
@{
    ViewData["Title"] = "Official Login";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="tl-lx-page">
    <div class="tl-lx2-shell">

        <!-- ===== LEFT: photo hero + services ===== -->
        <aside class="tl-lx2-photo">
            <div class="tl-lx2-photo-bg"></div>

            <div class="tl-lx2-crest">
                <img src="@Url.Content("~/Images/Puducherry Logo.jpg")" alt="Puducherry Logo" class="tl-lx2-crest-img" />
                <div>
                    <div class="tl-lx2-crest-govt">Government of Puducherry</div>
                    <div class="tl-lx2-crest-dept">Department of Industries &amp; Commerce</div>
                </div>
            </div>

            <div class="tl-lx2-hero">
                <span class="tl-lx2-eyebrow"><i class="fa-solid fa-landmark"></i> Official Access</span>
                <h1 class="tl-lx2-hero-title">Department <em>Officials</em></h1>
                <p class="tl-lx2-hero-text">Restricted access for department officials &mdash; process, verify and approve investor applications and trade licences online.</p>

                <div class="tl-lx2-points">
                    <span><i class="fa-solid fa-circle-check"></i> Application Processing</span>
                    <span><i class="fa-solid fa-circle-check"></i> Verification &amp; Inspection</span>
                    <span><i class="fa-solid fa-circle-check"></i> Approval Workflow</span>
                </div>

                <div class="tl-lx2-services">
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-inbox"></i></span><span class="tl-lx2-service-title">Pending Applications</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-file-circle-check"></i></span><span class="tl-lx2-service-title">Document Verification</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-clipboard-check"></i></span><span class="tl-lx2-service-title">Field Inspection</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-stamp"></i></span><span class="tl-lx2-service-title">Approval &amp; Rejection</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-certificate"></i></span><span class="tl-lx2-service-title">Certificate Issue</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-chart-column"></i></span><span class="tl-lx2-service-title">Officer Dashboard</span></a>
                </div>
            </div>

            <div class="tl-lx2-footline">
                <span><i class="fa-solid fa-shield-halved"></i> Role-based access</span>
                <span><i class="fa-solid fa-lock"></i> Session audit trail</span>
                <span><i class="fa-solid fa-headset"></i> 24&times;7 Helpdesk</span>
            </div>
        </aside>

        <!-- ===== RIGHT: official login card ===== -->
        <main class="tl-lx2-form-side">
            <div class="tl-lx2-card">
                <div class="tl-lx2-signin-label">Official Access</div>
                <h1 class="tl-lx2-heading">Welcome, Officer</h1>
                <p class="tl-lx2-sub">For authorized department staff only. Log in to manage applications.</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="tl-lx2-alert">
                        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="OfficerLogin" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="tl-lx2-field">
                        <label asp-for="Username">User Name</label>
                        <div class="tl-lx2-control">
                            <i class="fa-solid fa-user-tie"></i>
                            <input asp-for="Username" class="tl-lx2-input" placeholder="Enter your user name" autocomplete="username" maxlength="25" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="tl-lx2-error"></span>
                    </div>

                    <div class="tl-lx2-field">
                        <label asp-for="Password">Password</label>
                        <div class="tl-lx2-control tl-lx2-pw">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Password" type="password" id="officerPasswordInput" class="tl-lx2-input" placeholder="Enter your password" autocomplete="current-password" maxlength="15" />
                            <button type="button" id="officerTogglePassword" class="tl-lx2-eye" aria-label="Show password"><i id="officerTogglePasswordIcon" class="fa-regular fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="tl-lx2-error"></span>
                    </div>

                    <div class="tl-lx2-field">
                        <label>Captcha Verification</label>
                        <div class="tl-lx2-captcha-row">
                            <img id="officerCaptchaImg" src="@Url.Action("CaptchaImage", "Account")" alt="Captcha code" class="tl-lx2-captcha-img" />
                            <button type="button" id="officerRefreshCaptcha" class="tl-lx2-captcha-refresh" title="Get a new code" aria-label="Refresh captcha"><i class="fa-solid fa-rotate-right"></i></button>
                        </div>
                        <div class="tl-lx2-control">
                            <i class="fa-solid fa-shield-halved"></i>
                            <input asp-for="CaptchaInput" class="tl-lx2-input" placeholder="Enter the code shown above" autocomplete="off" maxlength="6" />
                        </div>
                        <span asp-validation-for="CaptchaInput" class="tl-lx2-error"></span>
                    </div>

                    <button type="submit" class="tl-lx2-submit">Login <i class="fa-solid fa-arrow-right-to-bracket"></i></button>

                    <div class="tl-lx2-forgot">
                        <a href="@Url.Action("ForgotPassword", "Account")">Forgot password?</a>
                    </div>

                    <div class="tl-lx2-divider"><span>Not a department official?</span></div>

                    <a href="@Url.Action("Login", "Account")" class="tl-lx2-register">
                        <i class="fa-solid fa-user"></i> Citizen Login
                    </a>

                    <p class="tl-lx2-secure"><i class="fa-solid fa-lock"></i> Protected by captcha verification</p>
                </form>
            </div>
        </main>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('officerTogglePassword').addEventListener('click', function () {
            const input = document.getElementById('officerPasswordInput');
            const icon = document.getElementById('officerTogglePasswordIcon');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            if (icon) {
                icon.className = isHidden ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
            }
            this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        });

        document.getElementById('officerRefreshCaptcha').addEventListener('click', function () {
            const img = document.getElementById('officerCaptchaImg');
            img.src = '@Url.Action("CaptchaImage", "Account")?t=' + Date.now();
        });
    </script>
}