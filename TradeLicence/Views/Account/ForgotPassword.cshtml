@model TradeLicence.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    int stage = ViewData["FpStage"] is int st ? st : 1;
    bool hasSummaryError = !ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0;
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Public+Sans:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="fp-page">
    <div class="fp-card">

        <div class="fp-head">
            <span class="fp-head-icon"><i class="fa-solid fa-key"></i></span>
            <div>
                <h2>Forgot Password / Reset Password</h2>
                <small>Investor Portal &middot; Government of Puducherry</small>
            </div>
        </div>

        <div class="fp-body">

            @* ---------- progress ---------- *@
            <div class="fp-steps">
                <div class="fp-step @(stage == 1 ? "active" : "done")"><span>1</span> Verify your details</div>
                <div class="fp-step-line"></div>
                <div class="fp-step @(stage == 2 ? "active" : "")"><span>2</span> OTP &amp; new password</div>
            </div>

            @if (TempData["FpExpired"] != null)
            {
                <div class="fp-alert fp-alert-error">@TempData["FpExpired"]</div>
            }

            @if (hasSummaryError)
            {
                <div class="fp-alert fp-alert-error">
                    @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            @if (stage == 2 && ViewBag.FpInfo != null)
            {
                <div class="fp-alert fp-alert-ok"><i class="fa-solid fa-circle-check"></i> @ViewBag.FpInfo</div>
            }

            @* ================= STEP 1 : who are you ================= *@
            <form asp-controller="Account" asp-action="ForgotPasswordSend" method="post" novalidate>
                <div class="fp-section"><span>1</span> Registered details</div>

                <div class="fp-grid">
                    <div class="fp-field">
                        <label asp-for="Username">User Name <b>*</b></label>
                        <div class="fp-inputwrap">
                            <i class="fa-solid fa-user"></i>
                            @if (stage == 1)
                            {
                                <input asp-for="Username" class="fp-input" maxlength="25" autocomplete="off" placeholder="Your user name" />
                            }
                            else
                            {
                                <div class="fp-input fp-static">@Model.Username</div>
                            }
                        </div>
                        <span asp-validation-for="Username" class="fp-error"></span>
                    </div>

                    <div class="fp-field">
                        <label asp-for="MobileNumber">Mobile No <b>*</b></label>
                        <div class="fp-inputwrap">
                            <i class="fa-solid fa-mobile-screen"></i>
                            @if (stage == 1)
                            {
                                <input asp-for="MobileNumber" class="fp-input" maxlength="10" inputmode="numeric" autocomplete="off" placeholder="Registered 10-digit mobile" />
                            }
                            else
                            {
                                <div class="fp-input fp-static">@Model.MobileNumber</div>
                            }
                        </div>
                        <span asp-validation-for="MobileNumber" class="fp-error"></span>
                    </div>

                    <div class="fp-field fp-full">
                        <label asp-for="Email">Email Id <b>*</b></label>
                        <div class="fp-inputwrap">
                            <i class="fa-solid fa-envelope"></i>
                            @if (stage == 1)
                            {
                                <input asp-for="Email" type="email" class="fp-input" maxlength="150" autocomplete="off" placeholder="Registered email address" />
                            }
                            else
                            {
                                <div class="fp-input fp-static">@Model.Email</div>
                            }
                        </div>
                        <span asp-validation-for="Email" class="fp-error"></span>
                    </div>

                    @if (stage == 1)
                    {
                        <div class="fp-field fp-full">
                            <label>Captcha <b>*</b></label>
                            <div class="fp-captcha-row">
                                <img id="captchaImg" src="@Url.Action("CaptchaImage", "Account")" alt="Captcha code" class="fp-captcha-img" />
                                <button type="button" id="refreshCaptcha" class="fp-captcha-refresh" title="Get a new code" aria-label="Refresh captcha">⟳</button>
                                <div class="fp-inputwrap fp-captcha-input">
                                    <i class="fa-solid fa-shield-halved"></i>
                                    <input asp-for="CaptchaInput" class="fp-input" maxlength="6" autocomplete="off" placeholder="Enter captcha code" />
                                </div>
                            </div>
                            <span asp-validation-for="CaptchaInput" class="fp-error"></span>
                        </div>
                    }
                </div>

                @if (stage == 1)
                {
                    <button type="submit" class="fp-btn fp-btn-primary"><i class="fa-solid fa-paper-plane"></i> Send OTP</button>
                }
                else
                {
                    <a asp-action="ForgotPassword" class="fp-link"><i class="fa-solid fa-rotate-left"></i> Start again with different details</a>
                }
            </form>

            @* ================= STEP 2 : OTP + new password ================= *@
            <form asp-controller="Account" asp-action="ForgotPasswordReset" method="post" novalidate class="fp-form2">
                <fieldset disabled="@(stage == 1)" class="fp-fieldset">
                    <div class="fp-section"><span>2</span> OTP &amp; new password</div>
                    @if (stage == 1)
                    {
                        <div class="fp-hint">This part unlocks after the OTP is sent to your registered mobile and email.</div>
                    }

                    <div class="fp-grid">
                        <div class="fp-field">
                            <label asp-for="MobileOtp">Mobile OTP <b>*</b></label>
                            <div class="fp-inputwrap">
                                <i class="fa-solid fa-mobile-screen-button"></i>
                                <input asp-for="MobileOtp" class="fp-input fp-otp" maxlength="6" inputmode="numeric" autocomplete="off" placeholder="6-digit OTP" />
                            </div>
                            <span asp-validation-for="MobileOtp" class="fp-error"></span>
                        </div>

                        <div class="fp-field">
                            <label asp-for="EmailOtp">Email OTP <b>*</b></label>
                            <div class="fp-inputwrap">
                                <i class="fa-solid fa-envelope-circle-check"></i>
                                <input asp-for="EmailOtp" class="fp-input fp-otp" maxlength="6" inputmode="numeric" autocomplete="off" placeholder="6-digit OTP" />
                            </div>
                            <span asp-validation-for="EmailOtp" class="fp-error"></span>
                        </div>

                        <div class="fp-field">
                            <label asp-for="NewPassword">New Password <b>*</b></label>
                            <div class="fp-inputwrap">
                                <i class="fa-solid fa-lock"></i>
                                <input asp-for="NewPassword" type="password" class="fp-input" maxlength="15" autocomplete="new-password" placeholder="6 to 15 characters" />
                                <button type="button" class="fp-eye" data-toggle-pass="NewPassword" aria-label="Show password">👁</button>
                            </div>
                            <div class="fp-meter"><div id="fpBar"></div></div>
                            <small id="fpStrength" class="fp-muted">Use 6-15 characters. Mix letters, numbers &amp; symbols.</small>
                            <span asp-validation-for="NewPassword" class="fp-error"></span>
                        </div>

                        <div class="fp-field">
                            <label asp-for="ConfirmPassword">Confirm Password <b>*</b></label>
                            <div class="fp-inputwrap">
                                <i class="fa-solid fa-shield-halved"></i>
                                <input asp-for="ConfirmPassword" type="password" class="fp-input" maxlength="15" autocomplete="new-password" placeholder="Re-enter new password" />
                                <button type="button" class="fp-eye" data-toggle-pass="ConfirmPassword" aria-label="Show password">👁</button>
                            </div>
                            <small id="fpMatch" class="fp-muted"></small>
                            <span asp-validation-for="ConfirmPassword" class="fp-error"></span>
                        </div>
                    </div>

                    <button type="submit" class="fp-btn fp-btn-success"><i class="fa-solid fa-circle-check"></i> Update Password</button>
                </fieldset>
            </form>

            <div class="fp-back">
                <a asp-action="Login"><i class="fa-solid fa-arrow-left"></i> Back to Login</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // refresh captcha picture
            var refresh = document.getElementById('refreshCaptcha');
            if (refresh) refresh.addEventListener('click', function () {
                document.getElementById('captchaImg').src = '@Url.Action("CaptchaImage", "Account")?t=' + Date.now();
            });

            // mobile + OTP boxes: digits only
            function digitsOnly(el) { if (el) el.addEventListener('input', function () { el.value = el.value.replace(/\D/g, ''); }); }
            digitsOnly(document.getElementById('MobileNumber'));
            document.querySelectorAll('.fp-otp').forEach(digitsOnly);

            // show / hide password
            document.querySelectorAll('[data-toggle-pass]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.getAttribute('data-toggle-pass'));
                    var hidden = input.type === 'password';
                    input.type = hidden ? 'text' : 'password';
                    btn.textContent = hidden ? '🙈' : '👁';
                });
            });

            // password strength + match hint
            var pw = document.getElementById('NewPassword'), cpw = document.getElementById('ConfirmPassword');
            var bar = document.getElementById('fpBar'), txt = document.getElementById('fpStrength'), match = document.getElementById('fpMatch');
            function strength() {
                var v = pw.value, score = 0;
                if (v.length >= 6) score++;
                if (v.length >= 10) score++;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) score++;
                if (/\d/.test(v)) score++;
                if (/[^A-Za-z0-9]/.test(v)) score++;
                var lv = [['0%', '#e5e7eb', 'Use 6-15 characters. Mix letters, numbers & symbols.'],
                          ['25%', '#dc3545', 'Weak'], ['50%', '#fd7e14', 'Fair'], ['75%', '#d4a017', 'Good'], ['100%', '#1b7f3b', 'Strong']];
                var l = v ? lv[Math.min(score, 4) || 1] : lv[0];
                bar.style.width = l[0]; bar.style.background = l[1]; txt.textContent = l[2];
            }
            function same() {
                if (!cpw.value) { match.textContent = ''; return; }
                var ok = cpw.value === pw.value;
                match.textContent = ok ? '✔ Passwords match' : '✖ Passwords do not match';
                match.style.color = ok ? '#1b7f3b' : '#B3261E';
            }
            if (pw && cpw) {
                pw.addEventListener('input', function () { strength(); same(); });
                cpw.addEventListener('input', same);
            }

            // stop double clicks
            document.querySelectorAll('.fp-page form').forEach(function (f) {
                f.addEventListener('submit', function () {
                    var b = f.querySelector('button[type=submit]');
                    if (b) { setTimeout(function () { b.disabled = true; }, 0); }
                });
            });
        })();
    </script>
}
