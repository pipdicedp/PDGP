@model TradeLicence.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap">
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="tl-lx-page">
    <div class="tl-lx2-shell">

        <!-- ===== LEFT: photo hero + services ===== -->
        <aside class="tl-lx2-photo">
            <div class="tl-lx2-photo-bg"></div>

            <div class="tl-lx2-crest">
                <img src="@Url.Content("~/Images/Puducherry Logo.jpg")" alt="Puducherry Logo" class="tl-lx2-crest-img" />
                <div>
                    <div class="tl-lx2-crest-govt">Government of Puducherry</div>
                    <div class="tl-lx2-crest-dept">Department of Industries &amp; Commerce</div>
                </div>
            </div>

            <div class="tl-lx2-hero">
                <span class="tl-lx2-eyebrow"><i class="fa-solid fa-landmark"></i> Investor Portal</span>
                <h1 class="tl-lx2-hero-title">Invest in <em>Puducherry</em></h1>
                <p class="tl-lx2-hero-text">A single platform for entrepreneurs &mdash; apply, track and manage your Puducherry investment approvals online.</p>

                <div class="tl-lx2-points">
                    <span><i class="fa-solid fa-circle-check"></i> Single Window System</span>
                    <span><i class="fa-solid fa-circle-check"></i> Online Application &amp; Status Tracking</span>
                    <span><i class="fa-solid fa-circle-check"></i> Download Final Certificate</span>
                </div>

                <div class="tl-lx2-services">
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-clipboard-list"></i></span><span class="tl-lx2-service-title">Services Enrolled</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-fire-extinguisher"></i></span><span class="tl-lx2-service-title">Empaneled Agency for Third Party Fire Safety Audit</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-scroll"></i></span><span class="tl-lx2-service-title">G.O/Timeline/Orders/Citizen Charter</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-scale-balanced"></i></span><span class="tl-lx2-service-title">Acts &amp; Rules</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-magnifying-glass"></i></span><span class="tl-lx2-service-title">Know Your Approvals</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-bullseye"></i></span><span class="tl-lx2-service-title">Schemes</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-map-location-dot"></i></span><span class="tl-lx2-service-title">Land Bank</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-industry"></i></span><span class="tl-lx2-service-title">Focus Sectors</span></a>
                    <a class="tl-lx2-service"><span class="tl-lx2-service-icon"><i class="fa-solid fa-indian-rupee-sign"></i></span><span class="tl-lx2-service-title">The Rates and Tariff Levied by the State</span></a>
                </div>
            </div>

            <div class="tl-lx2-footline">
                <span><i class="fa-solid fa-shield-halved"></i> Secured by NIC</span>
                <span><i class="fa-solid fa-lock"></i> HTTPS Encrypted</span>
                <span><i class="fa-solid fa-headset"></i> 24&times;7 Helpdesk</span>
            </div>
        </aside>

        <!-- ===== RIGHT: login card ===== -->
        <main class="tl-lx2-form-side">
            <div class="tl-lx2-card">
                <div class="tl-lx2-signin-label">Secure Sign-in</div>
                <h1 class="tl-lx2-heading">Welcome back</h1>
                <p class="tl-lx2-sub">Sign in with your investor portal credentials to continue.</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="tl-lx2-alert">
                        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="tl-lx2-field">
                        <label asp-for="Username">User Name</label>
                        <div class="tl-lx2-control">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="Username" class="tl-lx2-input" placeholder="Enter your user name" autocomplete="username" maxlength="25" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="tl-lx2-error"></span>
                    </div>

                    <div class="tl-lx2-field">
                        <label asp-for="Password">Password</label>
                        <div class="tl-lx2-control tl-lx2-pw">
                            <i class="fa-solid fa-lock"></i>
                            <input asp-for="Password" type="password" id="passwordInput" class="tl-lx2-input" placeholder="Enter your password" autocomplete="current-password" maxlength="15" />
                            <button type="button" id="togglePassword" class="tl-lx2-eye" aria-label="Show password"><i id="togglePasswordIcon" class="fa-regular fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="tl-lx2-error"></span>
                    </div>

                    <div class="tl-lx2-field">
                        <label>Captcha Verification</label>
                        <div class="tl-lx2-captcha-row">
                            <img id="captchaImg" src="@Url.Action("CaptchaImage", "Account")" alt="Captcha code" class="tl-lx2-captcha-img" />
                            <button type="button" id="refreshCaptcha" class="tl-lx2-captcha-refresh" title="Get a new code" aria-label="Refresh captcha"><i class="fa-solid fa-rotate-right"></i></button>
                        </div>
                        <div class="tl-lx2-control">
                            <i class="fa-solid fa-shield-halved"></i>
                            <input asp-for="CaptchaInput" class="tl-lx2-input" placeholder="Enter the code shown above" autocomplete="off" maxlength="6" />
                        </div>
                        <span asp-validation-for="CaptchaInput" class="tl-lx2-error"></span>
                    </div>

                    <button type="submit" class="tl-lx2-submit">Login <i class="fa-solid fa-arrow-right-to-bracket"></i></button>

                    <div class="tl-lx2-forgot">
                        <a href="@Url.Action("ForgotPassword", "Account")">Forgot password?</a>
                    </div>

                    <div class="tl-lx2-divider"><span>New to the portal?</span></div>

                    <a href="#" data-bs-toggle="modal" data-bs-target="#registerModal" class="tl-lx2-register">
                        <i class="fa-solid fa-user-plus"></i> New User? Register Here
                    </a>

                    <p class="tl-lx2-secure"><i class="fa-solid fa-lock"></i> Protected by captcha verification</p>
                </form>
            </div>
        </main>

    </div>

    <partial name="_RegisterModal" model="(TradeLicence.Models.RegisterViewModel)(ViewBag.RegisterModel ?? new TradeLicence.Models.RegisterViewModel())" />

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register-validate.js" asp-append-version="true"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('togglePasswordIcon');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            if (icon) {
                icon.className = isHidden ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
            }
            this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        });

        document.getElementById('refreshCaptcha').addEventListener('click', function () {
            const img = document.getElementById('captchaImg');
            img.src = '@Url.Action("CaptchaImage", "Account")?t=' + Date.now();
        });

        @if (TempData["RegisterSuccess"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'User Registered Successfully!',
                    text: @Html.Raw(Json.Serialize(TempData["RegisterSuccess"])),
                    confirmButtonColor: '#1a3a52'
                });
            </text>
        }

        @if (ViewBag.ShowRegisterModal == true)
        {
            <text>
                document.addEventListener('DOMContentLoaded', function () {
                    var modalEl = document.getElementById('registerModal');
                    if (modalEl && window.bootstrap) {
                        new bootstrap.Modal(modalEl).show();
                    }
                });
            </text>
        }
    </script>
}