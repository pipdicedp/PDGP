@model TradeLicence.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

@section Styles {
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,600;8..60,700&family=Public+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap">
    <link rel="stylesheet" href="~/css/login.css" />
}

<div class="tl-lx-page">
  <div class="tl-lx-stage">

    <!-- ===== LEFT: welcome + quick services ===== -->
    <section class="tl-lx-intro">
        <span class="tl-lx-eyebrow"><i class="fa-solid fa-landmark"></i> Government of Puducherry</span>
        <h2 class="tl-lx-hero-title">Invest in <span>Puducherry</span></h2>
        <p class="tl-lx-hero-text">A single platform for entrepreneurs &mdash; apply, track and manage your Puducherry investment approvals online.</p>

        <ul class="tl-lx-chips">
            <li><i class="fa-solid fa-circle-check"></i> Single Window System</li>
            <li><i class="fa-solid fa-circle-check"></i> Online Application &amp; Status Tracking</li>
            <li><i class="fa-solid fa-circle-check"></i> Download Final Certificate</li>
        </ul>

        <div class="tl-lx-services">
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-clipboard-list"></i></span><span class="tl-lx-service-title">Services Enrolled</span></a>
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-fire-extinguisher"></i></span><span class="tl-lx-service-title">Empaneled Agency for Third Party Fire Safety Audit</span></a>
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-scroll"></i></span><span class="tl-lx-service-title">G.O/Timeline/Orders/Citizen Charter</span></a>
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-scale-balanced"></i></span><span class="tl-lx-service-title">Acts &amp; Rules</span></a>
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-magnifying-glass"></i></span><span class="tl-lx-service-title">Know Your Approvals</span></a>
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-bullseye"></i></span><span class="tl-lx-service-title">Schemes</span></a>
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-map-location-dot"></i></span><span class="tl-lx-service-title">Land Bank</span></a>
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-industry"></i></span><span class="tl-lx-service-title">Focus Sectors</span></a>
            <a class="tl-lx-service"><span class="tl-lx-service-icon"><i class="fa-solid fa-indian-rupee-sign"></i></span><span class="tl-lx-service-title">The Rates and Tariff Levied by the State</span></a>
        </div>
    </section>

    <!-- ===== RIGHT: login card ===== -->
    <div class="tl-lx-card">
        <div class="tl-lx-card-body">
            <div class="tl-lx-form">

                <div class="tl-lx-brand">
                    <img src="@Url.Content("~/Images/Puducherry Logo.jpg")" alt="Puducherry Logo" class="tl-lx-logo" />
                    <div>
                        <div class="tl-lx-brand-title">Investor Portal</div>
                        <div class="tl-lx-brand-sub">Government of Puducherry</div>
                    </div>
                </div>

                <h1 class="tl-lx-heading">Welcome back</h1>
                <p class="tl-lx-sub">Log in to access your trade licence applications and status.</p>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="tl-lx-alert">
                        @foreach (var err in ViewData.ModelState[string.Empty].Errors)
                        {
                            <div>@err.ErrorMessage</div>
                        }
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                     
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="tl-lx-field">
                        <label asp-for="Username">User Name</label>
                        <div class="tl-lx-inputwrap">
                            <i class="fa-solid fa-user tl-lx-inputicon"></i>
                            <input asp-for="Username" class="tl-lx-input" placeholder="Enter your user name" autocomplete="username" maxlength="25" autofocus />
                        </div>
                        <span asp-validation-for="Username" class="tl-lx-error"></span>
                    </div>

                    <div class="tl-lx-field">
                        <label asp-for="Password">Password</label>
                        <div class="tl-lx-inputwrap tl-lx-pw">
                            <i class="fa-solid fa-lock tl-lx-inputicon"></i>
                            <input asp-for="Password" type="password" id="passwordInput" class="tl-lx-input" placeholder="Enter your password" autocomplete="current-password" maxlength="15" />
                            <button type="button" id="togglePassword" class="tl-lx-eye" aria-label="Show password">👁</button>
                        </div>
                        <span asp-validation-for="Password" class="tl-lx-error"></span>
                    </div>

                    <div class="tl-lx-field">
                        <label>Captcha Verification</label>
                        <div class="tl-lx-captcha-row">
                            <img id="captchaImg" src="@Url.Action("CaptchaImage", "Account")" alt="Captcha code" class="tl-lx-captcha-img" />
                            <button type="button" id="refreshCaptcha" class="tl-lx-captcha-refresh" title="Get a new code" aria-label="Refresh captcha">⟳</button>
                        </div>
                        <div class="tl-lx-inputwrap">
                            <i class="fa-solid fa-shield-halved tl-lx-inputicon"></i>
                            <input asp-for="CaptchaInput" class="tl-lx-input" placeholder="Enter the code shown above" autocomplete="off" maxlength="6" />
                        </div>
                        <span asp-validation-for="CaptchaInput" class="tl-lx-error"></span>
                    </div>

                   

                    <button type="submit" class="tl-lx-submit">Login <i class="fa-solid fa-arrow-right-to-bracket"></i></button>

                    <div class="tl-lx-forgot">
                        <a href="@Url.Action("ForgotPassword", "Account")">Forgot password?</a>
                    </div>

                    <div class="tl-lx-divider"><span>New to the portal?</span></div>

                    <a href="#" data-bs-toggle="modal" data-bs-target="#registerModal" class="tl-lx-register">
                        <i class="fa-solid fa-user-plus"></i> New User? Register Here
                    </a>

                    <p class="tl-lx-secure"><i class="fa-solid fa-lock"></i> Protected by captcha verification</p>
                </form>
            </div>
        </div>
    </div>

  </div>

    <partial name="_RegisterModal" model="(TradeLicence.Models.RegisterViewModel)(ViewBag.RegisterModel ?? new TradeLicence.Models.RegisterViewModel())" />

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register-validate.js" asp-append-version="true"></script>
    <script>
        document.getElementById('togglePassword').addEventListener('click', function () {
            const input = document.getElementById('passwordInput');
            const isHidden = input.type === 'password';
            input.type = isHidden ? 'text' : 'password';
            this.textContent = isHidden ? '🙈' : '👁';
            this.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        });

        document.getElementById('refreshCaptcha').addEventListener('click', function () {
            const img = document.getElementById('captchaImg');
            img.src = '@Url.Action("CaptchaImage", "Account")?t=' + Date.now();
        });

        
        @if (TempData["RegisterSuccess"] != null)
            {
                <text>
                        Swal.fire({
                            icon: 'success',
                        title: 'User Registered Successfully!',
                        text: @Html.Raw(Json.Serialize(TempData["RegisterSuccess"])),
                        confirmButtonColor: '#1a3a52'
                                            });
                </text>
        }

            @if (ViewBag.ShowRegisterModal == true)
            {
                <text>
                        document.addEventListener('DOMContentLoaded', function () {
                                                var modalEl = document.getElementById('registerModal');
                        if (modalEl && window.bootstrap) {
                            new bootstrap.Modal(modalEl).show();
                                                }
                                            });
                </text>

        }
    </script>
}
