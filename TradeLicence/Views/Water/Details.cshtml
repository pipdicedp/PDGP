@model WaterConnection.Models.AddNewWaterConnection

@{
    ViewData["Title"] = "Application Details";
}

<link rel="stylesheet" href="~/css/watercss/wc-details.css" />

<div class="wc-page">
    <div class="wc-shell">

        <div class="wc-header">
            <div>
                <p class="wc-eyebrow">Puducherry Water Supply &amp; Sewerage</p>
                <h2 class="wc-title">Application Details</h2>
            </div>
            <div class="wc-appid">Application ID <strong>@Model.ApplicationId</strong></div>
        </div>

        <div class="wc-sections">

            <!-- Applicant -->
            <div class="wc-section wc-span-2">
                <p class="wc-section-title">Applicant</p>
                <div class="wc-grid">
                    <div class="wc-field">
                        <label>Name</label>
                        <div class="wc-value">@Model.Name</div>
                    </div>
                    <div class="wc-field">
                        <label>Applicant Name</label>
                        <div class="wc-value">@Model.ApplicantName</div>
                    </div>
                    <div class="wc-field">
                        <label>Father Name</label>
                        <div class="wc-value">@Model.FatherName</div>
                    </div>
                    <div class="wc-field">
                        <label>Spouse Name</label>
                        <div class="wc-value">@Model.SpouseName</div>
                    </div>
                    <div class="wc-field">
                        <label>Power of Attorney</label>
                        <div class="wc-value">@Model.PowerOfAttorney</div>
                    </div>
                    <div class="wc-field">
                        <label>Phone Number</label>
                        <div class="wc-value">@Model.PhoneNumber</div>
                    </div>
                    <div class="wc-field">
                        <label>Email</label>
                        <div class="wc-value">@Model.Email</div>
                    </div>
                </div>
            </div>

            <!-- Communication Address -->
            <div class="wc-section">
                <p class="wc-section-title">Communication Address</p>
                <div class="wc-grid">
                    <div class="wc-field">
                        <label>Door No</label>
                        <div class="wc-value">@Model.CommDoorNo</div>
                    </div>
                    <div class="wc-field">
                        <label>City</label>
                        <div class="wc-value">@Model.CommCity</div>
                    </div>
                    <div class="wc-field">
                        <label>Address Line 1</label>
                        <div class="wc-value">@Model.CommAddress1</div>
                    </div>
                    <div class="wc-field">
                        <label>Address Line 2</label>
                        <div class="wc-value">@Model.CommAddress2</div>
                    </div>
                </div>
            </div>

            <!-- Connection Address -->
            <div class="wc-section">
                <p class="wc-section-title">Connection Address</p>
                <div class="wc-grid">
                    <div class="wc-field">
                        <label>Door No</label>
                        <div class="wc-value">@Model.ConnDoorNo</div>
                    </div>
                    <div class="wc-field">
                        <label>City</label>
                        <div class="wc-value">@Model.ConnCity</div>
                    </div>
                    <div class="wc-field">
                        <label>Address Line 1</label>
                        <div class="wc-value">@Model.ConnAddress1</div>
                    </div>
                    <div class="wc-field">
                        <label>Address Line 2</label>
                        <div class="wc-value">@Model.ConnAddress2</div>
                    </div>
                    <div class="wc-field wc-grid-wide" style="grid-column: 1 / -1;">
                        <label>Connection Address (Full)</label>
                        <div class="wc-value">@Model.ConnectionAddress</div>
                    </div>
                    <div class="wc-field" style="grid-column: 1 / -1;">
                        <label>Permanent Address</label>
                        <div class="wc-value">@Model.PermanentAddress</div>
                    </div>
                </div>
            </div>

            <!-- Work Details -->
            <div class="wc-section">
                <p class="wc-section-title">Work &amp; Contractor Details</p>
                <div class="wc-grid">
                    <div class="wc-field">
                        <label>Department</label>
                        <div class="wc-value">@Model.Department</div>
                    </div>
                    <div class="wc-field">
                        <label>Section</label>
                        <div class="wc-value">@Model.Section</div>
                    </div>
                    <div class="wc-field">
                        <label>Area</label>
                        <div class="wc-value">@Model.Area</div>
                    </div>
                    <div class="wc-field">
                        <label>Purpose</label>
                        <div class="wc-value">@Model.Purpose</div>
                    </div>
                    <div class="wc-field">
                        <label>Contractor</label>
                        <div class="wc-value">@Model.Contractor</div>
                    </div>
                    <div class="wc-field">
                        <label>PWD Contractor Name</label>
                        <div class="wc-value">@Model.PwdContractorName</div>
                    </div>
                    <div class="wc-field" style="grid-column: 1 / -1;">
                        <label>PWD Contractor Address</label>
                        <div class="wc-value">@Model.PwdContractorAddress</div>
                    </div>
                </div>
            </div>

            <!-- Documents -->
            <div class="wc-section wc-span-2">
                <p class="wc-section-title">Documents &amp; Uploads</p>
                <div class="wc-docs">
                    @{
                        var docFields = new (string Label, string Value)[]
                        {
                        ("Name & Address Document", Model.NameAddressDocument),
                        ("Ownership Document 1", Model.OwnershipDocument1),
                        ("Ownership Document 2", Model.OwnershipDocument2),
                        ("Others Document", Model.OthersDocument),
                        ("Contractor Consent Document", Model.ContractorConsentDocument),
                        ("Name & Address File", Model.NameAddressFileName),
                        ("Ownership File 1", Model.OwnershipFile1Name),
                        ("Ownership File 2", Model.OwnershipFile2Name),
                        ("Others File", Model.OthersFileName),
                        ("Contractor Consent File", Model.ContractorConsentFileName),
                        ("Identity Card File", Model.IdentityCardFileName),
                        ("Road Cutting Permission File", Model.RoadCuttingPermissionFileName),
                        };
                        var hasDocs = false;
                    }
                    @foreach (var doc in docFields)
                    {
                        if (!string.IsNullOrWhiteSpace(doc.Value))
                        {
                            hasDocs = true;
                            <div class="wc-doc-chip" title="@doc.Label: @doc.Value">
                                <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                <span>@doc.Label</span>
                            </div>
                        }
                    }
                    @if (!hasDocs)
                    {
                        <div class="wc-doc-empty">No documents on file</div>
                    }
                </div>
            </div>

        </div>

        <div class="wc-footer">
            <div class="wc-created">Submitted on <strong>@Model.CreatedDate</strong></div>
            <a asp-action="List" class="wc-back">← Back to List</a>
        </div>

    </div>
</div>
