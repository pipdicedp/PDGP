<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Trade Licence System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="tl-topbar">
        <div class="tl-topbar-container">

            <div class="tl-brand">

                <img src="@(Url.Content("~/Images/puducherry Logo.jpg"))"
                     alt="Puducherry Logo"
                     class="tl-logo" />

                <div>
                    <strong>GOVERNMENT OF PUDUCHERRY</strong><br />
                    DEPARTMENT OF INDUSTRIES AND COMMERCE<br />
                    <span class="tl-title">INVESTOR PORTAL</span>
                </div>

            </div>

            <div>
                <img src="@(Url.Content("~/Images/Government_of_Puducherry.png"))"
                     alt="Logo"
                     class="tr-logo" />
            </div>

        </div>
    </header>  
    <!-- Navigation Menu -->
    <nav class="tl-navbar">
        <div class="container">
            <ul class="tl-nav-menu">
                <li><a href="~/Dashboard/Index">Home</a></li>
                <li><a href="#home">Common Application Form</a></li>
                <li><a href="#home">Online Services</a></li>
                <li><a href="#home">Application Status Tracking</a></li>
                <li><a href="#home">Download Certificate</a></li>
                <li class="dropdown">
                    <a href="#about">Make Payment<span class="dropdown-arrow">▼</span></a>
                    <ul class="dropdown-menu">
                        <li><a href="#about-sub1">Make Payment</a></li>
                        <li><a href="#about-sub2">Payment Verification</a></li>
                    </ul>
                </li>
                <li><a href="#invest">ReGenerate Slip</a></li>
                <li class="dropdown">
                    <a href="#investor">Grievance/Queries<span class="dropdown-arrow">▼</span></a>
                    <ul class="dropdown-menu">
                        <li><a href="#investor-sub1">Grievance Entry</a></li>
                        <li><a href="#investor-sub2">Grievance Status</a></li>
                    </ul>
                </li>
                <li><a href="#verification">Incentives</a></li>
                <li><a href="#payment">Profile Update</a></li>
                <li class="user-menu">

                    <i class="fa fa-user-circle"></i>

                    <span>@User.Identity?.Name</span>

                    <form method="post"
                          asp-controller="Account"
                          asp-action="Logout"
                          class="logout-form">

                        <button type="submit" class="logout-icon-btn">
                            <i class="fa fa-sign-out-alt"></i>
                        </button>

                    </form>

                </li>
            </ul>
        </div>
    </nav>

    <main class="container tl-container">
        @RenderBody()
    </main>

    <footer class="tl-footer">
        <p>Designed &amp; Developed by National Informatics Centre, Puducherry UT Unit</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
