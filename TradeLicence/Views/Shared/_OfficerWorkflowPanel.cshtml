@model TradeLicence.Models.IWorkflowApplication
@*
    Shared Officer Workflow panel — Payment Calculation, Forward to Officer,
    Final Approval, Forwarding History, Stage Supporting Documents.

    Used by every service EXCEPT TradeLicence (which keeps its own inline
    copy in Views/Officer/ViewApplication.cshtml, untouched). Water is the
    first to use this; Electricity/Transport/future services reuse it as-is.

    Relies on these action names existing, unqualified (asp-action / Url.Action
    with no controller), on WHICHEVER controller renders this partial:
    ForwardToOfficer, RevertToPreviousOfficer, ApproveApplication,
    RejectApplication, ReturnToApplicant, SendPaymentRequest,
    UploadStageDocument, PreviewStageDocument, DownloadStageDocument, Index.
    WaterOfficerController already has all of these under those exact names.

    Caller (the service's own ViewApplication.cshtml) must set:
      @model                          -- the application entity itself (implements IWorkflowApplication)
      ViewBag.CurrentStage            (string)
      ViewBag.IsFinalStage            (bool)
      ViewBag.ForwardableByStage      (List<(string Stage, TradeLicence.Models.Officer Officer)>)
      ViewBag.WorkflowHistory         (List<TradeLicence.Models.WorkflowHistory>)
      ViewBag.OfficerNames            (Dictionary<int, string>)
      ViewBag.RevertTarget            (TradeLicence.Models.WorkflowHistory?)
      ViewBag.StageDocuments          (List<TradeLicence.Models.WorkflowSupportingDocument>)
      ViewBag.StageDocumentOfficerNames (Dictionary<int, string>)
      ViewBag.CanUploadStageDocument  (bool)
      ViewBag.ExistingStageDocumentForCurrentStage (TradeLicence.Models.WorkflowSupportingDocument?)
      ViewBag.Payment                 (TradeLicence.Models.WorkflowPayment?)
      ViewBag.SubmittedDate           (DateTime) -- used as the "received on" fallback for the very first history hop

      Optional (Fire NOC inspector): when the service has its own inspection
      card, set these to true to suppress the generic workflow controls:
      ViewBag.HideForwardPanel        (bool?) -- hide the forward/upload section
      ViewBag.HideFinalActions        (bool?) -- hide approve/reject/return buttons
      ViewBag.HideReturnToApplicant   (bool?) -- hide the bottom correction button
*@
@{
    var history = (List<TradeLicence.Models.WorkflowHistory>)ViewBag.WorkflowHistory;
    var officerNames = (Dictionary<int, string>)ViewBag.OfficerNames;
    var revertTarget = (TradeLicence.Models.WorkflowHistory?)ViewBag.RevertTarget;
    var revertToName = revertTarget?.FromOfficerId.HasValue == true && officerNames.ContainsKey(revertTarget.FromOfficerId.Value)
        ? officerNames[revertTarget.FromOfficerId.Value] : "previous officer";
    var submittedDate = (DateTime)ViewBag.SubmittedDate;

    // A decided application (Approved/Rejected) shows a read-only decision card
    // instead of the forward/approve/reject action buttons. Only services that
    // opt-in via ViewBag.IsDecided are affected; others remain unchanged.
    var isDecided = ViewBag.IsDecided == true
        || string.Equals(Model.Status, "Approved", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Status, "Rejected", StringComparison.OrdinalIgnoreCase);
    var decisionStatus = (ViewBag.DecisionStatus as string) ?? Model.Status;
    var isReturned = string.Equals(Model.Status, "ReturnedToApplicant", StringComparison.OrdinalIgnoreCase);
}

<div class="tl-officer-panel">

    @{
        var canUploadStageDocument = (bool)ViewBag.CanUploadStageDocument;
        var existingForCurrentStage = (TradeLicence.Models.WorkflowSupportingDocument?)ViewBag.ExistingStageDocumentForCurrentStage;
    }

    <div class="tl-officer-panel-title">
        <i class="fa-solid fa-users-gear"></i> Officer Workflow
    </div>

    <form id="returnForm" method="post" asp-action="ReturnToApplicant" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.ApplicationId" />
        <input type="hidden" name="remarks" id="returnRemarks" />
    </form>

    <form id="approveForm" method="post" asp-action="ApproveApplication" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.ApplicationId" />
        <input type="hidden" name="remarks" id="approveRemarks" />
    </form>

    <form id="revertForm" method="post" asp-action="RevertToPreviousOfficer" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.ApplicationId" />
        <input type="hidden" name="remarks" id="revertRemarks" />
    </form>

    <form id="rejectForm" method="post" asp-action="RejectApplication" style="display:none;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.ApplicationId" />
        <input type="hidden" name="remarks" id="rejectRemarks" />
    </form>

    <div class="tl-grid-2">

        <!-- LEFT: Forward to Officer / Final Approval -->
        <div>
            @{
                var isInspectionStage = (string)ViewBag.CurrentStage == "Inspection";
                var payment = (TradeLicence.Models.WorkflowPayment?)ViewBag.Payment;
                var paymentStatus = payment?.PaymentStatus ?? "NotRequested";
                // CAF department workflows have no applicant-payment step: the controller sets ViewBag.HidePayment.
                var hidePayment = ViewBag.HidePayment == true;
                var forwardBlocked = isInspectionStage && !hidePayment && paymentStatus != "Paid";
                var paymentPendingBlock = paymentStatus == "Pending";
            }
            @if (isInspectionStage && !hidePayment)
            {
                var paymentStatusIcon = paymentStatus == "Paid" ? "fa-circle-check" : paymentStatus == "Pending" ? "fa-hourglass-half" : "fa-circle-info";
                var paymentStatusLabel = paymentStatus == "Paid" ? "Paid" : paymentStatus == "Pending" ? "Pending" : "Not Requested";

                <div class="tl-section tl-card-blue">
                    <div id="paymentAccordionHeader" class="tl-payment-legend" role="button" tabindex="0" aria-expanded="false">
                        <span><i class="fa-solid fa-indian-rupee-sign"></i> Payment Calculation</span>
                        <span class="tl-payment-header-right">
                            <span class="tl-payment-status tl-payment-status-@(paymentStatus.ToLower())">
                                <i class="fa-solid @paymentStatusIcon"></i> @paymentStatusLabel
                            </span>
                            <i class="fa-solid fa-chevron-down tl-payment-chevron"></i>
                        </span>
                    </div>

                    <form id="sendPaymentForm" method="post" asp-action="SendPaymentRequest" style="display:none;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ApplicationId" />
                    </form>

                    <div id="paymentAccordionBody" class="tl-payment-body" style="display:none;">
                        <div class="tl-payment-card">
                            <div class="tl-payment-row">
                                <span>Application Payment</span>
                                <span>&#8377;@((payment?.PaymentAmount ?? 1000m).ToString("N2"))</span>
                            </div>
                            <div class="tl-payment-row">
                                <span>Extra Charge</span>
                                <span>&#8377;@((payment?.ExtraCharge ?? 500m).ToString("N2"))</span>
                            </div>
                            <div class="tl-payment-row tl-payment-row-total">
                                <span>Total Amount</span>
                                <span>&#8377;@((payment?.TotalPaymentAmount ?? 1500m).ToString("N2"))</span>
                            </div>
                        </div>

                        @if (paymentStatus == "Paid")
                        {
                            <p class="tl-payment-note tl-payment-note-paid">
                                <i class="fa-solid fa-circle-check"></i>
                                Payment received on @(payment?.PaymentCompletedDate?.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt") ?? "-")
                            </p>
                        }
                        else if (paymentStatus == "Pending")
                        {
                            <p class="tl-payment-note tl-payment-note-pending">
                                <i class="fa-solid fa-hourglass-half"></i>
                                Requested on @(payment?.PaymentRequestedDate.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt") ?? "-") — awaiting payment from the applicant.
                            </p>
                        }
                        else
                        {
                            <div class="tl-officer-actions-group">
                                <button type="button" id="btnSendPayment" class="btn btn-primary">Send Payment Request to Applicant</button>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (isDecided)
            {
                <fieldset class="tl-section @(string.Equals(decisionStatus, "Approved", StringComparison.OrdinalIgnoreCase) ? "tl-card-green" : "tl-card-red")">
                    <legend><i class="fa-solid @(string.Equals(decisionStatus, "Approved", StringComparison.OrdinalIgnoreCase) ? "fa-circle-check" : "fa-circle-xmark")"></i> Decision</legend>
                    <p class="tl-note">
                        This application has been <strong>@(string.Equals(decisionStatus, "Approved", StringComparison.OrdinalIgnoreCase) ? "approved" : "rejected")</strong>. No further officer actions are available.
                    </p>
                    <p class="tl-note" style="margin-top:-8px;">Current stage recorded as <strong>@Model.CurrentStage</strong>.</p>
                </fieldset>
            }
            else if (isReturned)
            {
                <fieldset class="tl-section tl-card-gold">
                    <legend><i class="fa-solid fa-hourglass-half"></i> With the Applicant</legend>
                    <p class="tl-note">
                        This application was sent back to the applicant for <strong>correction / modification</strong>.
                        Every section and document is editable for the applicant; it returns to the workflow
                        automatically when they resubmit it.
                    </p>
                </fieldset>
            }
            else if (!(bool)ViewBag.IsFinalStage)
            {
                if (ViewBag.HideForwardPanel == true)
                {
                    <fieldset class="tl-section tl-card-blue">
                        <legend><i class="fa-solid fa-clipboard-check"></i> Inspection in Progress</legend>
                        <p class="tl-note">
                            Use the <strong>Site Inspection</strong> card above to record your findings and attach
                            the inspection report. Submitting the report returns the application to the Fire NOC
                            Administrator for the final decision.
                        </p>
                    </fieldset>
                }
                else
                {
                <fieldset class="tl-section tl-card-navy">
                    <legend><i class="fa-solid fa-paper-plane"></i> Forward to Officer</legend>

                    <form method="post" asp-action="ForwardToOfficer" id="forwardOfficerForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.ApplicationId" />
                        <input type="hidden" name="officerId" id="forwardOfficerId" />
                        <input type="hidden" name="targetStage" id="forwardTargetStage" />

                        <div class="form-group">
                            <label>Forward To <span class="req">*</span></label>
                            <select id="forwardOfficerSelect" class="form-select" required @(forwardBlocked ? "disabled" : "")>
                                <option value="">-- Select officer --</option>
                                @{
                                    var forwardableByStage = ((List<(string Stage, TradeLicence.Models.Officer Officer)>)ViewBag.ForwardableByStage)
                                        .GroupBy(x => x.Stage);
                                }
                                @foreach (var group in forwardableByStage)
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var entry in group)
                                        {
                                            <option value="@entry.Officer.OfficerId:@group.Key">@entry.Officer.FullName (@entry.Officer.Username)</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                            @if (((List<(string Stage, TradeLicence.Models.Officer Officer)>)ViewBag.ForwardableByStage).Count == 0)
                            {
                                <span class="tl-note">No officers found for the next stage(s) — add one under the applicable Designation first.</span>
                            }
                            @if (forwardBlocked)
                            {
                                <span class="tl-note" style="color:#B3261E;">This application can't be forwarded until the payment above has been received.</span>
                            }
                        </div>

                        <div class="form-group">
                            <label>Remarks</label>
                            <textarea name="remarks" class="form-control" rows="2" placeholder="Optional remarks for the next officer..." @(forwardBlocked ? "disabled" : "")></textarea>
                        </div>
                    </form>

                    @if (canUploadStageDocument)
                    {
                        <div class="form-group">
                            <label>Upload @ViewBag.CurrentStage Document</label>
                            <p id="currentStageFileNote" class="tl-note" style="@(existingForCurrentStage == null ? "display:none;" : "")">
                                @if (existingForCurrentStage != null)
                                {
                                    <text>
                                        Current file: <strong>@existingForCurrentStage.FileName</strong>
                                        (uploaded @existingForCurrentStage.UploadedDate.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")).
                                        Uploading a new file will replace it.
                                    </text>
                                }
                            </p>
                            <form id="stageDocumentUploadForm" method="post"
                                  asp-action="UploadStageDocument" asp-route-id="@Model.ApplicationId"
                                  enctype="multipart/form-data" style="display:flex; gap:10px; align-items:center;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.ApplicationId" />
                                <input type="file" name="file" class="form-control" required style="flex:1;" />
                                <button type="submit" class="btn btn-primary" style="flex-shrink:0;">Upload</button>
                                <button type="button" id="stageDocPreviewBtn" class="btn btn-secondary tl-stage-preview-btn"
                                        style="flex-shrink:0; @(existingForCurrentStage == null ? "display:none;" : "")"
                                        data-preview-url="@(existingForCurrentStage != null ? Url.Action("PreviewStageDocument", new { docId = existingForCurrentStage.WorkflowSupportingDocumentId }) : "")"
                                        data-content-type="@existingForCurrentStage?.ContentType"
                                        data-file-name="@existingForCurrentStage?.FileName">
                                    Preview
                                </button>
                            </form>
                        </div>
                    }

                    <div class="tl-officer-actions-group">
                        <button type="submit" form="forwardOfficerForm" class="btn btn-primary" @(forwardBlocked ? "disabled" : "")>Forward Application</button>
                        @if (revertTarget != null)
                        {
                            <button type="button" id="btnRevert" class="btn btn-revert" data-revert-to="@revertToName" @(paymentPendingBlock ? "disabled" : "")><i class="fa-solid fa-rotate-left"></i> Revert to Officer</button>
                        }
                    </div>
                    @if (paymentPendingBlock)
                    {
                        <span class="tl-note" style="color:#B3261E;">Revert and Correction / Modification are disabled while a payment is pending with the applicant.</span>
                    }
                </fieldset>
                }
            }
            else
            {
                var stageDocuments = (List<TradeLicence.Models.WorkflowSupportingDocument>)ViewBag.StageDocuments;
                var stageDocOfficerNames = (Dictionary<int, string>)ViewBag.StageDocumentOfficerNames;

                if (stageDocuments.Count > 0)
                {
                    <fieldset class="tl-section tl-card-purple">
                        <legend><i class="fa-solid fa-folder-open"></i> Stage Supporting Documents</legend>
                        @foreach (var doc in stageDocuments)
                        {
                            var uploaderName = doc.UploadedByOfficerId.HasValue && stageDocOfficerNames.ContainsKey(doc.UploadedByOfficerId.Value)
                                ? stageDocOfficerNames[doc.UploadedByOfficerId.Value] : "-";
                            <div class="tl-history-item">
                                <span class="tl-history-icon"><i class="fa-solid fa-file-lines"></i></span>
                                <div class="tl-history-body">
                                    <div class="tl-history-action">@doc.Stage</div>
                                    <div class="tl-history-meta">
                                        <a href="@Url.Action("DownloadStageDocument", new { docId = doc.WorkflowSupportingDocumentId })" target="_blank">@doc.FileName</a><br />
                                        Uploaded by @uploaderName on @doc.UploadedDate.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")
                                    </div>
                                </div>
                            </div>
                        }
                    </fieldset>
                }

                <fieldset class="tl-section tl-card-green">
                    <legend><i class="fa-solid fa-stamp"></i> Final Approval</legend>
                    @if (ViewBag.HideFinalActions == true)
                    {
                        <p class="tl-note">
                            The inspection report has been submitted. This application is now with the
                            Fire NOC Administrator for the final decision — no further action is needed
                            from you.
                        </p>
                    }
                    else
                    {
                        @if (ViewBag.AdminOverride == true)
                        {
                            <p class="tl-note">You're signed in as an Administrator, so you can approve, reject or send this application back for correction at any stage.</p>
                        }
                        else
                        {
                            <p class="tl-note">This application has reached the final stage (Approval). Approve it to finish the process, return it to the applicant if something needs correcting, or reject it outright.</p>
                        }
                        <div class="tl-officer-actions-group">
                            <button type="button" id="btnApprove" class="btn btn-success">Approve Application</button>
                            <button type="button" id="btnReject" class="btn btn-danger">Reject Application</button>
                            <button type="button" class="btn btn-warning js-return-applicant">
                                <i class="fa-solid fa-pen-to-square"></i> Correction / Modification
                            </button>
                            @if (revertTarget != null)
                            {
                                <button type="button" id="btnRevert" class="btn btn-revert" data-revert-to="@revertToName" @(paymentPendingBlock ? "disabled" : "")><i class="fa-solid fa-rotate-left"></i> Revert to Officer</button>
                            }
                        </div>
                        <p class="tl-note" style="margin-top:10px;">
                            <strong>Correction / Modification</strong> sends the application back to the
                            applicant. Every section and every uploaded document becomes editable again,
                            the applicant sees your remarks, and resubmits it to you for a fresh decision.
                        </p>
                    }
                </fieldset>
            }
        </div>

        <!-- RIGHT: Forwarding History -->
        <div>
            @if (history.Count > 0)
            {
                <fieldset class="tl-section tl-card-gold">
                    <legend><i class="fa-solid fa-clock-rotate-left"></i> Forwarding History</legend>
                    <div class="tl-history-scroll">
                        @for (int i = history.Count - 1; i >= 0; i--)
                        {
                            var h = history[i];
                            var fromName = h.FromOfficerId.HasValue && officerNames.ContainsKey(h.FromOfficerId.Value)
                                ? officerNames[h.FromOfficerId.Value] : "Applicant";
                            var toName = h.ToOfficerId.HasValue && officerNames.ContainsKey(h.ToOfficerId.Value)
                                ? officerNames[h.ToOfficerId.Value] : "-";

                            var isRevert = string.Equals(h.ActionType, "Revert", StringComparison.OrdinalIgnoreCase);
                            var isApprove = string.Equals(h.ActionType, "Approve", StringComparison.OrdinalIgnoreCase);
                            var isReject  = string.Equals(h.ActionType, "Reject", StringComparison.OrdinalIgnoreCase);
                            var isReturn  = string.Equals(h.ActionType, "Return", StringComparison.OrdinalIgnoreCase);
                            var isResubmit= string.Equals(h.ActionType, "Resubmit", StringComparison.OrdinalIgnoreCase);
                            var isInspection = string.Equals(h.ActionType, "Inspection", StringComparison.OrdinalIgnoreCase);
                            var isDecision= isApprove || isReject || isReturn;

                            var actionLabel = isApprove ? "Approved" : isReject ? "Rejected" : isReturn ? "Returned to Applicant" : isResubmit ? "Resubmitted by Applicant" : isInspection ? "Inspection Report Submitted" : isRevert ? "Reverted" : "Forwarded";
                            var iconClass    = isApprove ? "fa-circle-check" : isReject ? "fa-circle-xmark" : isReturn ? "fa-arrow-rotate-left" : isResubmit ? "fa-paper-plane" : isInspection ? "fa-clipboard-check" : isRevert ? "fa-rotate-left" : "fa-share";

                            var receivedOn = i > 0 ? history[i - 1].ActionDate : submittedDate;
                            var forwardedOn = h.ActionDate;
                            var duration = forwardedOn - receivedOn;
                            var takenText = duration.TotalDays >= 1
                                ? $"{(int)duration.TotalDays} day{((int)duration.TotalDays == 1 ? "" : "s")}"
                                : duration.TotalHours >= 1
                                    ? $"{(int)duration.TotalHours} hour{((int)duration.TotalHours == 1 ? "" : "s")}"
                                    : "under an hour";

                            <div class="tl-history-item @(isRevert || isDecision ? "tl-history-revert" : "")">
                                <span class="tl-history-icon"><i class="fa-solid @iconClass"></i></span>
                                <div class="tl-history-body">
                                    <div class="tl-history-action">
                                        @actionLabel
                                        @if (i == history.Count - 1)
                                        {
                                            <span class="tl-history-latest-tag">Latest</span>
                                        }
                                    </div>
                                    @if (isDecision)
                                    {
                                        <div class="tl-history-route">@fromName (@h.FromStage) &rarr; @actionLabel</div>
                                    }
                                    else
                                    {
                                        <div class="tl-history-route">@fromName (@h.FromStage) &rarr; @toName (@h.ToStage)</div>
                                    }
                                    <div class="tl-history-meta">
                                        Received: @receivedOn.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")<br />
                                        @(isResubmit ? "Resubmitted:" : isInspection ? "Submitted:" : isDecision ? "Actioned:" : "Forwarded:") @forwardedOn.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")<br />
                                        Time taken: @takenText
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(h.Remarks))
                                    {
                                        <div class="tl-history-remarks">"@h.Remarks"</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </fieldset>
            }
            else
            {
                <fieldset class="tl-section tl-card-gold">
                    <legend><i class="fa-solid fa-clock-rotate-left"></i> Forwarding History</legend>
                    <p class="tl-note">No forwarding activity yet.</p>
                </fieldset>
            }
        </div>

    </div>

    <div class="tl-actions">
        <a class="btn btn-secondary" href="@Url.Action("Index")">&laquo; Back to Dashboard</a>
        @if (!isDecided && !isReturned)
        {
            @if (ViewBag.IsFireNocAdmin == true && ViewBag.CanForwardToInspectorFromPanel == true)
            {
                <a class="btn btn-primary" href="@Url.Action("ForwardToInspectorForm", "FireOfficer", new { id = Model.ApplicationId })">
                    <i class="fa-solid fa-share-from-square"></i> Forward to Inspector
                </a>
            }
            @if (!(ViewBag.IsFireNocAdmin == true) || ViewBag.HideReturnToApplicant == true)
            {
                <button type="button" id="btnReturnToApplicant" class="btn btn-warning js-return-applicant" style="@(ViewBag.HideReturnToApplicant == true ? "display:none;" : "")" @(paymentPendingBlock ? "disabled" : "")>
                    <i class="fa-solid fa-pen-to-square"></i> Correction / Modification
                </button>
            }
        }
    </div>

</div>

<div id="stageDocPreviewModal" class="tl-stage-preview-overlay" style="display:none;">
    <div class="tl-stage-preview-box">
        <div class="tl-stage-preview-header">
            <span id="stageDocPreviewTitle">Preview</span>
            <button type="button" id="stageDocPreviewClose" class="tl-stage-preview-close">&times;</button>
        </div>
        <div id="stageDocPreviewContent" class="tl-stage-preview-body"></div>
    </div>
</div>
