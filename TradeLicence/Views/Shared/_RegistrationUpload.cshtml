@model TradeLicence.Models.RegUploadField
@*
    One labelled upload box shared by the Firms and Society forms.
    Post name = Model.Name (a property of the form's view model); the shared JS
    (wwwroot/js/reg_js/registration_form.js) checks size/type and required-ness.
*@
<div class="form-group reg-upload">
    <label>@Model.Label @if (Model.Required) {
        <span class="req">*</span>
    }
</label>
<input type="file"
       name="@Model.Name"
       class="form-control"
       accept="@(Model.Accept == "pdf" ? ".pdf,application/pdf" : ".pdf,.jpg,.jpeg,.png")"
       data-accept="@Model.Accept"
       data-label="@Model.Label"
       data-has-existing="@(Model.ExistingDocumentId.HasValue ? "true" : "false")"
@(Model.Required ? "data-doc-required" : "") />
@if (Model.ExistingDocumentId.HasValue)
{
    <button type="button" class="reg-link-btn reg-view-doc" data-doc-title="@Model.Label" data-doc-url="@Url.Action("ViewDocument", Model.ViewController, new { documentId = Model.ExistingDocumentId })">View previously uploaded file</button>
}
</div>
