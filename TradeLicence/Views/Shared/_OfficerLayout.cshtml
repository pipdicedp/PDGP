@using TradeLicence.Helpers
@using TradeLicence.Models
@{
    var designation = User.FindFirst("Designation")?.Value;
    var officerMenu = OfficerMenuProvider.GetMenuForDesignation(designation);

    // Render-time safety net: resolve every link now and drop anything that
    // doesn't resolve, so a missing route can never render as a dead link
    // (empty href) or a 404. A dropdown whose children are all dropped
    // disappears with them.
    Func<string, string, bool> resolves = (controller, action) =>
        !string.IsNullOrEmpty(Url.Action(action, controller));

    var resolvedMenu = new List<OfficerMenuItem>();
    foreach (var item in officerMenu)
    {
        if (item.Children != null && item.Children.Any())
        {
            var children = item.Children.Where(c => resolves(c.Controller, c.Action)).ToList();
            if (children.Count > 0)
            {
                resolvedMenu.Add(new OfficerMenuItem { Text = item.Text, Icon = item.Icon, Children = children });
            }
        }
        else if (resolves(item.Controller, item.Action))
        {
            resolvedMenu.Add(item);
        }
    }

    // Active-state helpers: highlight the item whose controller + action we
    // are currently on (a dropdown parent lights up when any child matches).
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    Func<string, string, bool> isActive = (controller, action) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Trade Licence System (Officer)</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/tl_css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/user-profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/officer_css/officer.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="tl-topbar">
        <div class="tl-topbar-container">

            <div class="tl-brand">

                <img src="@(Url.Content("~/Images/puducherry Logo.jpg"))"
                     alt="Puducherry Logo"
                     class="tl-logo" />

                <div>
                    <strong>GOVERNMENT OF PUDUCHERRY</strong><br />
                    DEPARTMENT OF INDUSTRIES AND COMMERCE<br />
                    <span class="tl-title">OFFICER PORTAL</span>
                </div>

            </div>

            <div>
                <img src="@(Url.Content("~/Images/Government_of_Puducherry.png"))"
                     alt="Logo"
                     class="tr-logo" />
            </div>

        </div>
    </header>
    <!-- Navigation Menu — items come from OfficerMenuProvider, based on the
         logged-in officer's Designation claim. Add a new designation's menu
         there, not here. -->
    <nav class="tl-navbar">
        <div class="container">
            <ul class="tl-nav-menu">
                @foreach (var item in resolvedMenu)
                {
                    var isDropdown = item.Children != null && item.Children.Any();
                    var parentActive = isDropdown && item.Children!.Any(c => isActive(c.Controller, c.Action));

                    @if (isDropdown)
                    {
                        <li class="dropdown @(parentActive ? "active" : "")">
                            <a href="#">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    <i class="@item.Icon"></i>
                                }
                                <span>@item.Text</span><span class="dropdown-arrow">▼</span>
                            </a>
                            <ul class="dropdown-menu">
                                @foreach (var child in item.Children!)
                                {
                                    <li>
                                        <a class="@(isActive(child.Controller, child.Action) ? "active" : "")"
                                           href="@Url.Action(child.Action, child.Controller)">
                                            @if (!string.IsNullOrEmpty(child.Icon))
                                            {
                                                <i class="@child.Icon"></i>
                                            }
                                            <span>@child.Text</span>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="@(isActive(item.Controller, item.Action) ? "active" : "")">
                            <a href="@Url.Action(item.Action, item.Controller)">
                                @if (!string.IsNullOrEmpty(item.Icon))
                                {
                                    <i class="@item.Icon"></i>
                                }
                                <span>@item.Text</span>
                            </a>
                        </li>
                    }
                }
                <li class="user-menu">

                    <!-- Click to show / hide this account's details (see wwwroot/js/user-profile.js) -->
                    <button type="button"
                            id="profileToggleBtn"
                            class="profile-toggle-btn"
                            data-profile-url="@Url.Action("OfficerProfile", "Account")"
                            data-profile-kind="officer"
                            aria-haspopup="true"
                            aria-expanded="false"
                            aria-controls="profileCard"
                            title="View my details">
                        <i class="fa fa-user-circle"></i>
                    </button>

                    <span>@User.Identity?.Name</span>

                    <form method="post"
                          asp-controller="Account"
                          asp-action="Logout"
                          class="logout-form">

                        <button type="submit" class="logout-icon-btn">
                            <i class="fa fa-sign-out-alt"></i>
                        </button>

                    </form>

                    <!-- Inline position is a safety net: if the stylesheet ever failed to load, the box
                         must still float over the page instead of expanding the nav bar. -->
                    <div id="profileCard" class="profile-card" role="dialog" aria-label="My details" hidden
                         style="position:absolute;top:calc(100% + 6px);right:0;z-index:1050;width:320px;max-width:calc(100vw - 24px);">
                        <div class="profile-card-body"></div>
                    </div>

                </li>
            </ul>
        </div>
    </nav>

    <main class="container tl-container">
        @RenderBody()
    </main>

    <footer class="tl-footer">
        <p>Designed &amp; Developed by National Informatics Centre, Puducherry UT Unit</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/user-profile.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
