@model TradeLicence.Models.SocietyApplication
@*
    Read-only "Society Registration / Renewal" details, used by the citizen's Preview page AND the
    officer's ViewApplication page. The caller sets ViewBag.DocController / DocAction / DocNames
    exactly as for _FirmApplicationDetails.
*@
@{
    var docController = (string)ViewBag.DocController;
    var docAction = (string)ViewBag.DocAction;
    var docNames = ViewBag.DocNames as Dictionary<int, string> ?? new Dictionary<int, string>();

    Func<string, string?, Microsoft.AspNetCore.Html.IHtmlContent> Field = (label, value) =>
        new Microsoft.AspNetCore.Html.HtmlString(
            "<div class=\"reg-field\"><span class=\"reg-field-label\">" + System.Net.WebUtility.HtmlEncode(label) +
            "</span><span class=\"reg-field-value\">" +
            System.Net.WebUtility.HtmlEncode(string.IsNullOrWhiteSpace(value) ? "-" : value) + "</span></div>");

    string DocUrl(int? id) => Url.Action(docAction, docController, new { documentId = id })!;
    string DocFile(int? id) => id.HasValue && docNames.TryGetValue(id.Value, out var n) ? n : "";

    bool renewal = Model.ApplicationType == "Renewal";

    var documents = new (string Label, int? Id)[]
    {
        ("Memorandum of Association / Society", Model.MemorandumDocumentId),
        ("Rules and Regulations of the Society", Model.RulesDocumentId),
        ("Power of Autonomy (Modification / Certificate of Registration to be collected)", Model.PowerOfAutonomyDocumentId),
        ("Proof of the address of the society (Utility bills / Rental Agreement)", Model.AddressProofDocumentId),
        ("Copy of Name Availability", Model.NameAvailabilityDocumentId)
    };
}

<fieldset class="tl-section">
    <legend><i class="fa-solid fa-file-signature"></i> Application Type</legend>
    <div class="reg-details-grid">
        @Field("Type of Application", renewal ? "Renewal" : "New Registration")
        @if (renewal)
        {
            @Field("Existing Registration No.", Model.ExistingRegistrationNumber)
            @Field("Registration Expiry Date", Model.LicenceExpiryDate?.ToString("dd-MM-yyyy"))
        }
    </div>
</fieldset>

<fieldset class="tl-section">
    <legend><i class="fa-solid fa-user"></i> Applicant Details</legend>
    <div class="reg-details-grid">
        @Field("Applicant Name", Model.ApplicantName)
        @Field("Applicant Address", Model.ApplicantAddress)
        @Field("Mobile No.", Model.MobileNumber)
        @Field("Email Id", Model.Email)
        @Field("Designation of the Applicant", Model.ApplicantDesignation)
    </div>
</fieldset>

<fieldset class="tl-section">
    <legend><i class="fa-solid fa-landmark"></i> Society Details</legend>
    <div class="reg-details-grid">
        @Field("Name of the Society", Model.SocietyName)
        @if (!renewal)
        {
            @Field("Proposed Name of Association / Society", Model.ProposedSocietyName)
        }
        @Field("Address of the Society", Model.SocietyAddress)
    </div>
</fieldset>

<fieldset class="tl-section">
    <legend><i class="fa-solid fa-people-group"></i> Governing Body Member Details</legend>
    <div class="reg-table-wrap">
        <table class="reg-people-table">
            <thead>
                <tr>
                    <th>Sl.No.</th>
                    <th>Name</th>
                    <th>Address</th>
                    <th>Designation</th>
                    <th>Date of Appointment</th>
                    <th>Id Proof</th>
                    <th>Signature</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int sl = 1;
                }
                @foreach (var m in Model.Members.OrderBy(x => x.Id))
                {
                    <tr>
                        <td>@(sl++)</td>
                        <td>@m.Name</td>
                        <td>@m.Address</td>
                        <td>@m.Designation</td>
                        <td>@(m.DateOfAppointment?.ToString("dd-MM-yyyy") ?? "-")</td>
                        <td>@if (m.IdProofDocumentId.HasValue) {
                            <button type="button" class="reg-btn-view reg-view-doc" data-doc-url="@DocUrl(m.IdProofDocumentId)" data-doc-title="Document Preview"><i class="fas fa-eye"></i> View</button>
                        } else
                        {

                            <text>-</text>
                        }
                    </td>
                    <td>@if (m.SignatureDocumentId.HasValue) {
                        <button type="button" class="reg-btn-view reg-view-doc" data-doc-url="@DocUrl(m.SignatureDocumentId)" data-doc-title="Document Preview"><i class="fas fa-eye"></i> View</button>
                    } else
                    {

                        <text>-</text>
                    }
                </td>
            </tr>
        }
        @if (!Model.Members.Any())
        {
            <tr><td colspan="7" class="reg-empty">No governing body members added.</td></tr>
        }
    </tbody>
</table>
</div>
</fieldset>

<fieldset class="tl-section">
    <legend><i class="fa-solid fa-paperclip"></i> Documents Submitted</legend>
    @foreach (var d in documents)
    {
        <div class="reg-doc-row">
            <span class="reg-doc-name">@d.Label <span class="reg-doc-file">@DocFile(d.Id)</span></span>
            @if (d.Id.HasValue)
            {
                <button type="button" class="reg-btn-view reg-view-doc" data-doc-url="@DocUrl(d.Id)" data-doc-title="Document Preview"><i class="fas fa-eye"></i> View</button>
            }
            else
            {
                <span class="reg-hint">Not uploaded</span>
            }
        </div>
    }
</fieldset>
