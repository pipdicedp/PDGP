@model TradeLicence.Models.IWorkflowApplication
@*
    Applicant-side progress: the 4-stage tracker (Initial Scrutiny > Verification > Inspection >
    Approval), the current processing stage, and a dated timeline. Officer names are not shown.
    Caller sets: ViewBag.SubmittedOn (DateTime?), ViewBag.History (List<WorkflowHistory>),
    ViewBag.Payment (WorkflowPayment?).
*@
@{
    var stages = TradeLicence.Models.OfficerWorkflow.Stages;
    bool submitted = Model.Status != "Draft";
    int current = Math.Max(0, TradeLicence.Models.OfficerWorkflow.StageIndex(Model.CurrentStage));
    bool approved = Model.Status == "Approved";
    bool rejected = Model.Status == "Rejected";

    var history = ViewBag.History as List<TradeLicence.Models.WorkflowHistory> ?? new List<TradeLicence.Models.WorkflowHistory>();
    var payment = ViewBag.Payment as TradeLicence.Models.WorkflowPayment;
    var submittedOn = ViewBag.SubmittedOn as DateTime?;

    var events = new List<(DateTime When, string Text)>();
    if (submittedOn.HasValue) events.Add((submittedOn.Value, "Application submitted"));
    foreach (var h in history)
    {
        var when = h.ActionDate.ToLocalTime();
        events.Add((when, h.ActionType == "Revert"
            ? $"Sent back to {h.ToStage} stage"
            : $"Moved from {h.FromStage} to {h.ToStage} stage"));
    }
    if (payment != null)
    {
        events.Add((payment.PaymentRequestedDate.ToLocalTime(), $"Payment of ₹{payment.TotalPaymentAmount:N2} requested"));
        if (payment.PaymentCompletedDate.HasValue)
            events.Add((payment.PaymentCompletedDate.Value.ToLocalTime(), "Payment received"));
    }
    if ((approved || rejected) && Model.ModifiedDate.HasValue)
        events.Add((Model.ModifiedDate.Value.ToLocalTime(), approved ? "Application approved" : "Application rejected"));
    events = events.OrderBy(e => e.When).ToList();
}

@if (!submitted)
{
    <div class="reg-notice reg-notice-info">This application is still a draft - it has not been submitted yet.</div>
}
else
{
    <div class="reg-stepper-bar">
        <div class="reg-stepper">
            @for (int i = 0; i < stages.Length; i++)
            {
                var stepClass = approved || i < current ? "reg-step-done"
                    : i == current ? (rejected ? "reg-step-rejected" : "reg-step-current")
                    : "";
                <div class="reg-step @stepClass">
                    <div class="reg-step-circle">
                        @if (approved || i < current)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else if (rejected && i == current)
                        {

                            <i class="fa-solid fa-xmark"></i>
                        }
                        else
                        {

                            @(i + 1)
                        }
                    </div>
                    <div class="reg-step-label">@stages[i]</div>
                </div>
                if (i < stages.Length - 1)
                {
                    <div class="reg-step-connector @(approved || i < current ? "reg-step-connector-done" : "")"></div>
                }
            }
        </div>
        <div class="reg-stage-note">
            @if (approved)
            {
                <text>Application approved.</text>
            }
            else if (rejected)
            {

                <text>Application rejected at the <strong>@Model.CurrentStage</strong> stage.</text>
            }
            else if (Model.Status == "ReturnedToApplicant")
            {

                <text>Returned to you for correction at the <strong>@Model.CurrentStage</strong> stage.</text>
            }
            else if (Model.PaymentStatus == "Pending")
            {

                <text>Currently at the <strong>@Model.CurrentStage</strong> stage - <strong>payment pending</strong> from you.</text>
            }
            else
            {

                <text>Currently being processed at the <strong>@Model.CurrentStage</strong> stage.</text>
            }
        </div>
    </div>

    @if (events.Count > 0)
    {
        <fieldset class="tl-section">
            <legend><i class="fa-solid fa-timeline"></i> Application Timeline</legend>
            <ul class="reg-timeline">
                @foreach (var ev in events)
                {
                    <li>@ev.Text<span class="reg-tl-date">@ev.When.ToString("dd-MM-yyyy hh:mm tt")</span></li>
                }
            </ul>
        </fieldset>
    }
}
