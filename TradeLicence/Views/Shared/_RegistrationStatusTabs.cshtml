@model string
@*
    Switches between the applicant's Application Status Tracking pages. Pass "trade", "firms" or
    "society" to mark the current one.
*@
<div class="reg-tabs">
    <a class="reg-tab @(Model == "trade" ? "active" : "")" href="@Url.Action("Status", "Dashboard")">Trade Licence</a>
    <a class="reg-tab @(Model == "firms" ? "active" : "")" href="@Url.Action("MyApplications", "FirmRegistration")">Registration of Firms</a>
    <a class="reg-tab @(Model == "society" ? "active" : "")" href="@Url.Action("MyApplications", "SocietyRegistration")">Society Registration / Renewal</a>
</div>
