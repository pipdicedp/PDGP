@model TradeLicence.Models.FireApplicationVm
@using System.Linq
@using TradeLicence.Models.Caf
@using TradeLicence.Helpers

@*
    The applicant's Fire NOC landing / status page (FireClearanceController.Index).
    With nothing saved yet the controller redirects to Step 1; otherwise this
    shows where the application stands and what the applicant can do next.
*@

@{
    ViewData["Title"] = "Fire NOC Application";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var app = Model.Application;
    var preview = Model.Preview;

    var docs = FireFormMetadata.AllDocuments.Select(d => new CafDocumentVm
    {
        Def = d,
        SizeBytes = Model.DocumentSizes.TryGetValue(d.Column, out var len) ? len : null,
        ContentType = Model.DocumentTypes.TryGetValue(d.Column, out var type) ? type : null
    }).ToList();

    var nextStep = Model.Preview.Sections.FirstOrDefault(s => !s.HasRow)?.Step.Number
                   ?? FireFormMetadata.MinStep;

    var isReturned = FireStatusDisplay.IsReturned(app.Status);
    var isApproved = string.Equals(app.Status, "Approved", StringComparison.OrdinalIgnoreCase);
    var isDraft = string.IsNullOrEmpty(app.Status)
                  || string.Equals(app.Status, "Draft", StringComparison.OrdinalIgnoreCase);

    // Status and stage both come from FireStatusDisplay, so the badge and the
    // "Current Stage" row can never contradict each other (e.g. "Approved" next
    // to "Initial Scrutiny").
    var statusBadge = FireStatusDisplay.StatusBadge(app.Status);
    var statusLabel = FireStatusDisplay.StatusLabel(app.Status);
    var stageLabel = FireStatusDisplay.StageLabel(app.Status, app.CurrentStage);

    // The NOC template is chosen from the building classification saved on the
    // application (FireNocPdfService), so show the applicant which format they
    // will receive before they download it.
    var certificateClass = Model.Preview.Sections
        .SelectMany(s => s.Values)
        .Where(v => string.Equals(v.Key, "buildingclass", StringComparison.OrdinalIgnoreCase))
        .Select(v => v.Value)
        .FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

    var certificateFormat = string.IsNullOrWhiteSpace(certificateClass)
        ? "Fire Safety Clearance Certificate"
        : certificateClass.Contains("Educational", StringComparison.OrdinalIgnoreCase)
            ? "Educational Institution NOC"
            : "Industrial / Other Occupancy Clearance Certificate";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/caf_css/caf.css"
          asp-append-version="true" />
}

<div class="caf-wrapper">

    <header class="tl-form-masthead">

        <div class="tl-form-masthead-main">
            <p class="tl-form-govt">Government of Puducherry</p>
            <h1 class="tl-form-dept">Fire Service Department</h1>
            <p class="tl-form-doc">FIRE SAFETY CLEARANCE &mdash; APPLICATION STATUS</p>
        </div>

        <dl class="tl-form-meta">
            <div>
                <dt>Application No.</dt>
                <dd>@(string.IsNullOrEmpty(app.ApplicationCode) ? "Not assigned yet" : app.ApplicationCode)</dd>
            </div>
            <div>
                <dt>Applied On</dt>
                <dd>@(app.AppliedOn?.ToString("dd-MM-yyyy") ?? "—")</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd><span class="tl-form-status">@statusLabel</span></dd>
            </div>
        </dl>

    </header>

    @if (!string.IsNullOrEmpty(Model.Preview.SuccessMessage))
    {
        <div class="alert alert-success caf-alert alert-dismissible fade show" role="alert">
            @Model.Preview.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (isDraft)
    {
        <div class="alert alert-secondary caf-alert">
            <strong>Draft &mdash; not submitted.</strong>
            This application is still open. Continue where you left off and submit it
            when every section and the compulsory documents are complete.
        </div>
    }

    <fieldset class="tl-section">

        <legend>
            <i class="fa-solid fa-fire-flame-curved"></i>
            Application Status
        </legend>

        <div class="row">

            <div class="col-md-4 mb-3">
                <div class="caf-pv-label">Application Number</div>
                <div class="caf-pv-value">@(string.IsNullOrEmpty(Model.Application.ApplicationCode) ? "Not assigned yet" : Model.Application.ApplicationCode)</div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="caf-pv-label">Current Status</div>
                <div class="caf-pv-value">
                    <span class="badge @statusBadge">@statusLabel</span>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="caf-pv-label">Current Stage</div>
                <div class="caf-pv-value">@stageLabel</div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="caf-pv-label">Submitted On</div>
                <div class="caf-pv-value">
                    @(Model.Application.SubmittedDate.HasValue
                        ? Model.Application.SubmittedDate.Value.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")
                        : "Not submitted yet")
                </div>
            </div>

            @if (isDraft && Model.Application.ModifiedDate.HasValue)
            {
                <div class="col-md-4 mb-3">
                    <div class="caf-pv-label">Last Saved</div>
                    <div class="caf-pv-value">@Model.Application.ModifiedDate.Value.ToLocalTime().ToString("dd-MM-yyyy hh:mm tt")</div>
                </div>
            }

            <div class="col-md-4 mb-3">
                <div class="caf-pv-label">Applicant</div>
                <div class="caf-pv-value">@(string.IsNullOrEmpty(Model.Application.Name) ? "—" : Model.Application.Name)</div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="caf-pv-label">Mobile</div>
                <div class="caf-pv-value">@(string.IsNullOrEmpty(Model.Application.MobileNo) ? "—" : Model.Application.MobileNo)</div>
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Application.OfficerRemarks))
        {
            <div class="alert @(isReturned ? "alert-warning" : "alert-info") caf-alert mb-0">
                <strong>Remarks from the Fire Department:</strong>
                "@Model.Application.OfficerRemarks"
            </div>
        }

    </fieldset>

    @if (isApproved)
    {
        <section class="tl-cert-card" aria-label="Fire Safety No Objection Certificate">

            <div class="tl-cert-card-main">
                <p class="tl-cert-kicker">
                    <i class="fa-solid fa-circle-check"></i> Approved &mdash; certificate ready
                </p>
                <h3>Fire Safety No Objection Certificate</h3>
                <p class="tl-cert-card-meta">
                    Certificate format:
                    <span class="tl-cert-format">@certificateFormat</span>
                    @if (!string.IsNullOrWhiteSpace(certificateClass))
                    {
                        <span class="tl-cert-sep">&middot;</span>
                        <span>Building classification: @certificateClass</span>
                    }
                </p>
                <p class="tl-cert-card-note">
                    Digitally generated with the Department's certificate number and a QR code.
                    Download the PDF to save or print it.
                </p>
            </div>

            <a class="btn btn-success tl-cert-download"
               href="@Url.Action("Noc")">
                <i class="fa-solid fa-file-arrow-down"></i>
                Download NOC (PDF)
            </a>

        </section>
    }

    <div class="caf-actions">

        @if (Model.Preview.AllowEdit)
        {
            <a class="btn btn-primary"
               href="@Url.Action("Step", new { step = nextStep })">
                <i class="fa-solid fa-pen-to-square"></i>
                @(isDraft ? "Continue / Edit Draft" : "Edit Application")
            </a>

            <a class="btn btn-secondary"
               href="@Url.Action("Preview")">
                @(isDraft ? "Preview Draft" : "Preview & Submit")
            </a>

            @if (isReturned)
            {
                <form method="post"
                      action="@Url.Action("Resubmit")"
                      onsubmit="return confirm('Resubmit this application to the Fire Department?');">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="btn btn-success">
                        <i class="fa-solid fa-paper-plane"></i> Resubmit to Officer
                    </button>

                </form>
            }
        }
        else
        {
            <a class="btn btn-secondary"
               href="@Url.Action("Preview")">
                View Submitted Application
            </a>

            <a class="btn btn-primary"
               href="@Url.Action("Acknowledgement")">
                <i class="fa-solid fa-file-arrow-down"></i> Download Acknowledgement
            </a>
        }

    </div>

    <div class="row">
        <div class="col-12">
            <partial name="_FireDocuments" model="docs" />
        </div>
    </div>

    <partial name="~/Views/CommonApplicationForm/_CafPreviewSections.cshtml" model="Model.Preview" />

</div>
