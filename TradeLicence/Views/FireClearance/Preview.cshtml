@model TradeLicence.Models.Caf.CafPreviewViewModel
@using System.Collections.Generic
@using System.Linq
@using TradeLicence.Models.Caf
@using TradeLicence.Helpers

@*
    Fire NOC "Preview & Submit" screen. Reuses the CAF's read-only section
    renderer (_CafPreviewSections) and the CAF preview styling; the sections
    themselves come from FireFormMetadata via FireFormService.LoadPreviewAsync.
*@

@{
    ViewData["Title"] = "Fire NOC Application - " + FireFormMetadata.PreviewTitle;
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var documentSizes = ViewBag.DocumentSizes as Dictionary<string, long> ?? new Dictionary<string, long>();
    var documentTypes = ViewBag.DocumentTypes as Dictionary<string, string> ?? new Dictionary<string, string>();

    var docs = FireFormMetadata.AllDocuments.Select(d => new CafDocumentVm
    {
        Def = d,
        SizeBytes = documentSizes.TryGetValue(d.Column, out var len) ? len : null,
        ContentType = documentTypes.TryGetValue(d.Column, out var type) ? type : null
    }).ToList();

    // Draft and "returned for correction" are still the applicant's to edit;
    // anything else means the file has left their hands.
    var editable = Model.AllowEdit;
    var locked = !editable;
    var appStatus = ViewBag.ApplicationStatus as string ?? "Draft";
    var isDraft = string.Equals(appStatus, "Draft", StringComparison.OrdinalIgnoreCase);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/caf_css/caf.css"
          asp-append-version="true" />
}

<div class="caf-wrapper">

    <div class="caf-header">
        <h2>Fire NOC Application</h2>
        <p>Government of Puducherry — Fire Service Department</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success caf-alert alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger caf-alert">
            @Model.ErrorMessage
        </div>
    }

    <partial name="_FireStepper"
             model="new CafStepperVm
             {
                 AllSteps = Model.AllSteps,
                 CurrentNumber = FireFormMetadata.PreviewStep,
                 BasicDetailsExist = Model.BasicDetailsExist,
                 IsSubmitted = Model.IsSubmitted,
                 SavedSteps = Model.SavedSteps
             }" />

    @if (locked)
    {
        <div class="alert alert-info caf-alert">
            <strong>Application submitted.</strong>
            This is a read-only copy of what was submitted; it can no longer be edited here.
        </div>
    }
    else if (isDraft)
    {
        <div class="alert alert-secondary caf-alert">
            <strong>Draft &mdash; not submitted.</strong>
            Use <em>Edit</em> next to any section to change it. Nothing goes to the Fire
            Department until you click <strong>Submit Application</strong>.
        </div>
    }
    else if (!Model.IsComplete)
    {
        <div class="alert alert-warning caf-alert">
            <strong>Some sections are not saved yet.</strong>
            Complete and save them before you can submit:
            @foreach (var missing in Model.Sections.Where(s => !s.HasRow))
            {
                <a class="caf-pv-missing-link" href="@Url.Action("Step", new { step = missing.Step.Number })">@missing.Step.Title</a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info caf-alert">
            <strong>Please review your application.</strong>
            Check every section below. Use <em>Edit</em> to go back and change anything — nothing is submitted until you click <strong>Submit Application</strong>.
        </div>
    }

    <partial name="~/Views/CommonApplicationForm/_CafPreviewSections.cshtml" model="Model" />

    <partial name="_FireDocuments" model="docs" />

    <div class="caf-actions">

        @if (locked)
        {
            <a class="btn btn-secondary"
               href="@Url.Action("Index")">
                Back to Application Status
            </a>

            <a class="btn btn-primary"
               href="@Url.Action("Acknowledgement")">
                <i class="fa-solid fa-file-arrow-down"></i> Download Acknowledgement
            </a>
        }
        else
        {
            <a class="btn btn-secondary"
               href="@(Url.Action("Step", new { step = FireFormMetadata.MaxStep }))">
                &laquo; Back
            </a>

            <form method="post"
                  action="@(Url.Action("Submit"))"
                  id="fireSubmitForm">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-primary"
                        disabled="@(!Model.IsComplete)">
                    Submit Application
                </button>

            </form>
        }

    </div>

</div>
