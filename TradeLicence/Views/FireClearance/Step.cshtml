@model TradeLicence.Models.Caf.CafStepViewModel
@using System.Linq
@using TradeLicence.Models.Caf
@using TradeLicence.Helpers

@*
    Fire NOC wizard step — one page per step of FireFormMetadata. Same
    metadata-driven rendering as Views/CommonApplicationForm/Step.cshtml, but the
    step/field/document definitions come from FireFormMetadata and every step
    writes the same row of dbo.FireClearanceApplications (see FireFormService).
*@

@{
    ViewData["Title"] = "Fire NOC Application - " + Model.Current.Title;
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    // Fields of the current step, grouped into fieldsets by Section,
    // in the order each Section first appears in FireFormMetadata.
    var sections = Model.Current.Fields
        .GroupBy(f => f.Section)
        .ToList();

    // Sections are numbered across the whole application, not per page, so
    // "Section 3" means the same thing on every step and on the preview.
    var allSections = FireFormMetadata.Steps
        .SelectMany(s => s.Fields)
        .Select(f => f.Section)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .ToList();

    int SectionNo(string title) => allSections.IndexOf(title) + 1;

    var documentsSectionNo = allSections.Count + 1;

    string FileSize(long b) =>
        b >= 1048576 ? $"{b / 1048576.0:0.0} MB" : $"{Math.Max(1, b / 1024)} KB";

    string Val(string name) =>
        Model.Values.TryGetValue(name, out var v) ? (v ?? "") : "";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/caf_css/caf.css"
          asp-append-version="true" />
}

<div class="caf-wrapper">

    <header class="tl-form-masthead">

        <div class="tl-form-masthead-main">
            <p class="tl-form-govt">Government of Puducherry</p>
            <h1 class="tl-form-dept">Fire Service Department</h1>
            <p class="tl-form-doc">FORM OF APPLICATION FOR FIRE SAFETY CLEARANCE</p>
        </div>

        <dl class="tl-form-meta">
            <div>
                <dt>Application No.</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.ApplicationNo) ? "Not yet assigned" : Model.ApplicationNo)</dd>
            </div>
            <div>
                <dt>Application Date</dt>
                <dd>@(Model.AppliedOn?.ToString("dd-MM-yyyy") ?? "—")</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd><span class="tl-form-status">@FireStatusDisplay.StatusLabel(Model.ApplicationStatus ?? "Draft")</span></dd>
            </div>
        </dl>

    </header>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success caf-alert alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger caf-alert alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (FireStatusDisplay.IsReturned(Model.ApplicationStatus))
    {
        <div class="alert alert-warning caf-alert">
            <strong><i class="fa-solid fa-pen-to-square"></i> Returned for correction / modification.</strong>
            The Fire Department has asked for changes. <em>Every</em> section and every uploaded
            document on all steps is editable again &mdash; update what is needed, then resubmit
            from the Preview &amp; Submit tab.
            @if (!string.IsNullOrWhiteSpace(Model.OfficerRemarks))
            {
                <div class="mt-2"><strong>Remarks:</strong> &ldquo;@Model.OfficerRemarks&rdquo;</div>
            }
        </div>
    }

    <!-- Stepper: the three data-entry steps plus the Preview & Submit tab.
         The partial keeps the tab in step with the saved sections. -->
    <partial name="_FireStepper"
             model="new CafStepperVm
             {
                 AllSteps = Model.AllSteps,
                 CurrentNumber = Model.Current.Number,
                 BasicDetailsExist = Model.BasicDetailsExist,
                 IsSubmitted = Model.IsSubmitted,
                 SavedSteps = Model.SavedSteps
             }" />

    @{
        var progressPct = (int)System.Math.Round(Model.Current.Number * 100.0 / FireFormMetadata.MaxStep);
    }

    <div class="caf-progress">
        <div class="caf-progress-track"
             role="progressbar"
             aria-valuenow="@progressPct"
             aria-valuemin="0"
             aria-valuemax="100">
            <span style="width:@(progressPct)%"></span>
        </div>
        <p class="caf-progress-note">
            Step @Model.Current.Number of @FireFormMetadata.MaxStep
            <span class="caf-progress-sep">&middot;</span>
            <strong>@Model.Current.Title</strong>
        </p>
    </div>

    <div class="tl-form-sheet">

        <p class="tl-form-instructions">
            Sections are numbered in the order they appear in the application.
            Fields marked <span class="caf-required">*</span> are mandatory.
            Use <strong>Save as Draft</strong> to keep your progress at any time &mdash;
            nothing is sent to the Fire Department until you submit.
        </p>

        <form method="post"
              action="@(Url.Action("SaveStep", new { step = Model.Current.Number }))"
              id="fireStepForm"
              enctype="@(Model.Documents.Any() ? "multipart/form-data" : null)">

        @Html.AntiForgeryToken()

        @foreach (var group in sections)
        {
            var allFields = group.ToList();
            var secNo = SectionNo(group.Key);

            // Application Type is a form-level choice, not one of the 33%
            // input cells: its caption and the Registration / Renewal radios
            // sit above the grid, at the start of the section's inputs.
            var topChoices = allFields.Where(f => f.Type == CafFieldType.Radio).ToList();
            var fieldList = allFields.Where(f => f.Type != CafFieldType.Radio).ToList();

            <fieldset class="tl-form-section">

                <legend>
                    <span class="tl-form-section-no">@secNo</span>
                    <span>@group.Key</span>
                </legend>

                @foreach (var choice in topChoices)
                {
                    var choiceCurrent = Val(choice.Name);
                    var choiceOptions = choice.Options ?? Array.Empty<string>();

                    <div class="tl-form-apptype">
                        <span class="tl-form-apptype-label">
                            @choice.Label
                            @if (choice.Required)
                            {
                                <span class="caf-required">*</span>
                            }
                        </span>
                        <div class="caf-choice-row" role="radiogroup" aria-label="@choice.Label">
                            @foreach (var opt in choiceOptions)
                            {
                                var oPipe = opt.IndexOf('|');
                                var oValue = oPipe >= 0 ? opt[..oPipe] : opt;
                                var oLabel = oPipe >= 0 ? opt[(oPipe + 1)..] : opt;
                                var oChecked = string.Equals(oValue, choiceCurrent, StringComparison.OrdinalIgnoreCase);

                                <label class="caf-choice">
                                    <input type="radio"
                                           name="@choice.Name"
                                           value="@oValue"
                                           checked="@oChecked"
                                           required="@choice.Required" />
                                    <span>@oLabel</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                @* Every remaining field is one cell of the three-column grid,
                   so text areas and selects all share the same 33% width. Only
                   the fire-fighting checklist (nine checkboxes in one group)
                   spans the full sheet. *@
                <div class="tl-form-fields">

                @for (var i = 0; i < fieldList.Count; i++)
                {
                    var f = fieldList[i];

                    var wide = f.Type == CafFieldType.MultiSelect;

                    <div class="tl-form-row @(wide ? "tl-form-row-wide" : null)">

                        <span class="tl-form-no">@(secNo + "." + (i + 1))</span>

                        @if (f.Type == CafFieldType.Radio || f.Type == CafFieldType.MultiSelect)
                        {
                            @* A radio group / checkbox group is not a labelable control,
                               so its caption is a span rather than a <label for="...">. *@
                            <span class="caf-group-label">
                                @f.Label
                                @if (f.Required)
                                {
                                    <span class="caf-required">*</span>
                                }
                            </span>
                        }
                        else
                        {
                            <label for="fire_@f.Name">
                                @f.Label
                                @if (f.Required)
                                {
                                    <span class="caf-required">*</span>
                                }
                            </label>
                        }

                        <div class="tl-form-control">

                            @switch (f.Type)
                            {
                                case CafFieldType.TextArea:

                                    <textarea id="fire_@f.Name"
                                              name="@f.Name"
                                              class="form-control"
                                              rows="3"
                                              maxlength="@f.MaxLength"
                                              @(f.Required ? "required" : null)>@Val(f.Name)</textarea>

                                    break;

                                case CafFieldType.Number:

                                    <input id="fire_@f.Name"
                                           name="@f.Name"
                                           type="number"
                                           step="1"
                                           class="form-control"
                                           value="@Val(f.Name)"
                                           @(f.Required ? "required" : null) />

                                    break;

                                case CafFieldType.Decimal:

                                    <input id="fire_@f.Name"
                                           name="@f.Name"
                                           type="number"
                                           step="@f.DecimalStep"
                                           class="form-control"
                                           value="@Val(f.Name)"
                                           @(f.Required ? "required" : null) />

                                    break;

                                case CafFieldType.Date:

                                    <input id="fire_@f.Name"
                                           name="@f.Name"
                                           type="date"
                                           class="form-control"
                                           value="@Val(f.Name)"
                                           @(f.Required ? "required" : null) />

                                    break;

                                case CafFieldType.Email:

                                    <input id="fire_@f.Name"
                                           name="@f.Name"
                                           type="email"
                                           maxlength="@f.MaxLength"
                                           class="form-control"
                                           value="@Val(f.Name)"
                                           @(f.Required ? "required" : null) />

                                    break;

                                case CafFieldType.Radio:

                                    var radioCurrent = Val(f.Name);
                                    var radioOptions = f.Options ?? Array.Empty<string>();

                                    <div class="caf-choice-row" role="radiogroup">

                                        @foreach (var opt in radioOptions)
                                        {
                                            var rPipe = opt.IndexOf('|');
                                            var rValue = rPipe >= 0 ? opt[..rPipe] : opt;
                                            var rLabel = rPipe >= 0 ? opt[(rPipe + 1)..] : opt;
                                            var rChecked = string.Equals(rValue, radioCurrent, StringComparison.OrdinalIgnoreCase);

                                            <label class="caf-choice">
                                                <input type="radio"
                                                       name="@f.Name"
                                                       value="@rValue"
                                                       checked="@rChecked"
                                                       required="@f.Required" />
                                                <span>@rLabel</span>
                                            </label>
                                        }

                                    </div>

                                    break;

                                case CafFieldType.MultiSelect:

                                    var multiCurrent = Val(f.Name);
                                    var multiSelected = multiCurrent
                                        .Split(',')
                                        .Select(v => v.Trim())
                                        .Where(v => v.Length > 0)
                                        .ToList();

                                    <div class="caf-check-grid">

                                        @foreach (var opt in f.Options ?? Array.Empty<string>())
                                        {
                                            var mPipe = opt.IndexOf('|');
                                            var mValue = mPipe >= 0 ? opt[..mPipe] : opt;
                                            var mLabel = mPipe >= 0 ? opt[(mPipe + 1)..] : opt;

                                            <label class="caf-check">
                                                <input type="checkbox"
                                                       name="@f.Name"
                                                       value="@mValue"
                                                       checked="@multiSelected.Contains(mValue)" />
                                                <span>@mLabel</span>
                                            </label>
                                        }

                                    </div>

                                    <p class="caf-check-hint">Tick every fire-fighting system available at the premises.</p>

                                    break;

                                case CafFieldType.Select:
                                case CafFieldType.YesNo:

                                    var current = Val(f.Name);

                                    <select id="fire_@f.Name"
                                            name="@f.Name"
                                            class="form-control"
                                            @(f.Required ? "required" : null)>

                                        <option value="">
                                            -- Please Select --
                                        </option>

                                        @{
                                            var optionValues = (f.Options ?? Array.Empty<string>())
                                                .Select(o => o.IndexOf('|') >= 0 ? o[..o.IndexOf('|')] : o)
                                                .ToList();
                                        }

                                        @* A value saved before the option list changed must not
                                           silently disappear from the dropdown. *@
                                        @if (!string.IsNullOrWhiteSpace(current) && !optionValues.Contains(current))
                                        {
                                            <option value="@current" selected>@current (saved)</option>
                                        }

                                        @foreach (var opt in f.Options ?? Array.Empty<string>())
                                        {
                                            var pipe = opt.IndexOf('|');

                                            var optValue = pipe >= 0
                                                ? opt[..pipe]
                                                : opt;

                                            var optLabel = pipe >= 0
                                                ? opt[(pipe + 1)..]
                                                : opt;

                                            if (optValue == current)
                                            {
                                                <option value="@optValue" selected>
                                                    @optLabel
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@optValue">
                                                    @optLabel
                                                </option>
                                            }
                                        }

                                    </select>

                                    break;

                                default:

                                    <input id="fire_@f.Name"
                                           name="@f.Name"
                                           type="text"
                                           class="form-control"
                                           maxlength="@f.MaxLength"
                                           value="@Val(f.Name)"
                                           @(f.Required ? "required" : null) />

                                    break;
                            }

                        </div>

                    </div>
                }

                </div>

            </fieldset>
        }

        @if (Model.Documents.Any())
        {
            <fieldset class="tl-form-section caf-documents">

                <legend>
                    <span class="tl-form-section-no">@documentsSectionNo</span>
                    <span>Upload Documents</span>
                </legend>

                <p class="tl-note">
                    Accepted: PDF, JPG or PNG, up to 5 MB per file. A document you uploaded
                    earlier is kept unless you choose a new file for it. Saving this step
                    takes you to the preview, where you review everything and submit.
                    @{
                        var requiredLabels = Model.Documents.Where(d => d.Def.Required).Select(d => d.Def.Label).ToList();
                    }
                    @if (requiredLabels.Count == 1)
                    {
                        <text>Only <strong>@requiredLabels[0]</strong> is compulsory.</text>
                    }
                    else if (requiredLabels.Count > 1)
                    {
                        <text>Compulsory: <strong>@string.Join(" and ", requiredLabels)</strong>.</text>
                    }
                </p>

                @foreach (var docGroup in Model.Documents.GroupBy(d => string.IsNullOrWhiteSpace(d.Def.Group) ? "Documents" : d.Def.Group))
                {
                    var groupDocs = docGroup.ToList();
                    var groupDone = groupDocs.Count(d => d.HasFile);

                    <div class="caf-pv-group-title">
                        @docGroup.Key
                        <span class="caf-pv-chip @(groupDone == groupDocs.Count ? "caf-pv-chip-ok" : "caf-pv-chip-missing")">
                            @groupDone of @groupDocs.Count
                        </span>
                    </div>

                    <div class="tl-grid-2">

                        @foreach (var d in groupDocs)
                        {
                            <div class="form-group caf-doc">

                                <label for="fire_doc_@d.Def.Column">
                                    @d.Def.Label
                                    @if (d.Def.Required)
                                    {
                                        <span class="caf-required">*</span>
                                    }
                                </label>

                                <input id="fire_doc_@d.Def.Column"
                                       name="@d.Def.Column"
                                       type="file"
                                       accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"
                                       class="form-control caf-file-input" />

                                <div class="caf-doc-status">
                                    @if (d.HasFile)
                                    {
                                        <span class="caf-doc-uploaded">
                                            &#10003; Uploaded (@FileSize(d.SizeBytes!.Value))
                                        </span>
                                        <a href="@Url.Action("Document", new { column = d.Def.Column })" target="_blank">View</a>
                                    }
                                    else
                                    {
                                        <span class="caf-doc-missing">Not uploaded</span>
                                    }
                                </div>

                                @if (d.IsImage)
                                {
                                    <a class="caf-doc-thumb caf-doc-thumb-inline"
                                       href="@Url.Action("Document", new { column = d.Def.Column })"
                                       target="_blank" rel="noopener">
                                        <img src="@Url.Action("Document", new { column = d.Def.Column })"
                                             alt="@d.Def.Label" loading="lazy" />
                                    </a>
                                }

                            </div>
                        }

                    </div>
                }

            </fieldset>
        }

        @if (Model.Current.Key == "documents" && Model.Review != null)
        {
            var savedSections = Model.Review.Sections.Count(s => s.HasRow);
            var totalSections = Model.Review.Sections.Count;

            <section class="tl-form-review">

                <div class="tl-review-head">
                    <h3>Review &amp; Submit</h3>
                    <p>
                        @savedSections of @totalSections sections have data.
                        Nothing is sent to the department until you submit from the preview.
                    </p>
                </div>

                <ul class="tl-review-list">

                    @foreach (var s in Model.Review.Sections)
                    {
                        <li class="tl-review-item">

                            <span class="tl-review-no">@s.Step.Number</span>

                            <span class="tl-review-title">@s.Step.Title</span>

                            <span class="tl-review-chip @(s.HasRow ? "tl-review-chip-ok" : "tl-review-chip-missing")">
                                @(s.HasRow ? "Saved" : "Not filled")
                            </span>

                            <a class="tl-review-edit"
                               href="@Url.Action("Step", new { step = s.Step.Number })">
                                @(s.HasRow ? "Edit" : "Fill in")
                            </a>

                        </li>
                    }

                </ul>

                <a class="btn btn-secondary tl-review-open"
                   href="@Url.Action("Preview")">
                    Open full preview
                </a>

            </section>
        }

        @if (Model.Current.Key == "documents")
        {
            <section class="tl-form-declaration">

                <h3>Declaration</h3>

                <p class="tl-declaration-text">
                    I hereby declare that the particulars furnished in this application are true,
                    complete and correct to the best of my knowledge and belief, and that the
                    building and its fire protection arrangements comply with the National Building
                    Code of India (NBC-2016) and the rules in force. I understand that any false
                    statement or suppression of fact may lead to rejection of this application,
                    cancellation of the clearance and action under the law.
                </p>

                <label class="caf-check">
                    <input type="checkbox" name="declaration" value="yes" required />
                    <span>I have read and agree to the declaration above.</span>
                </label>

                <p class="tl-form-signature">
                    Date: <strong>@DateTime.Now.ToString("dd-MM-yyyy")</strong>
                </p>

            </section>
        }

        <div class="caf-actions">

            @if (Model.Current.Number > FireFormMetadata.MinStep)
            {
                <a class="btn btn-secondary"
                   href="@(Url.Action("Step", new { step = Model.Current.Number - 1 }))">
                    &laquo; Back
                </a>
            }

            @* Order matters for the keyboard: "Save & Next" is the first submit
               button, so pressing Enter in a field advances the wizard. The draft
               button is last in the DOM and pulled to its left with flexbox. *@
            <button type="submit"
                    class="btn btn-primary caf-next-btn">
                @(Model.Current.Key == "documents" ? "Save & Preview" : "Save & Next")
            </button>

            <button type="submit"
                    name="saveMode"
                    value="draft"
                    class="btn btn-outline-primary caf-draft-btn"
                    formnovalidate>
                <i class="fa-regular fa-floppy-disk"></i> Save as Draft
            </button>

        </div>

        </form>

    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/caf_js/caf.js" asp-append-version="true"></script>
}
