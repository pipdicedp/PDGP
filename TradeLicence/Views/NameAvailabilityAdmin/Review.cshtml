@model TradeLicence.Models.NameAvailabilityBase
@{
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";

    var entityType = (ViewData["EntityType"] as string) ?? "Society";
    var entityPlural = (ViewData["EntityPlural"] as string) ?? (entityType == "Firm" ? "Firms" : "Societies");
    var queueAction = entityType == "Firm" ? "Firms" : "Society";
    ViewData["Title"] = $"Review - Name Availability of {entityPlural}";

    var row = Model!;
    var isPending = string.Equals(row.Status, "Pending", StringComparison.OrdinalIgnoreCase);
    var proposed = row.ProposedNames;
    var badge = (row.Status ?? "Pending").ToLower();
}

<style>
    .naa-page { padding: 22px 26px 40px; }
    .naa-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .naa-head h2 { margin: 0; font-size: 19px; color: #1f4e79; font-weight: 700; }
    .naa-head .sub { font-size: 12px; color: #666; margin-top: 3px; }
    .naa-back { display: inline-block; padding: 7px 14px; border: 1px solid #cfdde9; border-radius: 3px; background: #f8fbfe; color: #1f4e79; font-size: 12px; text-decoration: none; }
    .naa-back:hover { background: #eef4fa; color: #1f4e79; text-decoration: none; }
    .naa-cols { display: flex; flex-wrap: wrap; gap: 18px; align-items: flex-start; }
    .naa-col { flex: 1 1 420px; min-width: 320px; }
    .naa-panel { background: #fff; border: 1px solid #cfdde9; border-radius: 6px; box-shadow: 0 1px 3px rgba(0,0,0,.05); overflow: hidden; margin-bottom: 18px; }
    .naa-panel-head { background: #1f4e79; color: #fff; padding: 11px 16px; font-size: 13px; font-weight: 700; }
    .naa-panel-body { padding: 14px 16px 16px; }
    .naa-kv { display: flex; gap: 8px; font-size: 12px; padding: 5px 0; border-bottom: 1px dashed #edf1f5; }
    .naa-kv:last-child { border-bottom: none; }
    .naa-kv .k { flex: 0 0 150px; color: #666; }
    .naa-kv .v { flex: 1 1 auto; color: #222; font-weight: 600; word-break: break-word; }
    .naa-docs a { display: inline-block; margin: 0 10px 4px 0; color: #337ab7; text-decoration: underline; font-size: 12px; }
    .naa-choice { display: flex; align-items: flex-start; gap: 9px; border: 1px solid #e2eaf2; border-radius: 4px; padding: 10px 12px; margin-bottom: 8px; background: #fafcfe; cursor: pointer; font-size: 13px; }
    .naa-choice:hover { border-color: #9dc3e0; background: #f3f9ff; }
    .naa-choice input { margin-top: 3px; }
    .naa-choice .idx { color: #888; font-size: 11px; }
    .naa-field { margin-bottom: 12px; }
    .naa-field label { display: block; font-size: 12px; font-weight: 700; color: #333; margin-bottom: 5px; }
    .naa-field textarea { width: 100%; min-height: 70px; border: 1px solid #c6d4e1; border-radius: 3px; padding: 7px 9px; font-size: 12px; resize: vertical; }
    .naa-field textarea:focus { outline: none; border-color: #337ab7; box-shadow: 0 0 3px rgba(51,122,183,.4); }
    .naa-btns { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 14px; }
    .naa-btn { border: none; border-radius: 3px; padding: 9px 18px; font-size: 12px; font-weight: 700; cursor: pointer; }
    .naa-btn.approve { background: #2e7d32; color: #fff; }
    .naa-btn.approve:hover { background: #256428; }
    .naa-btn.reject { background: #c62828; color: #fff; }
    .naa-btn.reject:hover { background: #a31f1f; }
    .naa-badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 11px; font-weight: 700; border: 1px solid; }
    .naa-badge.pending { background: #fff5e5; color: #a35f00; border-color: #f0cf94; }
    .naa-badge.approved { background: #e8f5e9; color: #2e7d32; border-color: #b7dfb9; }
    .naa-badge.rejected { background: #fdecea; color: #c62828; border-color: #f3b9b4; }
    .naa-alert { padding: 10px 14px; border-radius: 4px; font-size: 12px; margin-bottom: 14px; }
    .naa-alert.ok { background: #e8f5e9; border: 1px solid #b7dfb9; color: #2e7d32; }
    .naa-alert.err { background: #fdecea; border: 1px solid #f3b9b4; color: #c62828; }
    .naa-approved { background: #e8f5e9; border: 1px solid #b7dfb9; border-radius: 4px; padding: 12px 14px; font-size: 13px; color: #1b5e20; }
    .naa-approved strong { font-size: 15px; }
</style>

<div class="naa-page">
    <div class="naa-head">
        <div>
            <h2>Review — @entityPlural Name Availability (Ref. No: @row.Id)</h2>
            <div class="sub">Approve one of the proposed names below; the decision is sent to the applicant.</div>
        </div>
        <a asp-action="@queueAction" asp-route-status="Pending" class="naa-back">&larr; Back to queue</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="naa-alert ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="naa-alert err">@TempData["Error"]</div>
    }

    <div class="naa-cols">

        <!-- Applicant details -->
        <div class="naa-col">
            <div class="naa-panel">
                <div class="naa-panel-head">Applicant Details</div>
                <div class="naa-panel-body">
                    <div class="naa-kv"><span class="k">Applicant Name</span><span class="v">@row.ApplicantName</span></div>
                    <div class="naa-kv"><span class="k">Address</span><span class="v">@row.ApplicantAddress</span></div>
                    <div class="naa-kv"><span class="k">Mobile No</span><span class="v">@row.MobileNo</span></div>
                    <div class="naa-kv"><span class="k">Email Id</span><span class="v">@row.Email</span></div>
                    <div class="naa-kv"><span class="k">Purpose</span><span class="v">@(string.IsNullOrWhiteSpace(row.Purpose) ? "-" : row.Purpose)</span></div>
                    <div class="naa-kv"><span class="k">In Consonance with Objects</span><span class="v">@(row.InConsonanceWithObjects == true ? "Yes" : "No")</span></div>
                    <div class="naa-kv"><span class="k">NOC Attached</span><span class="v">@(row.NocAttached == true ? "Yes" : "No")</span></div>
                    <div class="naa-kv"><span class="k">Emblems Act Compliant</span><span class="v">@(row.EmblemsActCompliant == true ? "Yes" : "No")</span></div>
                    <div class="naa-kv"><span class="k">Submitted On</span><span class="v">@row.CreatedOn.ToString("dd-MM-yyyy HH:mm")</span></div>
                    <div class="naa-kv">
                        <span class="k">Current Status</span>
                        <span class="v"><span class="naa-badge @badge">@(row.Status ?? "Pending")</span></span>
                    </div>
                </div>
            </div>

            <div class="naa-panel">
                <div class="naa-panel-head">Uploaded Documents</div>
                <div class="naa-panel-body naa-docs">
                    @if (!string.IsNullOrWhiteSpace(row.IdentityProofPath))
                    {
                        <a href="@row.IdentityProofPath" target="_blank">Identity Proof</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(row.SignatureProofPath))
                    {
                        <a href="@row.SignatureProofPath" target="_blank">Signature Proof</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(row.NocPath))
                    {
                        <a href="@row.NocPath" target="_blank">NOC</a>
                    }
                    @if (string.IsNullOrWhiteSpace(row.IdentityProofPath) && string.IsNullOrWhiteSpace(row.SignatureProofPath) && string.IsNullOrWhiteSpace(row.NocPath))
                    {
                        <span style="color:#777;font-size:12px;">No documents uploaded.</span>
                    }
                </div>
            </div>
        </div>

        <!-- Decision -->
        <div class="naa-col">
            <div class="naa-panel">
                <div class="naa-panel-head">Proposed Names — approve one</div>
                <div class="naa-panel-body">
                    @if (!isPending)
                    {
                        <div class="naa-approved">
                            <div style="margin-bottom:6px;">Decision recorded: <strong>@(row.Status ?? "-")</strong></div>
                            @if (!string.IsNullOrWhiteSpace(row.ApprovedName))
                            {
                                <div>Approved Name: <strong>@row.ApprovedName</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.AdminRemarks))
                            {
                                <div style="margin-top:6px;font-weight:400;">Remarks: @row.AdminRemarks</div>
                            }
                            <div style="margin-top:6px;font-size:11px;color:#4b7a4e;">
                                By @(string.IsNullOrWhiteSpace(row.ApprovedBy) ? "-" : row.ApprovedBy)
                                on @(row.ApprovedOn?.ToString("dd-MM-yyyy HH:mm") ?? "-")
                            </div>
                        </div>
                    }
                    else if (proposed.Count == 0)
                    {
                        <div style="color:#c62828;font-size:12px;">This request has no proposed names on record.</div>
                    }
                    else
                    {
                        <form asp-action="Approve" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="type" value="@entityType" />
                            <input type="hidden" name="id" value="@row.Id" />

                            @{ var n = 1; }
                            @foreach (var name in proposed)
                            {
                                <label class="naa-choice">
                                    <input type="radio" name="selectedName" value="@name" required />
                                    <span><span class="idx">@(n).</span> @name</span>
                                </label>
                                n++;
                            }

                            <div class="naa-field" style="margin-top:14px;">
                                <label for="remarks">Remarks to applicant (optional for approval, required for rejection)</label>
                                <textarea id="remarks" name="remarks" placeholder="Remarks..."></textarea>
                            </div>

                            <div class="naa-btns">
                                <button type="submit" class="naa-btn approve" formaction="@Url.Action("Approve", "NameAvailabilityAdmin")">
                                    Approve Selected Name &amp; Send to Applicant
                                </button>
                                <button type="submit" class="naa-btn reject" formnovalidate
                                        formaction="@Url.Action("Reject", "NameAvailabilityAdmin")"
                                        onclick="return confirm('Reject this request? The remarks will be sent to the applicant.');">
                                    Reject Request
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
