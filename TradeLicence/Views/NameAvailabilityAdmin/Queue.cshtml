@model IEnumerable<TradeLicence.Models.NameAvailabilityBase>
@{
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";

    var entityType = (ViewData["EntityType"] as string) ?? "Society";
    var entityPlural = (ViewData["EntityPlural"] as string) ?? (entityType == "Firm" ? "Firms" : "Societies");
    var statusFilter = (ViewData["StatusFilter"] as string) ?? "Pending";
    ViewData["Title"] = $"Name Availability of {entityPlural}";

    var rows = Model?.ToList() ?? new List<TradeLicence.Models.NameAvailabilityBase>();
    var queueAction = entityType == "Firm" ? "Firms" : "Society";

    int total = ViewBag.Total ?? 0;
    int pending = ViewBag.Pending ?? 0;
    int approved = ViewBag.Approved ?? 0;
    int rejected = ViewBag.Rejected ?? 0;

    Func<string, string> tabClass = s =>
        string.Equals(statusFilter, s, StringComparison.OrdinalIgnoreCase) ? "naa-tab active" : "naa-tab";
}

<style>
    .naa-page { padding: 22px 26px 40px; }
    .naa-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .naa-head h2 { margin: 0; font-size: 19px; color: #1f4e79; font-weight: 700; }
    .naa-head .sub { font-size: 12px; color: #666; margin-top: 3px; }
    .naa-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
    .naa-tab { display: inline-block; padding: 7px 14px; border: 1px solid #cfdde9; border-radius: 3px; background: #f8fbfe; color: #1f4e79; font-size: 12px; text-decoration: none; }
    .naa-tab:hover { background: #eef4fa; text-decoration: none; color: #1f4e79; }
    .naa-tab.active { background: #337ab7; border-color: #337ab7; color: #fff; font-weight: 700; }
    .naa-panel { background: #fff; border: 1px solid #cfdde9; border-radius: 6px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
    .naa-table-wrap { overflow-x: auto; }
    .naa-table { width: 100%; border-collapse: collapse; font-size: 12px; min-width: 980px; }
    .naa-table th { background: #eef4fa; color: #1f4e79; text-align: left; padding: 10px 9px; border-bottom: 2px solid #337ab7; white-space: nowrap; font-size: 11px; text-transform: uppercase; letter-spacing: .3px; }
    .naa-table td { padding: 9px; border-bottom: 1px solid #ececec; vertical-align: top; }
    .naa-table tbody tr:nth-child(even) { background: #fafcfe; }
    .naa-table tbody tr:hover { background: #f2f8ff; }
    .naa-names { margin: 0; padding-left: 16px; }
    .naa-names li { margin: 0 0 1px; }
    .naa-badge { display: inline-block; padding: 2px 9px; border-radius: 10px; font-size: 10px; font-weight: 700; border: 1px solid; }
    .naa-badge.pending { background: #fff5e5; color: #a35f00; border-color: #f0cf94; }
    .naa-badge.approved { background: #e8f5e9; color: #2e7d32; border-color: #b7dfb9; }
    .naa-badge.rejected { background: #fdecea; color: #c62828; border-color: #f3b9b4; }
    .naa-link { color: #337ab7; font-weight: 700; text-decoration: none; white-space: nowrap; }
    .naa-link:hover { text-decoration: underline; }
    .naa-empty { text-align: center; padding: 40px 12px; color: #777; font-size: 12px; }
    .naa-alert { padding: 10px 14px; border-radius: 4px; font-size: 12px; margin-bottom: 14px; }
    .naa-alert.ok { background: #e8f5e9; border: 1px solid #b7dfb9; color: #2e7d32; }
    .naa-alert.err { background: #fdecea; border: 1px solid #f3b9b4; color: #c62828; }
</style>

<div class="naa-page">
    <div class="naa-head">
        <div>
            <h2>Name Availability of @entityPlural</h2>
            <div class="sub">Review the applicant's proposed names and approve one.</div>
        </div>
        <div>
            <a asp-action="Index" class="naa-tab">&larr; Admin Home</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="naa-alert ok">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="naa-alert err">@TempData["Error"]</div>
    }

    <div class="naa-tabs">
        <a asp-action="@queueAction" asp-route-status="Pending" class="@tabClass("Pending")">Pending (@pending)</a>
        <a asp-action="@queueAction" asp-route-status="Approved" class="@tabClass("Approved")">Approved (@approved)</a>
        <a asp-action="@queueAction" asp-route-status="Rejected" class="@tabClass("Rejected")">Rejected (@rejected)</a>
        <a asp-action="@queueAction" asp-route-status="All" class="@tabClass("All")">All (@total)</a>
    </div>

    <div class="naa-panel">
        @if (rows.Count == 0)
        {
            <div class="naa-empty">No @entityType.ToLower() name availability requests @(string.Equals(statusFilter, "All", StringComparison.OrdinalIgnoreCase) ? "found" : "with status \"" + statusFilter + "\"").</div>
        }
        else
        {
            <div class="naa-table-wrap">
                <table class="naa-table">
                    <thead>
                        <tr>
                            <th>S.No</th>
                            <th>Ref. No</th>
                            <th>Applicant</th>
                            <th>Mobile</th>
                            <th>Email</th>
                            <th>Proposed Names</th>
                            <th>Submitted On</th>
                            <th>Status</th>
                            <th>Approved Name</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 1; }
                        @foreach (var row in rows)
                        {
                            var badge = (row.Status ?? "Pending").ToLower();
                            <tr>
                                <td>@i</td>
                                <td>@row.Id</td>
                                <td>@row.ApplicantName</td>
                                <td style="white-space:nowrap;">@row.MobileNo</td>
                                <td>@row.Email</td>
                                <td>
                                    <ol class="naa-names">
                                        @foreach (var name in row.ProposedNames)
                                        {
                                            <li>@name</li>
                                        }
                                    </ol>
                                </td>
                                <td style="white-space:nowrap;">@row.CreatedOn.ToString("dd-MM-yyyy HH:mm")</td>
                                <td><span class="naa-badge @badge">@(row.Status ?? "Pending")</span></td>
                                <td>@(string.IsNullOrWhiteSpace(row.ApprovedName) ? "-" : row.ApprovedName)</td>
                                <td>
                                    <a class="naa-link" asp-action="Review" asp-route-type="@entityType" asp-route-id="@row.Id">
                                        @(string.Equals(row.Status, "Pending", StringComparison.OrdinalIgnoreCase) ? "Review" : "View")
                                    </a>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
