@{
    Layout = "~/Views/Shared/_OfficerLayout.cshtml";
    ViewData["Title"] = "Name Availability - Admin";

    int sTotal = ViewBag.SocietyTotal ?? 0;
    int sPending = ViewBag.SocietyPending ?? 0;
    int sApproved = ViewBag.SocietyApproved ?? 0;
    int sRejected = ViewBag.SocietyRejected ?? 0;

    int fTotal = ViewBag.FirmTotal ?? 0;
    int fPending = ViewBag.FirmPending ?? 0;
    int fApproved = ViewBag.FirmApproved ?? 0;
    int fRejected = ViewBag.FirmRejected ?? 0;
}

<style>
    .naa-page { padding: 22px 26px 40px; }
    .naa-head { margin-bottom: 18px; }
    .naa-head h2 { margin: 0 0 4px; font-size: 20px; color: #1f4e79; font-weight: 700; }
    .naa-head p { margin: 0; font-size: 12px; color: #666; }
    .naa-grid { display: flex; flex-wrap: wrap; gap: 20px; }
    .naa-card { flex: 1 1 380px; max-width: 560px; border: 1px solid #cfdde9; border-radius: 6px; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.06); overflow: hidden; }
    .naa-card-head { background: #1f4e79; color: #fff; padding: 13px 18px; font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 9px; }
    .naa-card-body { padding: 16px 18px 18px; }
    .naa-stats { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; }
    .naa-stat { flex: 1 1 90px; border: 1px solid #e2eaf2; border-radius: 4px; padding: 10px 8px; text-align: center; background: #f8fbfe; }
    .naa-stat .n { display: block; font-size: 20px; font-weight: 700; color: #1f4e79; line-height: 1.15; }
    .naa-stat .l { display: block; font-size: 10px; color: #666; text-transform: uppercase; letter-spacing: .3px; margin-top: 2px; }
    .naa-stat.pending .n { color: #b26a00; }
    .naa-stat.approved .n { color: #2e7d32; }
    .naa-stat.rejected .n { color: #c62828; }
    .naa-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .naa-btn { display: inline-block; background: #337ab7; color: #fff; border: none; padding: 8px 16px; border-radius: 3px; font-size: 12px; text-decoration: none; cursor: pointer; }
    .naa-btn:hover { background: #286090; color: #fff; text-decoration: none; }
    .naa-btn.secondary { background: #eef4fa; color: #1f4e79; border: 1px solid #b9d0e4; }
    .naa-btn.secondary:hover { background: #dfeaf5; color: #1f4e79; }
</style>

<div class="naa-page">
    <div class="naa-head">
        <h2>Name Availability — Administrator</h2>
        <p>Select a service to review the applicant's proposed names. Approve one name per request and it is sent back to the applicant.</p>
    </div>

    <div class="naa-grid">

        <div class="naa-card">
            <div class="naa-card-head">
                <i class="fa-solid fa-building-columns"></i>
                Name Availability of Societies
            </div>
            <div class="naa-card-body">
                <div class="naa-stats">
                    <div class="naa-stat pending"><span class="n">@sPending</span><span class="l">Pending</span></div>
                    <div class="naa-stat approved"><span class="n">@sApproved</span><span class="l">Approved</span></div>
                    <div class="naa-stat rejected"><span class="n">@sRejected</span><span class="l">Rejected</span></div>
                    <div class="naa-stat"><span class="n">@sTotal</span><span class="l">Total</span></div>
                </div>
                <div class="naa-actions">
                    <a asp-action="Society" asp-route-status="Pending" class="naa-btn">Review Pending (@sPending)</a>
                    <a asp-action="Society" asp-route-status="All" class="naa-btn secondary">All Society Requests</a>
                </div>
            </div>
        </div>

        <div class="naa-card">
            <div class="naa-card-head">
                <i class="fa-solid fa-briefcase"></i>
                Name Availability of Firms
            </div>
            <div class="naa-card-body">
                <div class="naa-stats">
                    <div class="naa-stat pending"><span class="n">@fPending</span><span class="l">Pending</span></div>
                    <div class="naa-stat approved"><span class="n">@fApproved</span><span class="l">Approved</span></div>
                    <div class="naa-stat rejected"><span class="n">@fRejected</span><span class="l">Rejected</span></div>
                    <div class="naa-stat"><span class="n">@fTotal</span><span class="l">Total</span></div>
                </div>
                <div class="naa-actions">
                    <a asp-action="Firms" asp-route-status="Pending" class="naa-btn">Review Pending (@fPending)</a>
                    <a asp-action="Firms" asp-route-status="All" class="naa-btn secondary">All Firm Requests</a>
                </div>
            </div>
        </div>

    </div>
</div>
