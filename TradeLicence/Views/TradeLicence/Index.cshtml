@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
    var myApplications = (List<TradeLicence.Models.TradeLicenceApplication>)ViewBag.MyApplications;

    // A user with anything other than Rejected already has a "live"
    // application (Draft to finish, one pending with an officer, or an
    // Approved licence) — same rule as the server-side check in
    // TradeLicenceController.Apply(). All-Rejected or no applications
    // at all = free to start a fresh one.
    var hasActiveApplication = myApplications != null && myApplications.Any(a => a.Status != "Rejected");
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/tl_css/dashboard.css"
          asp-append-version="true" />
}
<div class="dashboard-body">

    @* ===== NEW: Your Applications — only shows if the user has any ===== *@
    @if (myApplications != null && myApplications.Any())
    {
        <div class="dashboard-banner">
            <div class="dashboard-banner-text">
                <span class="dashboard-banner-icon">📄</span>
                <div>
                    <h3>Your Applications</h3>
                    <p>Continue a draft, or check the status of a submitted application.</p>
                </div>
            </div>
        </div>

        <div class="myapps-list">
            @foreach (var app in myApplications)
            {
                var statusClass = app.Status switch
                {
                    "Draft" => "myapps-status-draft",
                    "Submitted" => app.CurrentStage == "Initial Scrutiny" ? "myapps-status-submitted" : "myapps-status-review",
                    "ReturnedToApplicant" => "myapps-status-rejected",
                    "Approved" => "myapps-status-approved",
                    "Rejected" => "myapps-status-rejected",
                    _ => "myapps-status-draft"
                };
                var statusText = app.Status switch
                {
                    "Submitted" => app.CurrentStage == "Initial Scrutiny" ? "Submitted" : $"In Progress — {app.CurrentStage}",
                    "ReturnedToApplicant" => "Returned for Correction",
                    _ => app.Status
                };
                var rowAccentClass = app.Status switch
                {
                    "Draft" => "myapps-row-draft",
                    "Submitted" => app.CurrentStage == "Initial Scrutiny" ? "myapps-row-submitted" : "myapps-row-review",
                    "ReturnedToApplicant" => "myapps-row-rejected",
                    "Approved" => "myapps-row-approved",
                    "Rejected" => "myapps-row-rejected",
                    _ => "myapps-row-draft"
                };

                <div class="myapps-row @rowAccentClass">
                    <div class="myapps-info">
                        <span class="myapps-name">@(string.IsNullOrEmpty(app.ApplicantName) ? "Untitled application" : app.ApplicantName)</span>
                        <span class="myapps-meta">
                            @(app.ApplicationNumber ?? "No application number yet")
                            &bull; Started @app.CreatedDate.ToLocalTime().ToString("dd-MM-yyyy")
                        </span>
                        @if (app.Status == "ReturnedToApplicant" && !string.IsNullOrWhiteSpace(app.OfficerRemarks))
                        {
                            <span class="myapps-remarks">Officer's note: "@app.OfficerRemarks"</span>
                        }
                    </div>
                    <span class="myapps-status-badge @statusClass">@statusText</span>
                    @if (app.Status == "Draft")
                    {
                        <a class="myapps-btn" href="@Url.Action("Apply", "TradeLicence", new { id = app.ApplicationId })">Continue</a>
                    }
                    else if (app.Status == "ReturnedToApplicant")
                    {
                        <a class="myapps-btn" href="@Url.Action("Apply", "TradeLicence", new { id = app.ApplicationId })">Correct &amp; Resubmit</a>
                    }
                    else if (app.Status == "Approved" && app.IsCertificateDownloaded)
                    {
                        <span class="myapps-downloaded" style="color:#1a7f4b;font-weight:600;font-size:13px;white-space:nowrap;">
                            <i class="fas fa-check-circle"></i>
                            Downloaded on @(app.CertificateDownloadedDate?.ToString("dd-MM-yyyy") ?? "-")
                        </span>
                    }
                    else if (app.Status == "Approved")
                    {
                        <a class="myapps-btn myapps-btn-view" href="@Url.Action("DownloadCertificate", "TradeLicence", new { id = app.ApplicationId })">
                            <i class="fas fa-download"></i> Download Certificate
                        </a>
                    }
                    else
                    {
                        <a class="myapps-btn myapps-btn-view" href="@Url.Action("Confirmation", "TradeLicence", new { id = app.ApplicationId })">View</a>
                    }
                </div>
            }
        </div>

        @* ===== New Application button — only if nothing is currently active ===== *@
        @if (!hasActiveApplication)
        {
            <div class="myapps-new-wrap">
                <a class="myapps-new-btn" href="@Url.Action("Apply", "TradeLicence")">
                    <i class="fa-solid fa-plus"></i> New Application
                </a>
            </div>
        }
        else
        {
            <p class="tl-note" style="margin-top:12px;">
                You already have an application in progress. Finish, correct, or wait for it to be resolved before starting a new one.
            </p>
        }

        <hr class="myapps-divider" />
    }
    else
    {
        @* No applications yet — invite them to start their first one *@
        <div class="dashboard-banner">
            <div class="dashboard-banner-text">
                <span class="dashboard-banner-icon">📄</span>
                <div>
                    <h3>Your Applications</h3>
                    <p>You haven't started any applications yet.</p>
                </div>
            </div>
        </div>

        <div class="myapps-empty">
            <div class="myapps-empty-icon">🗂️</div>
            <p>No applications yet — start your first trade licence application below.</p>
            <div class="myapps-new-wrap">
                <a class="myapps-new-btn" href="@Url.Action("Apply", "TradeLicence")">
                    <i class="fa-solid fa-plus"></i> New Application
                </a>
            </div>
        </div>
    }
    @* ===== END new section ===== *@
</div>
