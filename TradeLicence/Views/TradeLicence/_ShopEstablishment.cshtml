
    <!-- Establishment Details -->
    <fieldset class="tl-section">
        <legend>Establishment Details</legend>

        <div class="tl-grid-2">

            <div class="form-group">
                <label>Applicant Name <span class="req">*</span></label>
                <input type="text" id="ApplicantNameShop" class="form-control" />
            </div>

            <div class="form-group">
                <label>Shop / Establishment Name <span class="req">*</span></label>
                <input type="text" id="ShopOrEstablishmentName" class="form-control" />
            </div>

            <div class="form-group">
                <label>Registration Period <span class="req">*</span></label>
                <select id="RegistrationPeriod" class="form-control">
                    <option value="">--Select--</option>
                    <option>1 Year</option>
                    <option>3 Years</option>
                    <option>5 Years</option>
                </select>
            </div>

            <div class="form-group">
                <label>Type Of Establishment <span class="req">*</span></label>
                <input type="text" id="TypeOfEstablishment" class="form-control" />
            </div>

            <div class="form-group">
                <label>Mobile Number <span class="req">*</span></label>
                <input type="text" id="MobileNumberShop" class="form-control" />
            </div>

            <div class="form-group">
                <label>Email ID</label>
                <input type="email" id="EmailId" class="form-control" />
            </div>

        </div>
    </fieldset>

    <!-- Shop Address -->
