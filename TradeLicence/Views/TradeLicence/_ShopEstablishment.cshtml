<!-- Reuses the same preview modal pattern as _UploadDocuments.cshtml — if
     that modal (#documentPreviewModal / #documentViewer) is already on the
     page once, don't duplicate it here. Only add this if it ISN'T already
     present elsewhere in Apply.cshtml. -->
<div class="modal fade" id="annexurePreviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Document Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="height:70vh;">
                <iframe id="annexureDocumentViewer" style="width:100%; height:100%; border:none;"></iframe>
            </div>
        </div>
    </div>
</div>

