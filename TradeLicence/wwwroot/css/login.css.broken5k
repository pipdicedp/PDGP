.tl-lx2-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
        radial-gradient(1200px 800px at 0% 0%, rgba(212,160,23,0.10), transparent 55%),
        radial-gradient(1200px 800px at 100% 100%, rgba(212,160,23,0.08), transparent 60%);
    pointer-events: none;
    z-index: 0;
}

.tl-lx2-photo-bg {
    position: absolute;
    inset: 0;
    background-image: url('/images/Mahatma_Gandhi_Statue.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    filter: saturate(1.05) brightness(0.95);
    z-index: 0;
}

.tl-lx2-crest-govt {
    font-weight: 700;
    font-size: 0.98rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.tl-lx2-crest-dept {
    margin-top: 2px;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.9;
}

.tl-lx2-hero-title {
    font-family: 'Source Serif 4', serif;
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    line-height: 1.08;
    margin: 0 0 12px;
}

.tl-lx2-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,0.38);
    background: rgba(255,255,255,0.12);
    backdrop-filter: blur(4px);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 16px;
}

.tl-lx2-points {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    margin-top: 12px;
    font-size: 0.9rem;
    opacity: 0.95;
}

.tl-lx2-points span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.tl-lx2-footline {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    padding: 14px 40px 24px;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.9;
}

.tl-lx2-signin-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(212,160,23,0.42);
    color: #7f6214;
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.tl-lx2-heading {
    font-family: 'Source Serif 4', serif;
    font-weight: 700;
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
    margin: 0 0 6px;
    color: #102637;
}

.tl-lx2-sub {
    margin: 0 0 18px;
    color: #4b5563;
    font-size: 0.98rem;
}

.tl-lx2-alert {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #7f1d1d;
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 16px;
    font-size: 0.9rem;
}

.tl-lx2-field {
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.tl-lx2-field label {
    font-weight: 600;
    color: #1f2937;
    font-size: 0.92rem;
}

.tl-lx2-control {
    position: relative;
    display: flex;
    align-items: center;
}

.tl-lx2-control > i {
    position: absolute;
    left: 12px;
    color: #9ca3af;
    font-size: 0.95rem;
}

.tl-lx2-input {
    width: 100%;
    padding: 10px 12px 10px 38px;
    border-radius: 10px;
    border: 1px solid #d1d5db;
    font-size: 0.98rem;
    background: #fff;
    transition: border-color .15s ease, box-shadow .15s ease;
}

.tl-lx2-input:focus {
    outline: none;
    border-color: #b8880f;
    box-shadow: 0 0 0 3px rgba(184,136,15,0.18);
}

.tl-lx2-pw .tl-lx2-eye {
    position: absolute;
    right: 8px;
    border: none;
    background: transparent;
    color: #6b7280;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 8px;
}

.tl-lx2-pw .tl-lx2-eye:hover {
    background: #f3f4f6;
}

.tl-lx2-captcha-row {
    display: flex;
    align-items: center;
    gap: 10px;
}

.tl-lx2-captcha-img {
    height: 44px;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    background: #fff;
}

.tl-lx2-captcha-refresh {
    border: 1px solid #d1d5db;
    background: #fff;
    border-radius: 8px;
    padding: 8px 10px;
    cursor: pointer;
}

.tl-lx2-captcha-refresh:hover {
    background: #f9fafb;
}

.tl-lx2-error {
    color: #b91c1c;
    font-size: 0.82rem;
}

.tl-lx2-submit {
    width: 100%;
    border: none;
    background: linear-gradient(135deg, #1a3a52, #1f4b6b);
    color: #fff;
    font-weight: 600;
    padding: 12px 16px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    cursor: pointer;
    transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease;
}

.tl-lx2-submit:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(26,58,82,0.18);
}

.tl-lx2-forgot {
    text-align: center;
    margin-top: 12px;
    font-size: 0.9rem;
}

.tl-lx2-forgot a {
    color: #7f6214;
    text-decoration: none;
    font-weight: 600;
}

.tl-lx2-forgot a:hover {
    text-decoration: underline;
}

.tl-lx2-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 18px 0 12px;
    color: #6b7280;
    font-size: 0.88rem;
}

.tl-lx2-divider::before,
.tl-lx2-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e5e7eb;
}

.tl-lx2-register {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1px solid #d1d5db;
    background: #fff;
    color: #1f2937;
    text-decoration: none;
    font-weight: 600;
    padding: 10px 14px;
    border-radius: 10px;
}

.tl-lx2-register:hover {
    background: #f9fafb;
    color: #111827;
}

.tl-lx2-secure {
    text-align: center;
    margin: 14px 0 0;
    color: #6b7280;
    font-size: 0.82rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}
